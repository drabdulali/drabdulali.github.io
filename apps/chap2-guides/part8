\section{Figure 1: AUC Bar Chart}
% ============================================================================

\subsection{Purpose and Design}

\begin{keypoint}{Figure Purpose}
Compare model performance across all 7 models using AUC as the primary metric.

\textbf{Design principles:}
\begin{itemize}
\item Horizontal bars for easy label reading
\item Sorted by AUC (best at top)
\item Color-coded by model type
\item AUC values displayed on bars
\end{itemize}
\end{keypoint}

\subsection{Complete Code}

\begin{lstlisting}
# ============================================
# FIGURE 1: AUC BAR CHART
# ============================================

library(dplyr)
library(readr)
library(ggplot2)
library(scales)

# Load performance data
performance <- read_csv("results/models/model_performance_comparison.csv")

# Define colors
colors_models <- c(
  "Theory-driven" = "#E31A1C",
  "Stepwise AIC" = "#1F78B4",
  "Elastic Net" = "#33A02C",
  "Livestock" = "#FF7F00",
  "Landscape" = "#6A3D9A",
  "Outbreak History" = "#B15928",
  "Wildlife" = "#FB9A99"
)

# Create plot
p_auc <- ggplot(performance,
                aes(x = reorder(model, AUC),
                    y = AUC,
                    fill = model)) +
  # Bar chart
  geom_col(width = 0.7, alpha = 0.9) +

  # Add AUC values on bars
  geom_text(aes(label = sprintf("%.3f", AUC)),
            hjust = -0.2,
            fontface = "bold",
            size = 4) +

  # Reference line at AUC = 0.7 (good performance)
  geom_hline(yintercept = 0.7,
             linetype = "dashed",
             color = "gray50",
             size = 0.8) +

  # Colors
  scale_fill_manual(values = colors_models) +

  # Y-axis
  scale_y_continuous(
    limits = c(0, 1),
    breaks = seq(0, 1, 0.1),
    labels = number_format(accuracy = 0.1)
  ) +

  # Flip coordinates
  coord_flip() +

  # Labels
  labs(
    title = "Model Performance Comparison",
    subtitle = "Area Under ROC Curve (AUC)",
    x = NULL,
    y = "AUC (95% CI)",
    caption = "Dashed line: AUC = 0.7 (good performance threshold)"
  ) +

  # Theme
  theme_publication() +
  theme(legend.position = "none")  # No legend needed

# Save
ggsave("results/figures/model_performance/01_auc_comparison.png",
       p_auc,
       width = 10,
       height = 6,
       dpi = 300,
       bg = "white")

cat("✓ AUC comparison plot saved\n")
\end{lstlisting}

