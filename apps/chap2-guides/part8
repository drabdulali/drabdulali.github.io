\textbf{Show confidence bands:}
\begin{lstlisting}
# Calculate CI (requires bootstrap - computationally intensive)
roc_obj <- roc(pers$has_persistence,
               predict(model_enet, type = "response"))
ci_obj <- ci.se(roc_obj, specificities = seq(0, 1, 0.01))

# Extract and plot CI
ci_data <- data.frame(
  specificity = as.numeric(rownames(ci_obj)),
  sensitivity_lower = ci_obj[, 1],
  sensitivity_upper = ci_obj[, 3]
)

p_roc <- p_roc +
  geom_ribbon(data = ci_data,
              aes(x = 1 - specificity,
                  ymin = sensitivity_lower,
                  ymax = sensitivity_upper),
              fill = "#33A02C",
              alpha = 0.2)
\end{lstlisting}
\end{detail}

