\subsection{Complete Code}

\begin{lstlisting}
# ============================================
# FIGURE 6: FOREST PLOT (ODDS RATIOS)
# ============================================

library(broom)
library(forcats)

# Load best model
best_model <- readRDS("results/models/model_elastic_net.rds")

# Extract coefficients with CI
coef_data <- tidy(best_model, conf.int = TRUE) %>%
  filter(term != "(Intercept)") %>%
  mutate(
    # Calculate OR
    OR = exp(estimate),
    OR_lower = exp(conf.low),
    OR_upper = exp(conf.high),

    # Significance
    significant = p.value < 0.05,

    # Categorize variables
    category = case_when(
      grepl("^pig_", term) ~ "Livestock",
      grepl("^(feed_|crop_|maize_|wheat_)", term) ~ "Agriculture",
      grepl("^wild", term) ~ "Wildlife",
      grepl("^(temp_|precip_|tree_|elevation_|water_)", term) ~ "Environment",
      grepl("^road_", term) ~ "Infrastructure",
      grepl("(susceptible|outbreak|wildlife_outbreak)", term) ~ "Outbreak History",
      TRUE ~ "Other"
    ),

    # Clean names
    term_clean = gsub("_", " ", term) %>%
      tools::toTitleCase() %>%
      gsub("Pct", "(%)", .) %>%
      gsub("Km", "(km)", .) %>%
      gsub("Ha", "(ha)", .)
  ) %>%
  arrange(desc(abs(estimate))) %>%
  mutate(term_clean = fct_reorder(term_clean, OR))

# Create plot
p_forest <- ggplot(coef_data,
                   aes(x = OR,
                       y = term_clean,
                       color = category)) +
  # Null effect line
  geom_vline(xintercept = 1,
             linetype = "dashed",
             color = "gray40",
             size = 0.8) +

  # Confidence intervals
  geom_errorbarh(aes(xmin = OR_lower, xmax = OR_upper),
                 height = 0.3,
                 size = 1) +

  # Points
  geom_point(aes(shape = significant),
             size = 4,
             alpha = 0.9) +

  # Colors
  scale_color_manual(values = colors_categories,
                     name = "Category") +

  # Shapes
  scale_shape_manual(values = c("TRUE" = 16, "FALSE" = 1),
                     name = "Significant",
                     labels = c("No (p ≥ 0.05)", "Yes (p < 0.05)")) +

  # X-axis (log scale)
  scale_x_continuous(trans = "log10",
                     breaks = c(0.5, 0.7, 0.9, 1.0, 1.2, 1.5, 2.0),
                     labels = c("0.5", "0.7", "0.9", "1.0",
                               "1.2", "1.5", "2.0")) +

  # Labels
  labs(
    title = "Covariate Effects on ASF Persistence",
    subtitle = "Odds Ratios with 95% Confidence Intervals (Elastic Net Model)",
    x = "Odds Ratio (log scale)",
    y = NULL,
    caption = "OR > 1: increased odds | OR < 1: decreased odds | Filled points: p < 0.05"
  ) +

  # Theme
  theme_publication() +
  theme(legend.position = "right")

# Save
ggsave("results/figures/covariate_effects/01_forest_plot_odds_ratios.png",
