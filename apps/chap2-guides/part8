# Calculate EPV
n_events <- sum(pers$has_persistence)

epv_data <- performance %>%
  mutate(
    epv = n_events / n_vars,
    epv_category = case_when(
      epv >= 15 ~ "Excellent (≥15)",
      epv >= 10 ~ "Adequate (10-15)",
      epv >= 5 ~ "Marginal (5-10)",
      TRUE ~ "Poor (<5)"
    )
  )

p_epv <- ggplot(epv_data,
                aes(x = reorder(model, epv),
                    y = epv,
                    fill = epv_category)) +
  # Bars
  geom_col(width = 0.7, alpha = 0.9) +

  # Threshold lines
  geom_hline(yintercept = 10,
             linetype = "dashed",
             color = "orange",
             size = 1) +
  geom_hline(yintercept = 15,
