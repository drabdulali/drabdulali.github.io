\section{Figure 2: ROC Curves}
% ============================================================================

\subsection{Purpose and Design}

\begin{keypoint}{Figure Purpose}
Visualize sensitivity vs specificity trade-off for all models.

\textbf{Design principles:}
\begin{itemize}
\item All models on one plot for comparison
\item Diagonal reference line (AUC = 0.5)
\item AUC displayed in legend
\item Bold, distinguishable lines
\end{itemize}
\end{keypoint}

\subsection{Complete Code}

\begin{lstlisting}
# ============================================
# FIGURE 2: ROC CURVES
# ============================================

library(pROC)

# Load data and models
pers <- read_csv("data/processed/persistence_with_covariates_COMPLETE.csv") %>%
  filter(!is.na(has_persistence))

model_theory <- readRDS("results/models/model_theory_driven.rds")
model_stepwise <- readRDS("results/models/model_stepwise.rds")
model_enet <- readRDS("results/models/model_elastic_net.rds")
model_livestock <- readRDS("results/models/model_livestock.rds")
model_landscape <- readRDS("results/models/model_landscape.rds")
model_outbreak <- readRDS("results/models/model_outbreak.rds")
model_wildlife <- readRDS("results/models/model_wildlife.rds")

# Generate predictions for each model
roc_data <- bind_rows(
  tibble(
    model = "Theory-driven",
    pred = predict(model_theory, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Stepwise AIC",
    pred = predict(model_stepwise, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Elastic Net",
    pred = predict(model_enet, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Livestock",
    pred = predict(model_livestock, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Landscape",
    pred = predict(model_landscape, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Outbreak History",
    pred = predict(model_outbreak, newdata = pers, type = "response"),
    obs = pers$has_persistence
  ),
  tibble(
    model = "Wildlife",
    pred = predict(model_wildlife, newdata = pers, type = "response"),
    obs = pers$has_persistence
  )
)

# Calculate ROC coordinates
roc_curves <- roc_data %>%
  group_by(model) %>%
  summarise({
    roc_obj <- roc(obs, pred, quiet = TRUE)
    coords_df <- coords(roc_obj, "all",
                        ret = c("sensitivity", "specificity"))
    tibble(
      sensitivity = coords_df$sensitivity,
      specificity = coords_df$specificity,
      auc = as.numeric(auc(roc_obj))
    )
  }, .groups = "drop") %>%
  mutate(
    model_label = paste0(model, " (AUC = ",
                        sprintf("%.3f", auc), ")")
  )

# Create plot
p_roc <- ggplot(roc_curves,
                aes(x = 1 - specificity,
                    y = sensitivity,
                    color = model)) +
  # ROC curves
  geom_line(size = 1.2, alpha = 0.9) +

  # Diagonal reference (random classifier)
  geom_abline(intercept = 0,
              slope = 1,
              linetype = "dashed",
              color = "gray50",
              size = 0.8) +

  # Colors
  scale_color_manual(values = colors_models,
                     name = "Model (AUC)") +

  # Axes
  scale_x_continuous(limits = c(0, 1),
                     breaks = seq(0, 1, 0.2)) +
  scale_y_continuous(limits = c(0, 1),
                     breaks = seq(0, 1, 0.2)) +

  # Labels
  labs(
    title = "Receiver Operating Characteristic (ROC) Curves",
    subtitle = "ASF Persistence Prediction Models",
    x = "1 - Specificity (False Positive Rate)",
    y = "Sensitivity (True Positive Rate)",
    caption = "Dashed line: Random classifier (AUC = 0.5)"
  ) +

  # Theme
  theme_publication() +
  guides(color = guide_legend(override.aes = list(size = 2)))

# Save
ggsave("results/figures/model_performance/02_roc_curves.png",
       p_roc,
       width = 10,
       height = 8,
       dpi = 300,
       bg = "white")

cat("✓ ROC curves saved\n")
\end{lstlisting}

