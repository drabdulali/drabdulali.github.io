\section{Figure 9: Calibration Plot}
% ============================================================================

\subsection{Purpose and Design}

\begin{keypoint}{Figure Purpose}
Assess whether predicted probabilities match observed frequencies (calibration).

\textbf{Design principles:}
\begin{itemize}
\item Predicted vs observed for binned predictions
\item Diagonal line = perfect calibration
\item Point size reflects sample size in bin
\item Compare multiple models
\end{itemize}
\end{keypoint}

\subsection{Complete Code}

\begin{lstlisting}
# ============================================
# FIGURE 9: CALIBRATION PLOT
# ============================================

# Function to calculate calibration
calc_calibration <- function(pred_prob, obs, n_bins = 10) {
  # Create bins
  pred_bins <- cut(pred_prob,
                   breaks = seq(0, 1, length.out = n_bins + 1),
                   include.lowest = TRUE)

  # Calculate observed proportion in each bin
  calib_data <- tibble(pred_prob = pred_prob, obs = obs, bin = pred_bins) %>%
    group_by(bin) %>%
    summarise(
      mean_pred = mean(pred_prob),
      obs_prop = mean(obs),
      n = n(),
      .groups = "drop"
    ) %>%
    filter(n > 0)

  return(calib_data)
}

# Get predictions
pred_theory <- predict(model_theory, newdata = pers, type = "response")
pred_stepwise <- predict(model_stepwise, newdata = pers, type = "response")
pred_enet <- predict(model_enet, newdata = pers, type = "response")

# Calculate calibration
calib_theory <- calc_calibration(pred_theory, pers$has_persistence) %>%
  mutate(model = "Theory-driven")
calib_stepwise <- calc_calibration(pred_stepwise, pers$has_persistence) %>%
  mutate(model = "Stepwise AIC")
calib_enet <- calc_calibration(pred_enet, pers$has_persistence) %>%
  mutate(model = "Elastic Net")

calib_all <- bind_rows(calib_theory, calib_stepwise, calib_enet)

# Create plot
p_calib <- ggplot(calib_all,
                  aes(x = mean_pred,
                      y = obs_prop,
                      color = model)) +
  # Perfect calibration line
  geom_abline(intercept = 0,
              slope = 1,
              linetype = "dashed",
              color = "gray40",
              size = 0.8) +

  # Points
  geom_point(aes(size = n), alpha = 0.8) +

  # Lines connecting points
  geom_line(size = 1, alpha = 0.7) +

  # Colors
  scale_color_manual(values = colors_models,
                     name = "Model") +
  scale_size_continuous(range = c(2, 6),
                       name = "N observations") +

  # Axes
  scale_x_continuous(limits = c(0, 1),
                     breaks = seq(0, 1, 0.2)) +
  scale_y_continuous(limits = c(0, 1),
                     breaks = seq(0, 1, 0.2)) +

  # Labels
  labs(
    title = "Model Calibration",
    subtitle = "Predicted vs Observed Persistence Probability",
    x = "Predicted Probability",
    y = "Observed Proportion",
    caption = "Dashed line: perfect calibration | Points closer to line = better calibration"
  ) +

  # Theme
  theme_publication() +
  theme(legend.position = "right")

# Save
