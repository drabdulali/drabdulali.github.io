\section{Figure 3: Complexity vs Performance}
% ============================================================================

\subsection{Purpose and Design}

\begin{keypoint}{Figure Purpose}
Evaluate trade-off between model complexity (number of variables) and predictive performance (AUC).

\textbf{Design principles:}
\begin{itemize}
\item Scatter plot with labels
\item Point size reflects model fit (Pseudo R²)
\item Identify sweet spot (high AUC, low complexity)
\end{itemize}
\end{keypoint}

\subsection{Complete Code}

\begin{lstlisting}
# ============================================
# FIGURE 3: COMPLEXITY VS PERFORMANCE
# ============================================

p_complex <- ggplot(performance,
                    aes(x = n_vars,
                        y = AUC,
                        color = model,
                        size = pseudo_r2)) +
  # Points
  geom_point(alpha = 0.8) +

  # Model labels
  geom_text(aes(label = model),
            hjust = -0.1,
            vjust = 0.5,
            size = 3.5,
            fontface = "bold",
            show.legend = FALSE) +

  # Colors
  scale_color_manual(values = colors_models) +

  # Point size
  scale_size_continuous(range = c(3, 8),
                       name = "Pseudo R²") +

  # Axes
  scale_x_continuous(breaks = seq(0, 20, 2),
                     limits = c(0, max(performance$n_vars) + 2)) +
  scale_y_continuous(limits = c(0.5, 1),
                     breaks = seq(0.5, 1, 0.05)) +

  # Labels
  labs(
    title = "Model Complexity vs Performance",
    subtitle = "Balancing parsimony and predictive accuracy",
    x = "Number of Variables",
    y = "AUC",
    caption = "Point size represents Pseudo R² (larger = better fit)"
  ) +

  # Theme
  theme_publication() +
  theme(legend.position = "bottom")

# Save
ggsave("results/figures/model_performance/03_complexity_vs_performance.png",
       p_complex,
       width = 10,
       height = 8,
       dpi = 300,
       bg = "white")

cat("✓ Complexity plot saved\n")
\end{lstlisting}

\subsection{Customization Options}

\begin{detail}{Customization for Complexity Plot}
\textbf{Add Pareto frontier:}
\begin{lstlisting}
# Identify Pareto-optimal models (not dominated)
performance <- performance %>%
  arrange(n_vars, desc(AUC)) %>%
  mutate(
    is_pareto = TRUE
  )

for (i in 2:nrow(performance)) {
  # Check if dominated by any previous model
  dominated <- any(
    performance$n_vars[1:(i-1)] <= performance$n_vars[i] &
    performance$AUC[1:(i-1)] >= performance$AUC[i]
  )
  performance$is_pareto[i] <- !dominated
}

# Connect Pareto-optimal points
pareto_models <- performance %>% filter(is_pareto)

p_complex <- p_complex +
  geom_step(data = pareto_models,
            aes(x = n_vars, y = AUC),
            direction = "vh",
            linetype = "dashed",
            color = "gray40",
            size = 1,
            inherit.aes = FALSE)
\end{lstlisting}

\textbf{Add diagonal reference lines:}
\begin{lstlisting}
