\end{itemize}

\textbf{Respond by:}
\begin{itemize}
    \item Slowing down
    \item Asking ``Does that answer your question?''
    \item Offering to elaborate
    \item Checking understanding
\end{itemize}

\textbf{SPECIFIC SCENARIOS}

\textbf{Scenario 1: Tough Question from Skeptical Committee Member}
\begin{itemize}
    \item Maintain neutral facial expression (don't show fear/anger)
