\subsection{Data Source Description}

\begin{datasource}{FAOSTAT Live Animals Database}
\textbf{Provider}: Food and Agriculture Organization (FAO)\\
\textbf{URL}: \url{https://www.fao.org/faostat/en/\#data/QCL}\\
\textbf{Variables}: Livestock populations by species\\
\textbf{Coverage}: National level (admin0), annual, 1961-present\\
\textbf{Format}: CSV download\\
\textbf{License}: CC-BY-NC-SA 3.0 IGO
\end{datasource}

\subsection{Challenge: National-Level Data Only}

\begin{warning}{Spatial Disaggregation Problem}
\textbf{The challenge}:
\begin{itemize}
    \item FAOSTAT provides national totals only (e.g., "Romania: 4.5 million pigs")
    \item We need county-level estimates for spatial analysis
    \item No official sub-national livestock census available
\end{itemize}

\textbf{Naive solution (DO NOT USE)}:
\begin{lstlisting}
# WRONG: Divide equally by county
pig_per_county <- national_total / n_counties
# Problem: Ignores spatial heterogeneity
\end{lstlisting}
\end{warning}

\subsection{Solution: Area-Weighted Disaggregation}

\begin{methodology}{Spatial Disaggregation Method}
\textbf{Assumption}: Livestock density proportional to county area (with limitations)

\textbf{Code}:
\begin{lstlisting}
# Load FAOSTAT national data
faostat <- read_csv("FAOSTAT_livestock.csv")

# Get Romania pig population (2020)
romania_pigs_national <- faostat %>%
  filter(Area == "Romania", Item == "Pigs", Year == 2020) %>%
  pull(Value)
# Result: 4,500,000 pigs

# Calculate county-level estimates
livestock_disaggregated <- admin2 %>%
  st_drop_geometry() %>%
  select(NAME_2, area_km2) %>%
  mutate(
    # Proportion of national area
    area_proportion = area_km2 / sum(area_km2),

    # Disaggregate pigs by area
    pig_population_estimated = romania_pigs_national * area_proportion,

    # Pig density (pigs per km^2)
    pig_density_per_km2 = pig_population_estimated / area_km2
  )
\end{lstlisting}

\textbf{Limitations of this approach}:
\begin{itemize}
    \item Assumes uniform density (not realistic)
    \item Ignores agricultural suitability, urban areas
    \item No validation data at county level
\end{itemize}
\end{methodology}

\begin{warning}{Limitation Acknowledgment}
\textbf{We document this limitation explicitly}:
\begin{itemize}
    \item Area-based disaggregation is crude approximation
    \item True pig density varies 10-100x between counties
    \item Urban counties over-estimated, rural under-estimated
    \item Results should be interpreted cautiously
\end{itemize}

\textbf{Why we still use it}:
\begin{itemize}
    \item Better than no livestock data
    \item Captures broad regional patterns (lowlands vs mountains)
    \item Sensitivity analysis: Results robust to livestock covariates
    \item Alternative data (GLW, commercial farms) also imperfect
\end{itemize}
\end{warning}

\subsection{Spatial Lag for Heterogeneity}

\begin{methodology}{Accounting for Spatial Variation}
\textbf{Approach}: Use neighboring counties to estimate local heterogeneity

\textbf{Complete Code}:
\begin{lstlisting}
library(spdep)

# Create spatial weights matrix (queen contiguity)
admin2_sp <- as_Spatial(admin2)
neighbors <- poly2nb(admin2_sp, queen = TRUE)
weights <- nb2listw(neighbors, style = "W", zero.policy = TRUE)

# Calculate spatial lag (mean of neighbors)
livestock_with_lag <- livestock_disaggregated %>%
  mutate(
    # Spatial lag of pig density
    pig_density_spatial_lag = lag.listw(weights, pig_density_per_km2,
                                        zero.policy = TRUE),

    # Local heterogeneity (difference from neighbors)
    pig_density_local_deviation = pig_density_per_km2 -
                                   pig_density_spatial_lag,

    # Coefficient of variation among neighbors
    pig_density_neighbor_cv = ... # Custom calculation
  )
\end{lstlisting}

\textbf{Rationale}:
\begin{itemize}
    \item Spatial lag smooths out local noise
    \item Local deviation identifies unusual counties
    \item Neighbor CV captures regional heterogeneity
    \item Improves predictive power vs raw disaggregated values
\end{itemize}
\end{methodology}

