\subsection{WorldClim BIO Variables}

\begin{technical}{Why Divide by 10?}
\textbf{WorldClim encoding}: Temperature values stored as integers $\times$ 10

\textbf{Example}:
\begin{itemize}
    \item Raster value: 127
    \item True temperature: 127 / 10 = 12.7°C
\end{itemize}

\textbf{Reason}: Saves storage space (integers smaller than floats)

\textbf{Code}:
\begin{lstlisting}
# Load temperature raster
temperature <- rast("ROU_wc2.1_30s_tavg.tif")

# Extract mean for each county
temp_stats <- exact_extract(temperature, admin2_proj, fun = 'mean')

# Convert to Celsius
admin2$mean_annual_temp_C <- temp_stats / 10
\end{lstlisting}

\textbf{Variables extracted}:
\begin{itemize}
    \item BIO1: Mean annual temperature (°C)
    \item BIO5: Max temperature of warmest month
    \item BIO6: Min temperature of coldest month
    \item BIO12: Annual precipitation (mm)
    \item BIO15: Precipitation seasonality (CV)
\end{itemize}
\end{technical}

\subsection{Climate Anomalies}

\begin{methodology}{Why Calculate Climate Anomalies?}
\textbf{Rationale}:
\begin{enumerate}
    \item \textbf{Long-term climate} (WorldClim) = static baseline
    \item \textbf{Year-specific conditions} may drive outbreak patterns
    \item \textbf{Anomalies} = deviations from normal conditions
    \item Better predictor than absolute values (e.g., "unusually wet year")
\end{enumerate}

\textbf{Formula}:
\[
\text{Anomaly} = \frac{\text{Observed} - \text{LongTermMean}}{\text{LongTermSD}}
\]

\textbf{Complete Code}:
\begin{lstlisting}
# Load long-term mean (WorldClim 1970-2000)
temp_longterm <- rast("ROU_wc2.1_30s_tavg.tif")
temp_mean <- exact_extract(temp_longterm, admin2, fun = 'mean') / 10

# Load year-specific data (TerraClimate)
temp_2017 <- rast("TerraClimate_tavg_2017.nc")
temp_2017_mean <- exact_extract(temp_2017, admin2, fun = 'mean')

# Calculate anomaly (z-score)
temp_anomaly_2017 <- (temp_2017_mean - temp_mean) / sd(temp_mean)

# Interpretation:
# +1.5 = 1.5 SD warmer than normal
# -0.8 = 0.8 SD cooler than normal
\end{lstlisting}

\textbf{Applied to}:
\begin{itemize}
    \item Temperature anomalies (monthly/annual)
    \item Precipitation anomalies
    \item Drought indices (PDSI, SPI)
\end{itemize}
\end{methodology}

