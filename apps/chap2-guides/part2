\subsection{Data Source Description}

\begin{datasource}{WOAH World Animal Health Information System (WAHIS)}
\textbf{Provider}: World Organisation for Animal Health (WOAH/OIE)\\
\textbf{URL}: \url{https://wahis.woah.org/}\\
\textbf{Access}: Public portal, downloadable CSV\\
\textbf{Coverage}: Global, 2005-present\\
\textbf{Update frequency}: Real-time (immediate outbreak reporting)\\
\textbf{Spatial resolution}: Point locations with admin0/1/2 identifiers\\
\textbf{File size}: 177,010 records (63 variables) for 18 TADs, 2005-2025
\end{datasource}

\subsection{Why WAHIS?}

\begin{methodology}{Justification for WAHIS}
\textbf{Only source that provides:}
\begin{enumerate}
    \item \textbf{Standardized reporting}: All OIE member countries report using same schema
    \item \textbf{Outbreak-level data}: Individual outbreak start/end dates, not aggregated counts
    \item \textbf{Sub-national resolution}: Admin2 (county) identifiers enable spatial analysis
    \item \textbf{Species information}: Distinguishes wild vs domestic, species affected
    \item \textbf{Control measures}: Vaccination, culling, movement restrictions documented
\end{enumerate}

\textbf{Alternatives considered:}
\begin{itemize}
    \item \textit{FAO EMPRES-i}: Limited to select diseases, less granular
    \item \textit{ProMED}: Unstructured text, requires extensive parsing
    \item \textit{National reports}: Inconsistent formats, incomplete temporal coverage
\end{itemize}
\end{methodology}

