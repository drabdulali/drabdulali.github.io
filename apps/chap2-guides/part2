\section{Overview of Data Sources}
% ============================================================================

\begin{keypoint}{Data Integration Strategy}
This study integrates \textbf{8 major data sources} to create a comprehensive dataset of \textbf{60+ covariates} at admin2 (county) level:

\begin{enumerate}
    \item \textbf{WAHIS} (WOAH) - Outbreak records with 21 columns
    \item \textbf{GADM} - Administrative boundaries (8 columns)
    \item \textbf{SPAM2020} - Agricultural production (12 covariates)
    \item \textbf{GBIF} - Wildlife observations (8 covariates)
    \item \textbf{WorldClim \& TerraClimate} - Climate data (10 covariates)
    \item \textbf{OpenStreetMap} - Road infrastructure (4 covariates)
    \item \textbf{Hansen/SRTM/GSW} - Landscape data (10 covariates)
    \item \textbf{FAOSTAT} - Livestock statistics (4 covariates)
\end{enumerate}

All data processed at \textbf{admin2 (county) level} for Romania, covering \textbf{2005-2025}.
\end{keypoint}

\subsection{Why These Data Sources?}

\begin{methodology}{Selection Criteria}
Each data source was selected based on:
\begin{itemize}
    \item \textbf{Spatial coverage}: Complete Romania coverage at sufficient resolution
    \item \textbf{Temporal coverage}: Multi-year data spanning outbreak period (2005-2025)
    \item \textbf{Data quality}: Validated, peer-reviewed, or officially published
    \item \textbf{Accessibility}: Open-access or available through institutional agreements
    \item \textbf{Biological relevance}: Direct connection to ASF transmission ecology
\end{itemize}
\end{methodology}

