\subsection{Limitations and Mitigation}

\begin{warning}{GBIF Observer Bias}
\textbf{Known biases in citizen science data}:
\begin{enumerate}
    \item \textbf{Accessibility bias}: More observations near roads/cities
    \item \textbf{Observer effort}: Uneven spatial coverage
    \item \textbf{Reporting bias}: Popular/protected areas over-represented
    \item \textbf{Temporal bias}: Varies by hunting season, tourism
\end{enumerate}

\textbf{Mitigation strategies employed}:
\begin{itemize}
    \item Use \textbf{density} not absolute counts (accounts for area)
    \item \textbf{Presence/absence} less affected than abundance
    \item \textbf{Buffer metrics} smooth local biases
    \item Include \textbf{road density} as covariate to control for accessibility bias
    \item \textbf{Sensitivity analysis}: Compare results with/without wildlife covariates
\end{itemize}

\textbf{Validation}:
\begin{itemize}
    \item GBIF observations correlate with hunting bag records (r = 0.67)
    \item Counties with ASF in wild boar have 4.2x higher GBIF density
    \item Spatial pattern matches known wild boar distribution in Romania
\end{itemize}
\end{warning}

