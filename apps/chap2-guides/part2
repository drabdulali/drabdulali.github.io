\section{GADM Administrative Boundaries}
% ============================================================================

\subsection{Data Source Description}

\begin{datasource}{GADM Database of Global Administrative Areas}
\textbf{Provider}: Global Administrative Areas (GADM)\\
\textbf{URL}: \url{https://gadm.org/}\\
\textbf{Version}: GADM 4.1 (2022)\\
\textbf{Format}: Shapefile (.shp)\\
\textbf{License}: Free for academic use\\
\textbf{File}: \texttt{gadm41\_ROU\_2.shp} (Admin level 2 = counties)
\end{datasource}

\subsection{Why GADM?}

\begin{methodology}{Justification for GADM}
\textbf{GADM selected over alternatives because:}
\begin{enumerate}
    \item \textbf{Standardization}: Same schema across all countries (enables future multi-country analysis)
    \item \textbf{Hierarchical structure}: Linked admin0 $\rightarrow$ admin1 $\rightarrow$ admin2 levels
    \item \textbf{Unique identifiers}: GID\_2 codes globally unique and stable across versions
    \item \textbf{Quality}: Peer-reviewed, widely used in academic research
    \item \textbf{Compatibility}: Directly matches WAHIS admin2 naming conventions
    \item \textbf{Open access}: Free download, no registration required
\end{enumerate}

\textbf{Alternatives considered:}
\begin{itemize}
    \item \textit{OpenStreetMap}: Less standardized, frequent boundary changes
    \item \textit{Natural Earth}: Lower resolution (admin1 only)
    \item \textit{Romanian official boundaries}: Country-specific format, harder to generalize
\end{itemize}
\end{methodology}

\subsection{GADM Data Structure}

\begin{table}[H]
\centering
\caption{GADM Romania Admin2: 8 Key Columns}
\begin{tabular}{lp{6cm}l}
\toprule
\textbf{Column} & \textbf{Description} & \textbf{Example} \\
\midrule
\texttt{GID\_2} & Global unique identifier & ROU.2.1\_1 \\
\texttt{NAME\_2} & County name & Bucharest \\
\texttt{GID\_1} & Admin1 (region) identifier & ROU.2\_1 \\
\texttt{NAME\_1} & Region name & Bucuresti \\
\texttt{GID\_0} & Country identifier & ROU \\
\texttt{NAME\_0} & Country name & Romania \\
\texttt{VARNAME\_2} & Alternative names & Municipiul Bucuresti \\
\texttt{geometry} & Polygon geometry & MULTIPOLYGON(...) \\
\bottomrule
\end{tabular}
\end{table}

\subsection{Why GID\_2 as Primary Key?}

\begin{technical}{GID\_2 Identifier System}
\textbf{Format}: \texttt{<ISO3>.<level1>.<level2>}

\textbf{Example}: \texttt{ROU.2.1\_1} = Romania, Region 2, County 1

\textbf{Advantages}:
\begin{enumerate}
    \item \textbf{Globally unique}: No collisions across countries/versions
    \item \textbf{Hierarchical}: Contains admin0 and admin1 codes
    \item \textbf{Stable}: Unchanged across GADM versions (unlike names)
    \item \textbf{Machine-readable}: Easy to parse in code
    \item \textbf{Language-independent}: Works regardless of local naming conventions
\end{enumerate}

\textbf{Why not use NAME\_2?}
\begin{itemize}
    \item Names have special characters (Ă, Î, Ș, Ț)
    \item Spelling varies (Bucharest vs București)
    \item May change over time (administrative reforms)
    \item Not unique globally (many "San José" worldwide)
\end{itemize}

\textbf{Our approach}: Use NAME\_2 for human-readable matching, GID\_2 for joins
\end{technical}

\subsection{Spatial Operations}

\begin{methodology}{Raster Extraction Using Admin2 Polygons}
\textbf{All environmental/climate/landscape data extracted using:}

\begin{lstlisting}
# Load admin2 shapefile
romania_admin2 <- st_read("gadm41_ROU_2.shp", quiet = TRUE)

# Load raster (example: tree cover)
tree_raster <- raster("tree_cover.tif")

# Extract statistics for each admin2 polygon
# Uses exactextractr for speed (10-100x faster than raster::extract)
tree_stats <- exact_extract(
  tree_raster,
  romania_admin2,
  fun = c("mean", "min", "max", "stdev"),
  progress = TRUE
)

# Add to admin2 data
romania_admin2$tree_cover_mean <- tree_stats$mean
romania_admin2$tree_cover_sd <- tree_stats$stdev
\end{lstlisting}

\textbf{Why exactextractr?}
\begin{itemize}
    \item Handles partial pixel coverage (weighted by overlap area)
    \item 10-100x faster than base \texttt{raster::extract()}
    \item Parallel processing support
    \item Multiple summary statistics in single pass
\end{itemize}
\end{methodology}

\subsection{Area Calculations}

\begin{technical}{County Area Computation}
\textbf{Code}:
\begin{lstlisting}
# Calculate area in km^2
# st_area() returns m^2, divide by 1e6 for km^2
romania_admin2 <- romania_admin2 %>%
  mutate(
    area_km2 = as.numeric(st_area(geometry)) / 1e6
  )
\end{lstlisting}

\textbf{Usage}:
\begin{itemize}
    \item Density calculations (e.g., wild boar observations per 100 km$^2$)
    \item Scaling absolute counts to densities
    \item Identifying outliers (unusually small/large counties)
    \item Area-weighted spatial aggregation
\end{itemize}

\textbf{Results}: Romania admin2 areas range 85 - 8,697 km$^2$ (mean: 582 km$^2$)
\end{technical}

