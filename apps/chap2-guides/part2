\subsection{Hansen Global Forest Change}

\begin{datasource}{Hansen Global Forest Change v1.10}
\textbf{Provider}: University of Maryland / Google Earth Engine\\
\textbf{URL}: \url{https://glad.earthengine.app/view/global-forest-change}\\
\textbf{Variable}: Tree cover percentage (year 2000 baseline)\\
\textbf{Resolution}: 30 meters\\
\textbf{Format}: GeoTIFF\\
\textbf{License}: CC-BY 4.0
\end{datasource}

\begin{technical}{30m Resolution Explained}
\textbf{What is 30m resolution?}
\begin{itemize}
    \item Each pixel = 30m $\times$ 30m = 900 m² = 0.0009 km²
    \item Very high resolution (can distinguish individual forest patches)
    \item Romania county avg 582 km² = $\sim$647,000 pixels per county
\end{itemize}

\textbf{Processing strategy}:
\begin{itemize}
    \item Cannot load entire Romania at 30m (memory intensive)
    \item Use \texttt{exact\_extract()} with parallel processing
    \item Extract statistics (mean, SD, max) per county
    \item Processing time: $\sim$45 minutes for all counties
\end{itemize}
\end{technical}

\subsubsection{Tree Cover Extraction}

\begin{lstlisting}
library(exactextractr)
library(terra)
library(parallel)

# Load tree cover raster (30m resolution)
tree_raster <- rast("treecover2000/Hansen_GFC_treecover2000_Romania.tif")

# Load admin2
admin2 <- st_read("gadm41_ROU_2.shp", quiet = TRUE)

# Setup parallel processing (use half of cores)
n_cores <- floor(detectCores() / 2)

# Extract statistics with progress bar
tree_stats <- exact_extract(
  tree_raster,
  admin2,
  fun = c("mean", "min", "max", "stdev", "q75", "q25"),
  progress = TRUE,
  max_cells_in_memory = 3e7  # Manage memory usage
)

# Add to admin2 data
tree_covariates <- admin2 %>%
  st_drop_geometry() %>%
  select(NAME_2) %>%
  mutate(
    tree_cover_mean_pct = tree_stats$mean,
    tree_cover_sd = tree_stats$stdev,
    tree_cover_max_pct = tree_stats$max,
    tree_cover_heterogeneity = tree_stats$stdev / tree_stats$mean,
    tree_cover_q75_minus_q25 = tree_stats$q75 - tree_stats$q25
  )
