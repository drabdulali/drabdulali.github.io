\subsubsection{Persistence Calculation (6-24 Month Recurrence)}

\begin{methodology}{Persistence Algorithm}
\textbf{Definition}: Outbreak recurrence within 6-24 months in same county

\textbf{Complete Code}:
\begin{lstlisting}
# Setup parallel processing
n_cores <- floor(detectCores() / 2)
cl <- makeCluster(n_cores)
clusterEvalQ(cl, library(dplyr))
clusterExport(cl, c("asf_clean"))

# Calculate for each county
persistence_data <- pblapply(unique(asf_clean$level2_name), function(county) {
  # Get outbreaks for this county, sorted by date
  county_outbreaks <- asf_clean %>%
    filter(level2_name == county) %>%
    arrange(start_date)

  # Need at least 2 outbreaks for persistence
  if (nrow(county_outbreaks) < 2) {
    return(data.frame(
      level2_name = county,
      has_persistence = 0,
      n_outbreaks = nrow(county_outbreaks),
      persistence_events = 0
    ))
  }

  # Calculate intervals between consecutive outbreaks (in months)
  intervals_months <- diff(county_outbreaks$start_date) / 30.44

  # Persistence = interval between 6 and 24 months
  has_persistence <- any(intervals_months >= 6 & intervals_months <= 24)
  n_persistence <- sum(intervals_months >= 6 & intervals_months <= 24)

  return(data.frame(
    level2_name = county,
    has_persistence = as.integer(has_persistence),
    n_outbreaks = nrow(county_outbreaks),
    persistence_events = n_persistence
  ))
}, cl = cl)

stopCluster(cl)
persistence_df <- bind_rows(persistence_data)
\end{lstlisting}

\textbf{Rationale for 6-24 month window:}
\begin{itemize}
    \item $<$6 months: Likely same outbreak or immediate spillover
    \item 6-24 months: Disease persisting in area (environmental/wildlife reservoir)
    \item $>$24 months: True reemergence (reintroduction event)
\end{itemize}
\end{methodology}

\subsubsection{Reemergence Calculation ($\geq$2 Years Disease-Free)}

\begin{methodology}{Reemergence Algorithm}
\textbf{Definition}: Disease return after $\geq$24 months (2 years) disease-free

\textbf{Complete Code}:
\begin{lstlisting}
# Setup parallel processing
cl <- makeCluster(n_cores)
clusterEvalQ(cl, library(dplyr))
clusterExport(cl, c("asf_clean"))

reemergence_data <- pblapply(unique(asf_clean$level2_name), function(county) {
  # Get outbreaks for this county
  county_outbreaks <- asf_clean %>%
    filter(level2_name == county) %>%
    arrange(start_date)

  # Need at least 2 outbreaks
  if (nrow(county_outbreaks) < 2) {
    return(data.frame(
      level2_name = county,
      has_reemergence = 0,
      reemergence_events = 0,
      time_to_reemergence_months = NA
    ))
  }

  # Calculate intervals in months
  intervals_months <- diff(county_outbreaks$start_date) / 30.44

  # Reemergence = interval >= 24 months
  has_reemergence <- any(intervals_months >= 24)
  n_reemergence <- sum(intervals_months >= 24)

  # Time to first reemergence (if any)
  if (has_reemergence) {
    time_to_reemergence <- min(intervals_months[intervals_months >= 24])
  } else {
    time_to_reemergence <- NA
  }

  return(data.frame(
    level2_name = county,
    has_reemergence = as.integer(has_reemergence),
    reemergence_events = n_reemergence,
    time_to_reemergence_months = time_to_reemergence
  ))
}, cl = cl)

stopCluster(cl)
reemergence_df <- bind_rows(reemergence_data)
\end{lstlisting}

\textbf{Biological Rationale:}
\begin{itemize}
    \item ASF virus can persist in carcasses/environment for months
    \item Wild boar populations turnover $\sim$12-18 months
    \item 24+ month gap suggests complete local clearance
    \item Reemergence likely represents new introduction (spatial spillover)
\end{itemize}
\end{methodology}

