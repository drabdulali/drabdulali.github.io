\subsection{Computed Covariate Derivations}

\subsubsection{Feed Crops Percentage}

\begin{methodology}{Feed Crops Calculation}
\textbf{Rationale}: Feed crop availability correlates with pig farming intensity

\textbf{Code}:
\begin{lstlisting}
agriculture_covariates <- agri_by_county %>%
  mutate(
    # Feed crops = maize + barley + soybean
    feed_crops_ha = MAIZ_A + BARL_A + SOYB_A,

    # Percentage of total cultivated area
    feed_crops_pct = 100 * (feed_crops_ha / total_cultivated_ha),

    # Handle division by zero
    feed_crops_pct = ifelse(total_cultivated_ha == 0, 0, feed_crops_pct)
  )
\end{lstlisting}

\textbf{Biological relevance}:
\begin{itemize}
    \item High feed crop production $\rightarrow$ High pig density
    \item Maize is primary pig feed in Romania
    \item Correlates with backyard pig farming (vs commercial)
\end{itemize}
\end{methodology}

\subsubsection{Crop Diversity (Shannon Index)}

\begin{methodology}{Shannon Diversity Index}
\textbf{Formula}: $H = -\sum_{i=1}^{S} p_i \ln(p_i)$

where $p_i$ = proportion of area in crop $i$, $S$ = number of crops

\textbf{Code}:
\begin{lstlisting}
crop_diversity <- agri_wide %>%
  group_by(admin2_name) %>%
  summarize(
    crop_diversity_shannon = {
      # Get all crop area columns
      crops <- select(cur_data(), ends_with("_A"))

      # Remove zero values
      crops <- crops[crops > 0]

      # Return 0 if no crops
      if(length(crops) == 0) return(0)

      # Calculate proportions
      p <- crops / sum(crops)

      # Shannon index
      -sum(p * log(p))
    }
  )
\end{lstlisting}

\textbf{Interpretation}:
\begin{itemize}
    \item Higher values = more diverse agriculture
    \item Low diversity = monoculture (e.g., only maize)
    \item Range: 0 (single crop) to 3.74 (all 42 crops equally distributed)
    \item Romania range: 0.8 - 2.9
\end{itemize}

\textbf{Relevance to ASF}:
\begin{itemize}
    \item Monoculture $\rightarrow$ specialized farming $\rightarrow$ higher biosecurity
    \item High diversity $\rightarrow$ mixed farming $\rightarrow$ backyard systems $\rightarrow$ ASF risk
\end{itemize}
\end{methodology}

\subsubsection{All Computed Agricultural Covariates}

\begin{lstlisting}
# Complete agricultural covariate calculation
agriculture_covariates <- agri_by_county %>%
  left_join(crop_diversity, by = "admin2_name") %>%
  left_join(admin2_areas, by = "admin2_name") %>%
  mutate(
    # 1. Feed crops percentage
    feed_crops_pct = 100 * (MAIZ_A + BARL_A + SOYB_A) / total_cultivated_ha,

    # 2. Cereal crops percentage
    cereal_crops_pct = 100 * (WHEA_A + BARL_A + MAIZ_A) / total_cultivated_ha,

    # 3. Crop richness (count of crops present)
    crop_richness = rowSums(select(., ends_with("_A")) > 0),

    # 4. Maize dominance
    maize_dominance = MAIZ_A / total_cultivated_ha,

    # 5. Cultivated land percentage
    cultivated_land_pct = 100 * total_cultivated_ha / area_km2,

    # 6. Crop heterogeneity (coefficient of variation)
    crop_heterogeneity_cv = apply(select(., ends_with("_A")), 1,
                                   function(x) sd(x) / mean(x))
  )
\end{lstlisting}

