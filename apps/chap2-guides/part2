\subsection{Processing Methods (4 Approaches)}

\subsubsection{Method 1: Point-in-Polygon Count}

\begin{methodology}{Basic Spatial Join}
\textbf{Code}:
\begin{lstlisting}
# Filter for Romania and valid coordinates
wildboar_clean <- wildboar_data %>%
  filter(
    countryCode == "RO",
    !is.na(decimalLatitude),
    !is.na(decimalLongitude),
    decimalLatitude >= 43.5 & decimalLatitude <= 48.5,
    decimalLongitude >= 20 & decimalLongitude <= 30
  )

# Convert to spatial points
wildboar_sf <- st_as_sf(
  wildboar_clean,
  coords = c("decimalLongitude", "decimalLatitude"),
  crs = 4326
)

# Transform to match admin2 CRS
wildboar_sf <- st_transform(wildboar_sf, st_crs(romania_admin2))

# Spatial join: assign observations to counties
wildboar_joined <- st_join(wildboar_sf, romania_admin2)

# Count observations per county
wildboar_counts <- wildboar_joined %>%
  st_drop_geometry() %>%
  group_by(GID_2, NAME_2) %>%
  summarise(
    wildboar_observations = n(),
    wildboar_years_active = n_distinct(year, na.rm = TRUE)
  )
\end{lstlisting}

\textbf{Output}: Number of observations per county
\end{methodology}

\subsubsection{Method 2: Buffer-Based Counts}

\begin{methodology}{Neighborhood Wildlife Pressure}
\textbf{Rationale}: Wildlife in neighboring counties can contribute to spillover risk

\textbf{Code}:
\begin{lstlisting}
# Calculate county centroids
romania_centroids <- st_centroid(romania_admin2)

# Buffer distances to test
buffer_distances <- c(5, 10, 25)  # km

# For each buffer distance
for(buffer_km in buffer_distances) {
  # Create buffer around each county centroid
  buffer_m <- buffer_km * 1000
  commune_buffers <- st_buffer(romania_centroids, dist = buffer_m)

  # Count wild boar observations within each buffer
  observations_in_buffer <- sapply(1:nrow(commune_buffers), function(i) {
    within_buffer <- st_intersects(
      commune_buffers[i,],
      wildboar_sf,
      sparse = FALSE
    )
    sum(within_buffer)
  })

  # Add to metrics
  col_name <- paste0("wildboar_within_", buffer_km, "km")
  wildboar_metrics[[col_name]] <- observations_in_buffer
}
\end{lstlisting}

\textbf{Outputs}:
\begin{itemize}
    \item \texttt{wildboar\_within\_5km}: Immediate vicinity
    \item \texttt{wildboar\_within\_10km}: Local neighborhood
    \item \texttt{wildboar\_within\_25km}: Regional context
\end{itemize}
\end{methodology}

\subsubsection{Method 3: Presence/Absence}

\begin{methodology}{Binary Wildlife Indicator}
\textbf{Code}:
\begin{lstlisting}
wildboar_metrics <- wildboar_metrics %>%
  mutate(
    wildboar_presence = ifelse(wildboar_observations > 0, 1, 0)
  )
\end{lstlisting}

\textbf{Use}: Simple binary predictor for models where dose-response unclear
\end{methodology}

\subsubsection{Method 4: Density (per 100 km²)}

\begin{methodology}{Observation Density Calculation}
\textbf{Code}:
\begin{lstlisting}
# Calculate county areas
romania_admin2$area_km2 <- as.numeric(st_area(romania_admin2)) / 1e6

# Merge and calculate density
wildboar_metrics <- romania_admin2 %>%
  st_drop_geometry() %>%
  select(GID_2, NAME_2, area_km2) %>%
  left_join(wildboar_counts, by = c("GID_2", "NAME_2")) %>%
  mutate(
    # Replace NA with 0 for counties without observations
    wildboar_observations = ifelse(is.na(wildboar_observations), 0,
                                   wildboar_observations),

    # Calculate density per 100 km^2 (standardized scale)
    wildboar_density_per_100km2 = (wildboar_observations / area_km2) * 100,

    # Binary presence indicator
    wildboar_presence = ifelse(wildboar_observations > 0, 1, 0)
  )
\end{lstlisting}

\textbf{Why per 100 km²?}
\begin{itemize}
    \item Standardizes for county size variation
    \item 100 km² = typical home range for wild boar population
    \item Interpretable scale (observations per typical range)
\end{itemize}
\end{methodology}

\subsection{Distance to Nearest Observation}

\begin{methodology}{Proximity Metric}
\textbf{Code}:
\begin{lstlisting}
# Calculate distance from each county centroid to nearest wild boar
nearest_dist <- st_distance(romania_centroids, wildboar_sf)

# Find minimum distance for each county
min_dist_m <- apply(nearest_dist, 1, min)
min_dist_km <- as.numeric(min_dist_m) / 1000

# Add to metrics
wildboar_metrics$dist_to_nearest_wildboar_km <- min_dist_km
\end{lstlisting}

\textbf{Interpretation}:
\begin{itemize}
    \item 0 km = Wild boar observed in county
    \item 5-15 km = Adjacent county has wild boar
    \item $>$25 km = Far from known wild boar populations
\end{itemize}
\end{methodology}

