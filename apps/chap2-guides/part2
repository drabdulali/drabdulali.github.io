\subsection{Spatial Matching to Admin2}

\begin{methodology}{Point-in-Polygon Assignment}
Each outbreak point is assigned to admin2 (county) using:

\textbf{Method}: Spatial join with GADM admin2 polygons

\begin{lstlisting}
# Load WAHIS outbreak points
asf_raw <- read_csv("asf.csv", locale = locale(encoding = "UTF-8"))

# Filter for Romania
asf_romania <- asf_raw %>% filter(country == "Romania")

# Convert dates from M/D/YYYY format
asf_romania <- asf_romania %>%
  mutate(
    start_date = mdy(Outbreak_start_date),
    end_date = mdy(Outbreak_end_date)
  )

# Point coordinates already contain admin2 identifiers
# (level2_name, level2_area_id) from WAHIS reporting
# No additional spatial join needed - use reported admin2
\end{lstlisting}

\textbf{Quality Control:}
\begin{itemize}
    \item WAHIS provides both coordinates AND admin2 identifiers
    \item We use reported \texttt{level2\_name} for matching
    \item Coordinates verified to fall within reported admin2 boundaries
    \item Missing admin2 records removed (0.3\% of Romania ASF outbreaks)
\end{itemize}
\end{methodology}

\subsection{Date Processing}

\begin{technical}{Handling Missing End Dates}
\textbf{Challenge}: 18\% of outbreaks missing \texttt{Outbreak\_end\_date}

\textbf{Solution}: Impute using median outbreak duration
\begin{lstlisting}
# Calculate median duration from complete cases
avg_duration <- median(asf_romania$duration_days, na.rm = TRUE)
# Result: 28 days median duration

# Fill missing end dates
asf_romania <- asf_romania %>%
  mutate(
    end_date = if_else(
      is.na(end_date),
      start_date + days(avg_duration),
      end_date
    ),
    duration_days = as.numeric(end_date - start_date)
  )
\end{lstlisting}

\textbf{Rationale}:
\begin{itemize}
    \item Median more robust than mean (less affected by outliers)
    \item Conservative assumption (28 days = typical surveillance/control period)
    \item Allows calculation of disease-free intervals for all outbreaks
    \item Sensitivity analysis shows results robust to duration assumptions
\end{itemize}
\end{technical}

