\section{SPAM2020 Agricultural Rasters}
% ============================================================================

\subsection{Data Source Description}

\begin{datasource}{Spatial Production Allocation Model (SPAM) 2020}
\textbf{Provider}: International Food Policy Research Institute (IFPRI)\\
\textbf{URL}: \url{https://mapspam.info/}\\
\textbf{Version}: SPAM2020 v2.0 (released 2023)\\
\textbf{Coverage}: Global, 42 crops\\
\textbf{Spatial resolution}: 5 arc-minutes ($\sim$10 km at equator)\\
\textbf{Format}: GeoTIFF rasters\\
\textbf{Coordinate system}: WGS84 (EPSG:4326)\\
\textbf{License}: Creative Commons BY 4.0
\end{datasource}

\subsection{Format Specifications}

\begin{technical}{Understanding 5 Arc-Minutes Resolution}
\textbf{What does "5 arc-minutes" mean?}
\begin{itemize}
    \item 1 degree = 60 minutes = 3600 seconds
    \item 5 arc-minutes = 5/60 degrees = 0.0833 degrees
    \item At equator: $\sim$10 km per pixel
    \item At Romania (45°N latitude): $\sim$7 km per pixel
    \item 1 pixel $\approx$ 50 km$^2$ in Romania
\end{itemize}

\textbf{Implications:}
\begin{itemize}
    \item Fine enough to capture within-county variation
    \item Multiple pixels per admin2 polygon (mean: 12 pixels/county)
    \item Aggregation via \texttt{exact\_extract()} gives county-level means
\end{itemize}

\textbf{WGS84 coordinate system}:
\begin{itemize}
    \item EPSG:4326 (latitude/longitude in decimal degrees)
    \item Standard for global datasets
    \item Must transform to match admin2 CRS for extraction
\end{itemize}
\end{technical}

\subsection{File Naming Convention}

\begin{technical}{SPAM Raster Filenames Explained}
\textbf{Format}: \texttt{<crop>\_<production\_system>\_<variable>.tif}

\textbf{Examples}:
\begin{itemize}
    \item \texttt{MAIZ\_A.tif} = Maize, All systems, Area (hectares)
    \item \texttt{WHEA\_A.tif} = Wheat, All systems, Area
    \item \texttt{BARL\_A.tif} = Barley, All systems, Area
\end{itemize}

\textbf{Crop codes} (42 total, key ones for Romania):
\begin{itemize}
    \item MAIZ = Maize (feed crop for pigs)
    \item WHEA = Wheat
    \item BARL = Barley
    \item SOYB = Soybean
    \item SUNF = Sunflower
    \item POTA = Potato
\end{itemize}

\textbf{Variable codes}:
\begin{itemize}
    \item \_A = Area harvested (hectares)
    \item \_P = Production (metric tons)
    \item \_Y = Yield (tons/hectare)
\end{itemize}

\textbf{We use \_A (area) because}:
\begin{itemize}
    \item Most stable over time
    \item Less affected by weather variability than production/yield
    \item Indicates land use patterns relevant to pig farming
\end{itemize}
\end{technical}

\subsection{Extraction Procedure}

\begin{methodology}{terra::extract() Procedure}
\textbf{Complete extraction workflow}:

\begin{lstlisting}
library(terra)
library(sf)
library(exactextractr)

# Load admin2 polygons
admin2 <- st_read("gadm41_ROU_2.shp", quiet = TRUE)

# Load SPAM rasters (example: maize)
maize_raster <- rast("MAIZ_A.tif")

# Check CRS match
cat("Admin2 CRS:", st_crs(admin2)$input, "\n")
cat("Raster CRS:", crs(maize_raster, describe = TRUE)$code, "\n")

# Transform admin2 to match raster CRS if needed
admin2_proj <- st_transform(admin2, crs(maize_raster))

# Extract mean area per county
# exact_extract() handles partial pixels automatically
maize_stats <- exact_extract(
  maize_raster,
  admin2_proj,
  fun = "sum",  # Sum all pixel values within polygon
  progress = TRUE
)

# Add to admin2 data
admin2$maize_area_ha <- maize_stats
\end{lstlisting}

\textbf{Why sum, not mean?}
\begin{itemize}
    \item Each pixel value = hectares of maize in that pixel
    \item Sum = total hectares across all pixels in county
    \item Mean would give average pixel value (not meaningful)
\end{itemize}
\end{methodology}

