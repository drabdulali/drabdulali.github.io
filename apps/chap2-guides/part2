    \item \textbf{tertiary}: Local roads connecting villages
\end{itemize}

We exclude: footpaths, cycleways, service roads, residential streets (too numerous, less relevant to pig movement/trade)

\subsection{Road Density Calculation}

\subsubsection{Method 1: Line Intersection (Primary Method)}

\begin{methodology}{Total Road Length per County}
\textbf{Code}:
\begin{lstlisting}
# Load roads
roads <- st_read("romania_roads.shp", quiet = TRUE)

# Filter for major road types
major_roads <- roads %>%
  filter(highway %in% c("motorway", "trunk", "primary",
                        "secondary", "tertiary"))

# Ensure same CRS
roads_proj <- st_transform(major_roads, st_crs(admin2))

# Intersect roads with each county polygon
# st_intersection() clips roads to county boundaries
road_by_county <- st_intersection(roads_proj, admin2)

# Calculate total road length per county
road_stats <- road_by_county %>%
  mutate(
    # st_length() gives length in CRS units (meters)
    road_length_m = as.numeric(st_length(geometry))
  ) %>%
  st_drop_geometry() %>%
  group_by(NAME_2) %>%
  summarise(
    total_road_length_km = sum(road_length_m) / 1000,
    n_road_segments = n()
  )

# Merge with county areas and calculate density
road_density <- admin2 %>%
  st_drop_geometry() %>%
  select(NAME_2, area_km2) %>%
  left_join(road_stats, by = "NAME_2") %>%
  mutate(
    # Road density = km of road per km^2 of county area
    road_density_km_per_km2 = total_road_length_km / area_km2,

    # Handle counties with no major roads
    road_density_km_per_km2 = ifelse(is.na(road_density_km_per_km2), 0,
                                     road_density_km_per_km2)
  )
\end{lstlisting}

\textbf{Interpretation}:
\begin{itemize}
    \item High density ($>$1.5 km/km²) = Well-connected, accessible
    \item Medium density (0.5-1.5) = Moderate connectivity
    \item Low density ($<$0.5) = Rural, isolated
\end{itemize}
\end{methodology}

\subsubsection{Method 2: Buffer-Based (Alternative)}

\begin{methodology}{Road Proximity Metric}
\textbf{When to use}: If computational cost of intersection is too high

\textbf{Code}:
\begin{lstlisting}
# Create 1 km buffer around all roads
road_buffer <- st_buffer(major_roads, dist = 1000)

# Calculate percentage of county area within 1 km of road
road_access <- admin2 %>%
  mutate(
    area_within_1km_road = as.numeric(
      st_area(st_intersection(geometry, road_buffer))
    ) / 1e6,  # Convert m^2 to km^2

    pct_accessible = 100 * area_within_1km_road / area_km2
  )
\end{lstlisting}

\textbf{We used Method 1} because:
\begin{itemize}
    \item More direct measure of connectivity
    \item Differentiates between high-traffic (motorway) and local roads
    \item Better suited for Romania (small counties, dense road networks)
\end{itemize}
\end{methodology}

