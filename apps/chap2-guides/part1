\section{Expected Contributions}
% ============================================================================

\begin{keypoint}{What Will This Study Contribute?}
\textbf{Three Levels:}
\begin{enumerate}
    \item \textbf{Scientific:} Advances disease ecology theory
    \item \textbf{Methodological:} Provides reproducible framework
    \item \textbf{Policy:} Informs evidence-based TAD control
\end{enumerate}
\end{keypoint}

\subsection{Scientific Contributions}

\begin{detail}{Advancing Disease Ecology}
\textbf{1. Persistence vs Reemergence Framework:}
\begin{itemize}
    \item \textbf{Current state:} Most research conflates persistence and reemergence (both called "recurrence")
    \item \textbf{Our contribution:} Explicitly distinguishes incomplete elimination (persistence) from reintroduction (reemergence)
    \item \textbf{Implication:} Different mechanisms $\rightarrow$ Different risk factors $\rightarrow$ Different interventions
    \item \textbf{Theoretical:} Refines concepts in disease dynamics (endemic vs epidemic vs reemergence)
\end{itemize}

\textbf{2. Multi-Disease Comparative Analysis:}
\begin{itemize}
    \item \textbf{Current state:} Disease-specific studies (ASF literature separate from FMD literature, etc.)
    \item \textbf{Our contribution:} First systematic comparison of persistence/reemergence across 15 TADs
    \item \textbf{Question:} Are risk factors generalizable or disease-specific?
    \item \textbf{Implication:} Identifies universal principles vs context-dependent factors
\end{itemize}

\textbf{3. Spatial-Temporal Integration:}
\begin{itemize}
    \item \textbf{Current state:} Spatial models (where?) OR temporal models (when?), rarely both
    \item \textbf{Our contribution:} Combines spatial epidemiology (location-specific risk) with temporal dynamics (time to recurrence)
    \item \textbf{Method:} Logistic regression (spatial) + Cox survival (temporal)
    \item \textbf{Richer understanding:} Not just "which areas?" but "how long until recurrence?"
\end{itemize}

\textbf{4. Wildlife-Livestock Interface:}
\begin{itemize}
    \item \textbf{Current state:} Wildlife reservoirs recognized, but quantitative assessment limited
    \item \textbf{Our contribution:} Quantifies wildlife proximity effect on domestic animal disease recurrence
    \item \textbf{Data:} GBIF wildlife occurrence + WAHIS livestock outbreaks
    \item \textbf{Implication:} Evidence for One Health interventions (joint wildlife-livestock management)
\end{itemize}

\textbf{5. Environmental Drivers:}
\begin{itemize}
    \item \textbf{Current state:} Climate/environment considered for vector-borne diseases, less for directly transmitted
    \item \textbf{Our contribution:} Tests environmental predictors (tree cover, wetlands, water) for multiple transmission modes
    \item \textbf{Finding:} May show environment matters even for non-vector-borne (via wildlife, virus survival)
\end{itemize}
\end{detail}

\subsection{Methodological Contributions}

\begin{detail}{Reproducible Framework}
\textbf{1. Multi-Database Integration:}
\begin{itemize}
    \item \textbf{Challenge:} TAD data fragmented (WAHIS + GLW + FAOSTAT + MODIS + WorldClim + ...)
    \item \textbf{Our contribution:} Documented workflow for linking multiple data sources
    \item \textbf{Code:} GitHub repository with scripts for data cleaning, merging, spatial aggregation
    \item \textbf{Extensibility:} Other researchers can apply to different diseases/countries
\end{itemize}

\textbf{2. Spatial Epidemiology Protocol:}
\begin{itemize}
    \item \textbf{Contribution:} Step-by-step guide for TAD spatial analysis
    \item \textbf{Includes:} Spatial autocorrelation testing, admin-2 aggregation, distance calculations, buffer analysis
    \item \textbf{Tools:} Uses R (sf, raster, spatstat) - free, open-source
    \item \textbf{Training:} Methods section detailed enough for replication
\end{itemize}

\textbf{3. Handling Right-Censoring:}
\begin{itemize}
    \item \textbf{Challenge:} Not all units experience reemergence by study end (censored data)
    \item \textbf{Solution:} Cox proportional hazards (survival analysis)
    \item \textbf{Contribution:} Demonstrates survival analysis for TAD reemergence (underused method in veterinary epidemiology)
    \item \textbf{Advantage:} Uses all data (censored units still informative)
\end{itemize}

\textbf{4. Model Validation Best Practices:}
\begin{itemize}
    \item \textbf{Contribution:} Comprehensive validation workflow: train-test split, cross-validation, calibration, spatial autocorrelation
    \item \textbf{Addresses:} Overfitting, spatial confounding, model selection
    \item \textbf{Transparent:} Reports limitations (EPV, spatial autocorrelation in residuals)
    \item \textbf{Replicable:} Code provided for all validation steps
\end{itemize}
\end{detail}

\subsection{Policy Contributions}

\begin{detail}{Evidence-Based TAD Control}
\textbf{1. Risk-Based Surveillance:}
\begin{itemize}
    \item \textbf{Current approach:} Blanket surveillance (all farms/areas monitored equally) OR reactive (only after outbreak)
    \item \textbf{Problem:} Limited resources can't cover all areas effectively
    \item \textbf{Our tool:} Predictive model identifies high-risk areas for targeted surveillance
    \item \textbf{Impact:} 3-5× more efficient (focus resources where risk highest)
    \item \textbf{Example:} Instead of inspecting all 28,000 farms, target top 5,000 high-risk
\end{itemize}

\textbf{2. Prevention of Reemergence:}
\begin{itemize}
    \item \textbf{Current approach:} After area declared "disease-free," surveillance reduced/stopped
    \item \textbf{Problem:} Reemergence surprises (unprepared)
    \item \textbf{Our tool:} Reemergence risk model predicts which cleared areas need continued monitoring
    \item \textbf{Impact:} Early detection of reemergence $\rightarrow$ Faster response $\rightarrow$ Smaller outbreak
    \item \textbf{Trade:} Maintains disease-free status required for export markets
\end{itemize}

\textbf{3. Resource Allocation:}
\begin{itemize}
    \item \textbf{Problem:} TAD control underfunded (surveillance, vaccines, compensation)
    \item \textbf{Need:} Evidence to justify resource allocation
    \item \textbf{Our tool:} Identifies highest-impact areas (where investment reduces persistence most)
    \item \textbf{Cost-benefit:} Prevention cheaper than reaction (early detection saves millions)
\end{itemize}

\textbf{4. Intervention Design:}
\begin{itemize}
    \item \textbf{Finding:} Risk factors reveal intervention targets
    \item \textbf{Example:}
    \begin{itemize}
        \item If livestock density drives persistence $\rightarrow$ Target dense areas for enhanced biosecurity
        \item If wildlife drives persistence $\rightarrow$ Joint wildlife-livestock interventions
        \item If roads drive persistence $\rightarrow$ Vehicle disinfection, movement controls
    \end{itemize}
    \item \textbf{Tailored:} Context-specific recommendations (not one-size-fits-all)
\end{itemize}

\textbf{5. Generalizability Across Countries:}
\begin{itemize}
    \item \textbf{Romania model:} Specific to Romanian ASF
    \item \textbf{Framework:} Applicable anywhere with WAHIS data
    \item \textbf{Capacity:} Developing countries can replicate (data freely available, methods documented)
    \item \textbf{Global impact:} ASF affecting 50+ countries; FMD, avian influenza global; framework helps all
\end{itemize}
\end{detail}

\begin{warning}{Limitations to Policy Impact}
\textbf{Translating Research to Practice:}

\textbf{Challenges:}
\begin{itemize}
    \item \textbf{Political will:} Authorities must adopt risk-based approach (not always rational decision-making)
    \item \textbf{Capacity:} Veterinary services need training to use predictive models
    \item \textbf{Data access:} Ongoing surveillance data required for model updates (not always shared)
    \item \textbf{Farmer compliance:} Recommendations only work if farmers cooperate (resistance to culling, movement restrictions)
\end{itemize}

\textbf{Mitigation:}
\begin{itemize}
    \item \textbf{Engagement:} Collaborate with Romanian NSVFSA (National Sanitary Veterinary and Food Safety Authority) from start
    \item \textbf{User-friendly:} Develop web interface / dashboard for model (not just code)
    \item \textbf{Communication:} Plain-language policy briefs (not just academic papers)
    \item \textbf{Pilot:} Small-scale implementation to demonstrate value
\end{itemize}
\end{warning}

