\section{Why Romania? Country Selection Justification}
% ============================================================================

\begin{keypoint}{Four Reasons Romania is Optimal}
\begin{enumerate}
    \item \textbf{Data Availability:} Best available outbreak records, farm registry, spatial data
    \item \textbf{High Burden:} 66,530 ASF outbreaks (2017-2024), highest globally
    \item \textbf{Epidemic Characteristics:} Sustained transmission, diverse landscapes, commercial + backyard sectors
    \item \textbf{Generalizability:} European context with relevance to global ASF spread
\end{enumerate}
\end{keypoint}

\subsection{Data Availability}

\begin{detail}{Complete Data Infrastructure}
\textbf{1. Outbreak Records (WAHIS):}
\begin{itemize}
    \item Complete ASF reporting to WOAH since 2017
    \item Admin-2 level location (commune), dates, affected species
    \item Control measures documented (culling, movement restrictions)
    \item High reporting compliance (EU member state requirements)
\end{itemize}

\textbf{2. Farm Registry:}
\begin{itemize}
    \item National Sanitary Veterinary Authority maintains complete farm database
    \item 28,226 commercial pig farms with locations
    \item Backyard holdings estimated at 1.2 million
    \item Herd size, production type, biosecurity data available
\end{itemize}

\textbf{3. Livestock Data:}
\begin{itemize}
    \item GLW provides gridded pig density at 10km resolution
    \item FAOSTAT has national/subnational production statistics
    \item Temporal trends available (2010-2024)
    \item Disaggregated by production system (commercial vs backyard)
\end{itemize}

\textbf{4. Spatial/Environmental Data:}
\begin{itemize}
    \item MODIS tree cover (30m resolution)
    \item WorldClim climate variables (1km resolution)
    \item HydroSHEDS water bodies (1km resolution)
    \item OpenStreetMap road networks (vector data)
    \item Land use / crop data from European Space Agency
\end{itemize}

\textbf{5. Institutional Data:}
\begin{itemize}
    \item GDP at NUTS-2 level (Eurostat)
    \item Veterinary service capacity (WAHIS reports)
    \item Vaccination/culling coverage (national reports)
    \item Control policy timeline documented
\end{itemize}
\end{detail}

\subsection{High Disease Burden}

\begin{detail}{Romania as Global ASF Epicenter}
\textbf{Outbreak Numbers:}
\begin{itemize}
    \item \textbf{66,530 total ASF outbreaks} (2017-2024)
    \item Represents \textbf{highest burden of any country globally}
    \item For comparison: Next highest is China (~20,000), Vietnam (~8,000)
    \item Romania accounts for >40\% of all European ASF outbreaks
\end{itemize}

\textbf{Spatial Distribution:}
\begin{itemize}
    \item Outbreaks in 537 of 3,181 communes (16.9\%)
    \item All 42 counties affected at some point
    \item Southeast region most affected (bordering Bulgaria, where ASF entered)
    \item Urban-rural gradient visible (higher in rural areas)
\end{itemize}

\textbf{Temporal Dynamics:}
\begin{itemize}
    \item \textbf{2017:} Initial introduction (first outbreaks July 2017)
    \item \textbf{2018-2019:} Rapid spread phase (establishing transmission)
    \item \textbf{2020-2022:} Peak incidence (thousands of outbreaks/year)
    \item \textbf{2023-2024:} Sustained endemic transmission (ongoing outbreaks)
\end{itemize}

\textbf{Sectoral Impact:}
\begin{itemize}
    \item Backyard farms: ~98\% of outbreaks (small-holder, low biosecurity)
    \item Commercial farms: ~2\% of outbreaks (but larger economic impact)
    \item Wild boar: Parallel sylvatic cycle (wildlife reservoir)
    \item Dual transmission: Domestic pigs ↔ wild boar interface
\end{itemize}

\textbf{Why High Burden is Advantage:}
\begin{itemize}
    \item \textbf{Statistical power:} Large sample size enables robust modeling
    \item \textbf{Spatial variation:} Affected and unaffected areas provide contrast
    \item \textbf{Temporal dynamics:} Long enough for persistence/reemergence patterns
    \item \textbf{Policy relevance:} Urgent need for risk prediction tools
\end{itemize}
\end{detail}

\subsection{Epidemic Characteristics}

\begin{detail}{What Makes Romania an Ideal Case Study}
\textbf{1. Sustained Transmission:}
\begin{itemize}
    \item Unlike some countries with sporadic incursions, Romania has \textit{endemic} ASF
    \item Continuous transmission for 6+ years (2018-2024)
    \item Allows study of persistence (repeated outbreaks in same areas)
    \item Allows study of reemergence (return after disease-free periods)
\end{itemize}

\textbf{2. Diverse Landscapes:}
\begin{itemize}
    \item \textbf{Carpathian Mountains:} High elevation, forest cover, wild boar habitat
    \item \textbf{Danube Delta:} Wetlands, waterways, migratory bird interface
    \item \textbf{Plains (Bărăgan):} Intensive agriculture, commercial farms
    \item \textbf{Mixed:} Mosaic of crop, forest, pasture creates edge effects
    \item This heterogeneity allows testing environmental predictors across contexts
\end{itemize}

\textbf{3. Dual Production Systems:}
\begin{itemize}
    \item \textbf{Commercial farms:} ~30,000 farms, 4-5 million pigs, high biosecurity
    \item \textbf{Backyard farms:} ~1.2 million holdings, 2-3 million pigs, low biosecurity
    \item \textbf{Interaction:} Movement between sectors, shared infrastructure
    \item Allows comparison of risk factors across biosecurity levels
\end{itemize}

\textbf{4. Wildlife Interface:}
\begin{itemize}
    \item Large wild boar population (~200,000 estimated)
    \item Forest-farm interface creates contact opportunities
    \item Hunting practices may contribute to spread
    \item Sylvatic cycle maintains virus in environment
\end{itemize}

\textbf{5. Control Interventions:}
\begin{itemize}
    \item Mass culling campaigns (>2 million pigs culled 2017-2024)
    \item Movement restrictions (control zones around outbreaks)
    \item Depopulation of backyard farms in affected areas
    \item Wild boar management (population reduction, passive surveillance)
    \item This variation in control intensity allows evaluation of intervention effectiveness
\end{itemize}
\end{detail}

\subsection{Generalizability}

\begin{detail}{Why Romania Findings Apply Elsewhere}
\textbf{1. European Context:}
\begin{itemize}
    \item EU member state = standardized reporting, veterinary capacity
    \item Represents European agricultural systems (important for Western Europe ASF risk)
    \item Similar farm structures to Poland, Hungary, Bulgaria (neighboring countries with ASF)
    \item Findings inform EU-wide ASF control strategies
\end{itemize}

\textbf{2. Global ASF Relevance:}
\begin{itemize}
    \item ASF now on every continent except Australia and Antarctica
    \item Romania's epidemic similar to other countries: China (2018+), Vietnam (2019+), Germany (2020+)
    \item Mixed commercial-backyard systems common in Southeast Asia, Eastern Europe, Africa
    \item Wildlife reservoirs (wild boar) also issue in Europe, Asia, South Africa
\end{itemize}

\textbf{3. TAD Generalizability:}
\begin{itemize}
    \item Risk factors (density, environment, infrastructure) likely apply to other TADs
    \item Framework adaptable: Pooled analysis tests generalizability across 15 TADs
    \item Methods (logistic regression, survival analysis) standard in disease ecology
    \item Data sources (WAHIS, GLW, remote sensing) available for all countries/diseases
\end{itemize}

\textbf{4. Policy Translation:}
\begin{itemize}
    \item Romania's veterinary system similar to other middle-income countries
    \item Resource constraints mirror developing countries
    \item Risk-based surveillance approach applicable anywhere
    \item Model framework can be retrained for other countries with local data
\end{itemize}
\end{detail}

\begin{warning}{What Romania Doesn't Represent}
\textbf{Limitations to Generalizability:}
\begin{itemize}
    \item \textbf{Climate:} Temperate continental (findings may not apply to tropical/arid regions)
    \item \textbf{Development:} Middle-income EU member (not representative of low-income countries)
    \item \textbf{Farm structure:} Large backyard sector (different from highly commercialized systems like USA)
    \item \textbf{Wildlife:} Wild boar specific (other TADs have different reservoirs: rodents, birds)
\end{itemize}

\textbf{Mitigation:}
\begin{itemize}
    \item Pooled 15-TAD analysis tests generalizability across diseases and countries
    \item Discussion section addresses context-specific limitations
    \item Future work: Validate model in other countries (China, Vietnam, Poland)
\end{itemize}
\end{warning}

