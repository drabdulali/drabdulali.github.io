\section{Summary: Why This Project Design?}
% ============================================================================

\begin{keypoint}{Bringing It All Together}
Every component of this study design is justified by:
\begin{enumerate}
    \item \textbf{Scientific rigor:} Uses established methods (logistic regression, survival analysis) with appropriate validation
    \item \textbf{Data availability:} Works within constraints of WAHIS reporting, GLW grids, remote sensing
    \item \textbf{Biological plausibility:} Each predictor has clear mechanistic pathway to outcome
    \item \textbf{Policy relevance:} Answers questions authorities actually need answered
    \item \textbf{Reproducibility:} Open data, open code, documented workflow
\end{enumerate}
\end{keypoint}

\begin{detail}{Design Principles Applied}
\textbf{1. Question Drives Design:}
\begin{itemize}
    \item Started with policy need: "Why do some areas have recurring outbreaks?"
    \item Defined outcomes (persistence, reemergence) to match question
    \item Selected predictors based on hypothesized mechanisms
    \item Chose methods appropriate for outcome type (binary $\rightarrow$ logistic; time-to-event $\rightarrow$ Cox)
\end{itemize}

\textbf{2. Data Availability Constrains Ambition:}
\begin{itemize}
    \item Ideal: Farm-level data with exact locations, biosecurity scores, movement records
    \item Reality: Admin-2 outbreak reports, gridded livestock density, remote sensing
    \item Design: Work within constraints, acknowledge limitations, plan future work with better data
\end{itemize}

\textbf{3. Balance Complexity and Interpretability:}
\begin{itemize}
    \item Could use machine learning (random forests, neural nets) for higher AUC
    \item Chose logistic regression: Lower AUC but interpretable (policy-makers understand odds ratios)
    \item Trade-off: Modest performance gain not worth loss of interpretability
\end{itemize}

\textbf{4. Validation Prevents Overfitting:}
\begin{itemize}
    \item High sample size (404 EPV) tempting to include many predictors
    \item Restraint: Limited to 5 predictors (biological + statistical justification)
    \item Cross-validation ensures generalizability (not just training fit)
\end{itemize}

\textbf{5. Generalizability Through Comparison:}
\begin{itemize}
    \item Single-disease study (Romania ASF) provides depth
    \item Multi-disease study (15 TADs) provides breadth
    \item Combined: Detailed mechanisms (ASF) + Universal principles (pooled)
\end{itemize}
\end{detail}

\begin{methodology}{Exam Defense Strategy}
\textbf{If Asked: "Why did you design the study this way?"}

\textbf{Template Answer:}
\begin{enumerate}
    \item \textbf{Start with objective:} "The goal was to [predict persistence/reemergence] to inform [targeted surveillance]."
    \item \textbf{Justify outcome:} "I defined [persistence] as [binary, 6-24 months] because [distinguishes incomplete elimination from reintroduction]."
    \item \textbf{Justify predictors:} "I selected [livestock density, tree cover, ...] because [mechanistic pathways + prior evidence]."
    \item \textbf{Justify methods:} "I used [logistic regression] because [binary outcome + interpretable odds ratios]."
    \item \textbf{Justify scale:} "I analyzed admin-2 level because [data availability + policy relevance]."
    \item \textbf{Acknowledge alternatives:} "I considered [alternative definitions/methods] but chose [X] because [reason]."
    \item \textbf{State limitations:} "The design has limitations [ecological fallacy, observational] which I address by [...]."
\end{enumerate}

\textbf{Key Phrases:}
\begin{itemize}
    \item "This decision balances [competing priorities]..."
    \item "Given data constraints, this approach is optimal..."
    \item "I tested alternative definitions in sensitivity analysis..."
    \item "This aligns with prior literature [cite] while extending to [novel aspect]..."
\end{itemize}
\end{methodology}

