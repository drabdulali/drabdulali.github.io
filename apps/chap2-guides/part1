\section{Conceptual Framework: Predictors → Outcome}
% ============================================================================

\begin{keypoint}{How Do Risk Factors Cause Persistence/Reemergence?}
This section maps the \textbf{causal pathways} from predictors to outcome. Each predictor must have a plausible biological/social mechanism.
\end{keypoint}

\subsection{Causal Pathway Diagram}

\begin{detail}{From Predictors to Outcome}
\textbf{General Framework:}

\textbf{Risk Factors} $\rightarrow$ \textbf{Transmission Opportunity} $\rightarrow$ \textbf{Outbreak} $\rightarrow$ \textbf{Incomplete Elimination OR Reintroduction} $\rightarrow$ \textbf{Persistence/Reemergence}

\textbf{Breakdown by Predictor Category:}

\textbf{1. ECOLOGICAL (Livestock Density, Susceptible Animals):}
\begin{itemize}
    \item \textbf{Mechanism:} More susceptible animals $\rightarrow$ Higher contact rate $\rightarrow$ Faster transmission $\rightarrow$ Larger outbreaks $\rightarrow$ Harder to eliminate completely
    \item \textbf{Persistence pathway:} Virus circulates longer in dense populations (takes longer to eliminate)
    \item \textbf{Reemergence pathway:} Dense populations = attractive targets for virus introduction (more susceptibles)
    \item \textbf{Evidence:} SIR models show transmission rate $\propto$ density
\end{itemize}

\textbf{2. ENVIRONMENTAL (Tree Cover, Water Bodies, Wetlands):}
\begin{itemize}
    \item \textbf{Mechanism:} Environmental features $\rightarrow$ Wildlife habitat $\rightarrow$ Reservoir populations $\rightarrow$ Spillover to domestic animals
    \item \textbf{Tree cover:} Wild boar habitat $\rightarrow$ Higher boar density $\rightarrow$ Boar-pig contact $\rightarrow$ Cross-species transmission
    \item \textbf{Wetlands:} Waterfowl habitat (relevant for avian influenza) $\rightarrow$ Wild bird contact with poultry
    \item \textbf{Water bodies:} Virus survival in water $\rightarrow$ Environmental contamination $\rightarrow$ Indirect transmission
    \item \textbf{Persistence pathway:} Environmental reservoirs maintain virus between outbreaks
    \item \textbf{Reemergence pathway:} Wildlife reintroduces virus after domestic clearance
\end{itemize}

\textbf{3. WILDLIFE INTERFACE (Wildlife Proximity, Habitat Quality):}
\begin{itemize}
    \item \textbf{Mechanism:} Domestic-wildlife interface $\rightarrow$ Contact opportunity $\rightarrow$ Pathogen spillover
    \item \textbf{ASF example:} Wild boar $\leftrightarrow$ domestic pigs (shared environment, direct contact, contaminated carcasses)
    \item \textbf{Avian influenza example:} Wild waterfowl $\rightarrow$ poultry (shared water sources, overlapping habitat)
    \item \textbf{Persistence pathway:} Wildlife maintains virus $\rightarrow$ Repeated spillover to domestic animals
    \item \textbf{Reemergence pathway:} After domestic elimination, wildlife reintroduces virus
\end{itemize}

\textbf{4. INFRASTRUCTURE (Road Density, Accessibility):}
\begin{itemize}
    \item \textbf{Mechanism:} Roads $\rightarrow$ Movement (animals, vehicles, people) $\rightarrow$ Pathogen transport $\rightarrow$ Spread
    \item \textbf{Higher road density:} More connections $\rightarrow$ Faster spread $\rightarrow$ Larger outbreak extent $\rightarrow$ Harder to control
    \item \textbf{Contaminated vehicles:} Trucks, equipment carry virus between farms
    \item \textbf{Persistence pathway:} Well-connected areas have continuous reintroduction (nearby infected areas)
    \item \textbf{Reemergence pathway:} Roads facilitate reintroduction after clearance
\end{itemize}

\textbf{5. INSTITUTIONAL (Vaccination/Culling Coverage, GDP):}
\begin{itemize}
    \item \textbf{Mechanism:} Control capacity $\rightarrow$ Effective intervention $\rightarrow$ Outbreak elimination $\rightarrow$ Reduced persistence
    \item \textbf{Higher vaccination:} Reduces susceptibles $\rightarrow$ Breaks transmission $\rightarrow$ Outbreak contained
    \item \textbf{Higher culling:} Removes infected/exposed $\rightarrow$ Eliminates virus $\rightarrow$ Prevents recurrence
    \item \textbf{Higher GDP:} Better resources (veterinary capacity, surveillance, farmer compliance) $\rightarrow$ Faster detection + response
    \item \textbf{Persistence pathway:} Weak control $\rightarrow$ Incomplete elimination $\rightarrow$ Virus persists locally
    \item \textbf{Reemergence pathway:} Weak control $\rightarrow$ Neighboring outbreaks not contained $\rightarrow$ Reintroduction from nearby
\end{itemize}
\end{detail}

