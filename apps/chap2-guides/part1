\section{Research Questions}
% ============================================================================

\begin{keypoint}{The Central Question}
\textbf{What risk factors are associated with transboundary animal disease (TAD) outbreak persistence and reemergence in high-burden countries?}

This breaks into two complementary sub-questions:
\begin{enumerate}
    \item \textbf{PERSISTENCE}: Which ecological, environmental, and institutional factors predict short-interval outbreak recurrence (within 6-24 months)?
    \item \textbf{REEMERGENCE}: What factors determine time to disease reemergence after prolonged absence ($\geq$2 years disease-free)?
\end{enumerate}
\end{keypoint}

\subsection{Why This Question Matters}

\begin{detail}{Scientific Importance}
\textbf{1. Knowledge Gap:}
\begin{itemize}
    \item Most TAD research focuses on \textit{initial} outbreak occurrence, not \textit{recurrence}
    \item We know little about why some areas experience disease repeatedly while others don't
    \item Persistence and reemergence likely have different drivers than first introductions
    \item Current models predict presence/absence but not temporal dynamics of recurrence
\end{itemize}

\textbf{2. Theoretical Contribution:}
\begin{itemize}
    \item Tests whether disease ecology principles (susceptible populations, transmission pathways, environmental suitability) apply to \textit{recurrence} risk
    \item Distinguishes between short-term persistence (incomplete elimination) vs long-term reemergence (reintroduction after clearance)
    \item Addresses whether risk factors are generalizable across diseases or disease-specific
    \item Connects spatial epidemiology with temporal disease dynamics
\end{itemize}

\textbf{3. Methodological Innovation:}
\begin{itemize}
    \item Uses two complementary modeling approaches (logistic regression for persistence, survival analysis for reemergence)
    \item Integrates multi-database approach (WAHIS + GLW + FAOSTAT + remote sensing)
    \item Applies spatial epidemiological methods to longitudinal TAD data
    \item Develops reproducible framework applicable to other diseases/countries
\end{itemize}
\end{detail}

\begin{detail}{Policy Relevance}
\textbf{1. Resource Allocation:}
\begin{itemize}
    \item TAD control is resource-intensive: surveillance, culling, vaccination, movement restrictions
    \item Countries need evidence-based targeting: Where should we focus limited resources?
    \item Risk-based surveillance more efficient than blanket coverage
    \item Predicted high-risk areas merit enhanced monitoring and prevention
\end{itemize}

\textbf{2. Prevention vs Reaction:}
\begin{itemize}
    \item Current approach is largely reactive: outbreak $\rightarrow$ response $\rightarrow$ wait for next outbreak
    \item Predictive models enable proactive prevention in high-risk areas
    \item Early warning systems can trigger enhanced surveillance before reemergence
    \item Cost-benefit strongly favors prevention over reaction
\end{itemize}

\textbf{3. Economic Impact:}
\begin{itemize}
    \item ASF alone costs Romania \$100+ million annually (culling, trade restrictions, farm closures)
    \item Across 15 TADs, global impact exceeds \$20 billion annually
    \item Reducing recurrence by even 10-20\% saves millions
    \item Trade restrictions from endemic disease devastate export-dependent countries
\end{itemize}

\textbf{4. Food Security:}
\begin{itemize}
    \item TADs threaten protein supply in developing countries (>60\% depend on livestock)
    \item Repeated outbreaks destabilize food systems and rural livelihoods
    \item Small-holder farmers disproportionately affected by recurrent disease
    \item Prevention of reemergence critical for sustainable livestock production
\end{itemize}
\end{detail}

\subsection{Research Question Components}

\begin{methodology}{Breaking Down the Question}
\textbf{What} are we predicting?
\begin{itemize}
    \item \textbf{Outcome 1 (Persistence):} Binary - Did disease recur within 6-24 months? (Yes/No)
    \item \textbf{Outcome 2 (Reemergence):} Time-to-event - How long until disease returned after $\geq$2 years disease-free?
\end{itemize}

\textbf{Which} risk factors?
\begin{itemize}
    \item \textbf{Ecological:} Livestock density, susceptible animal populations
    \item \textbf{Environmental:} Tree cover, climate, water bodies, wetlands
    \item \textbf{Wildlife Interface:} Wildlife habitat, disease reservoir proximity
    \item \textbf{Infrastructure:} Road density, accessibility, connectivity
    \item \textbf{Institutional:} Vaccination/culling coverage, GDP, control capacity
\end{itemize}

\textbf{Where} is the study conducted?
\begin{itemize}
    \item \textbf{Focus:} High-burden countries (most reported outbreaks per TAD)
    \item \textbf{Case Study:} Romania (ASF) - 66,530 outbreaks, highest burden globally
    \item \textbf{Spatial Scale:} Admin-2 level (commune/county) - where outbreaks reported
\end{itemize}

\textbf{When} is the study period?
\begin{itemize}
    \item \textbf{Overall project:} 2005-2025 (20 years of WAHIS data)
    \item \textbf{Romania ASF:} 2018-2024 (post-first introduction, sufficient outbreak density)
\end{itemize}
\end{methodology}

