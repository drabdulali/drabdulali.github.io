\section{Study Period Justification}
% ============================================================================

\begin{keypoint}{Two Study Periods}
\textbf{Pooled Analysis (15 TADs):} 2005-2025 (20 years)

\textbf{Romania Case Study (ASF):} 2018-2024 (6 years)

Different durations reflect data availability and epidemic timing.
\end{keypoint}

\subsection{Pooled Analysis: 2005-2025}

\begin{detail}{Why These 20 Years?}
\textbf{Start Date (2005):}
\begin{itemize}
    \item \textbf{WAHIS Launch:} World Animal Health Information System began comprehensive global reporting in 2005
    \item \textbf{Standardization:} Pre-2005 data inconsistent (different reporting systems, incomplete coverage)
    \item \textbf{Digital Records:} 2005+ data digitized, structured, accessible via API
    \item \textbf{Coverage:} Near-complete country participation (193/195 OIE members report)
\end{itemize}

\textbf{End Date (2025):}
\begin{itemize}
    \item \textbf{Current:} Analysis uses most recent data available (as of 2025)
    \item \textbf{Relevant:} Recent outbreaks reflect current agricultural systems, control capacity
    \item \textbf{Complete:} 20-year span captures multiple epidemic cycles
\end{itemize}

\textbf{Why 20 Years is Optimal:}
\begin{itemize}
    \item \textbf{Long enough:} Captures persistence (short-term recurrence) and reemergence (long-term reintroduction)
    \item \textbf{Multiple waves:} Most TADs have multiple introduction-spread-control cycles in 20 years
    \item \textbf{Temporal variation:} Sufficient time for environmental/institutional changes
    \item \textbf{Power:} 20 years × 15 TADs × multiple countries = massive sample size
\end{itemize}

\textbf{What About Earlier Data (Pre-2005)?}
\begin{itemize}
    \item \textbf{Exists but problematic:} OIE collected reports pre-2005, but not systematically
    \item \textbf{Inconsistent:} Reporting formats changed, coverage incomplete
    \item \textbf{Not digitized:} Much pre-2005 data only in paper reports
    \item \textbf{Bias:} Including inconsistent historical data introduces more noise than signal
    \item \textbf{Decision:} Prioritize data quality over duration
\end{itemize}
\end{detail}

\subsection{Romania Case Study: 2018-2024}

\begin{detail}{Why Start in 2018 (Not 2017)?}
\textbf{ASF Timeline in Romania:}
\begin{itemize}
    \item \textbf{July 2017:} First ASF detection (Satu Mare county, near Ukraine border)
    \item \textbf{Late 2017:} Sporadic outbreaks, rapid response, localized spread
    \item \textbf{2018 onwards:} Established transmission, sustained epidemic
\end{itemize}

\textbf{Why Exclude 2017?}
\begin{itemize}
    \item \textbf{Introductory phase:} Initial outbreaks don't represent persistence/reemergence (first occurrence)
    \item \textbf{Incomplete year:} Only 5-6 months of data (July-December 2017)
    \item \textbf{Surveillance artifacts:} Enhanced detection after first outbreak (reporting bias)
    \item \textbf{Small sample:} Only ~100 outbreaks in 2017 vs 1,000+ in 2018
    \item \textbf{Conceptual:} Persistence requires $\geq$2 outbreaks (can't define persistence in year 1)
\end{itemize}

\textbf{Why Start in 2018?}
\begin{itemize}
    \item \textbf{Established transmission:} Virus circulating widely (not just initial introduction)
    \item \textbf{Full year:} Complete January-December data
    \item \textbf{Persistence possible:} Can define recurrence (areas with 2017 outbreaks + 2018 recurrence)
    \item \textbf{Adequate sample:} Sufficient outbreaks for statistical power
    \item \textbf{Stable surveillance:} Reporting system established, less detection bias
\end{itemize}
\end{detail}

\begin{detail}{Why End in 2024 (Not Earlier/Later)?}
\textbf{Upper Bound (2024):}
\begin{itemize}
    \item \textbf{Data availability:} Most recent complete data at time of analysis
    \item \textbf{Ongoing epidemic:} ASF still circulating in Romania (endemic)
    \item \textbf{Relevance:} Recent data reflects current risk landscape
    \item \textbf{Future:} Model can be updated as new data becomes available
\end{itemize}

\textbf{Why Not Longer (2025+)?}
\begin{itemize}
    \item \textbf{Data lag:} WAHIS reports typically 3-6 months delayed (not yet complete for 2025)
    \item \textbf{Validation:} Holding out 2025+ as independent validation set (future work)
    \item \textbf{Sufficient:} 6 years (2018-2024) adequate for persistence + reemergence
\end{itemize}

\textbf{Is 6 Years Enough?}
\begin{itemize}
    \item \textbf{Persistence:} Yes. Need 6-24 months between outbreaks. 6 years = multiple recurrence cycles.
    \item \textbf{Reemergence:} Marginal. Need $\geq$2 years disease-free + reintroduction. 6 years allows 1-2 reemergence events per area.
    \item \textbf{Sample size:} 1,976 outbreaks = statistically adequate (404 EPV)
    \item \textbf{Trade-off:} Longer period better, but must balance with data availability
\end{itemize}
\end{detail}

\begin{warning}{Reemergence Analysis Limitation}
\textbf{Challenge:} Defining reemergence requires $\geq$2 years disease-free.

\textbf{Implication:} In 6-year study period (2018-2024), can only observe:
\begin{itemize}
    \item Disease-free 2018-2019 $\rightarrow$ reemergence 2020-2024 (possible)
    \item Disease-free 2020-2021 $\rightarrow$ reemergence 2022-2024 (possible)
    \item Disease-free 2022-2023 $\rightarrow$ reemergence 2024 (limited window)
\end{itemize}

\textbf{Result:} Fewer reemergence events than persistence events.

\textbf{Mitigation:}
\begin{itemize}
    \item Focus analysis on persistence (larger sample)
    \item Treat reemergence as complementary secondary analysis
    \item Acknowledge power limitation in discussion
    \item Consider alternative definition: 1-year disease-free (sensitivity analysis)
\end{itemize}
\end{warning}

