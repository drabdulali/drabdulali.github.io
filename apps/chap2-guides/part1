\section{Key Definitions with Deep Detail}
% ============================================================================

\subsection{Persistence: Complete Definition}

\begin{keypoint}{What is Persistence?}
\textbf{Operational Definition:}

A location (admin-2 unit) experiences \textit{persistence} if it has $\geq$2 outbreaks with the second outbreak occurring 6-24 months after the first.

\textbf{Binary Outcome:}
\begin{itemize}
    \item Persistence = 1 (Yes, disease recurred within 6-24 months)
    \item Persistence = 0 (No, disease did not recur, or recurred outside 6-24 month window)
\end{itemize}
\end{keypoint}

\begin{detail}{Why This Definition? Breaking It Down}
\textbf{Component 1: $\geq$2 Outbreaks}

\textit{Why require 2+ outbreaks?}
\begin{itemize}
    \item \textbf{Conceptual:} Persistence = recurrence. Can't have recurrence without initial outbreak + subsequent outbreak.
    \item \textbf{Excludes single outbreaks:} Areas with 1 outbreak are different (introduction, not persistence).
    \item \textbf{Policy relevance:} Authorities care about \textit{repeated} risk, not one-time events.
\end{itemize}

\textit{Why not require 3+ outbreaks?}
\begin{itemize}
    \item \textbf{Sample size:} Requiring 3+ outbreaks drastically reduces sample (many areas have exactly 2).
    \item \textbf{Sufficient:} 2 outbreaks establishes pattern (not random introduction).
    \item \textbf{Sensitivity analysis:} Can test 3+ outbreak threshold separately.
\end{itemize}

\textbf{Component 2: 6-24 Month Window}

\textit{Why 6 months minimum?}
\begin{itemize}
    \item \textbf{Excludes surveillance artifacts:} Outbreaks within days/weeks often same event (detected progressively).
    \item \textbf{Biological plausibility:} ASF incubation + detection takes weeks. True recurrence unlikely <6 months.
    \item \textbf{Control interventions:} Culling, movement restrictions typically last 3-6 months. Recurrence <6 months suggests control failure during active intervention (different mechanism).
    \item \textbf{Literature:} Most disease ecology studies use 3-6 month minimum for recurrence.
\end{itemize}

\textit{Why 24 months maximum?}
\begin{itemize}
    \item \textbf{Distinguishes persistence from reemergence:} >24 months suggests reintroduction (new source), not incomplete elimination.
    \item \textbf{Biological:} If virus persists locally (low-level circulation), expect recurrence within ~2 years.
    \item \textbf{Policy:} Short-term recurrence (6-24 months) suggests local control inadequate. Long-term (>2 years) suggests external reintroduction.
    \item \textbf{Alternative:} Can test 12-month or 18-month cutoffs (sensitivity analysis).
\end{itemize}

\textbf{Component 3: Same Admin-2 Unit}

\textit{Why same location?}
\begin{itemize}
    \item \textbf{Spatial specificity:} Persistence is location-specific. Risk factors should predict \textit{which areas} experience recurrence.
    \item \textbf{Neighboring outbreaks different:} Spread to adjacent area = transmission, not persistence.
    \item \textbf{Policy:} Surveillance/control targeted at \textit{specific} high-risk communes.
\end{itemize}

\textit{What about neighboring admin-2 units?}
\begin{itemize}
    \item \textbf{Nearby outbreaks:} Suggest local transmission (captured by spatial predictors like density).
    \item \textbf{Not same as persistence:} Neighboring area outbreak doesn't make original area "persistent."
    \item \textbf{Analysis:} Spatial autocorrelation tests capture neighboring effects.
\end{itemize}
\end{detail}

\begin{methodology}{How Persistence is Calculated: Code Example}
\textbf{Step-by-Step Calculation:}

\begin{lstlisting}
# Load outbreak data
outbreaks <- read_csv("romania_asf_outbreaks.csv")

# Step 1: Sort by location and date
outbreaks <- outbreaks %>%
  arrange(admin2_code, outbreak_date)

# Step 2: Calculate time between consecutive outbreaks in same location
outbreaks <- outbreaks %>%
  group_by(admin2_code) %>%
  mutate(
    days_since_last = as.numeric(outbreak_date - lag(outbreak_date)),
    months_since_last = days_since_last / 30.44  # Average month length
  )

# Step 3: Define persistence (>=2 outbreaks, 6-24 months apart)
admin2_persistence <- outbreaks %>%
  group_by(admin2_code) %>%
  summarise(
    total_outbreaks = n(),
    persistence = if_else(
      total_outbreaks >= 2 &
      any(months_since_last >= 6 & months_since_last <= 24, na.rm=TRUE),
      1,  # Persistence = YES
      0   # Persistence = NO
    )
  )

# Result: Each admin-2 unit has binary persistence outcome
# Use this as dependent variable in logistic regression
\end{lstlisting}

\textbf{Example Output:}
\begin{lstlisting}
# admin2_code   total_outbreaks   persistence
# RO-AB-001              5              1     # 5 outbreaks, at least one recurrence 6-24 months
# RO-AB-002              1              0     # Only 1 outbreak, no recurrence
# RO-AB-003              3              0     # 3 outbreaks, but all >24 months apart (reemergence, not persistence)
# RO-AB-004              2              1     # 2 outbreaks, 18 months apart (persistence)
\end{lstlisting}
\end{methodology}

\begin{detail}{Alternative Definitions Considered}
\textbf{1. Continuous Outcome: Number of Recurrences}
\begin{itemize}
    \item \textbf{Definition:} Count of outbreaks within 6-24 months of prior outbreak
    \item \textbf{Model:} Poisson or negative binomial regression
    \item \textbf{Advantage:} Uses more information (degree of persistence)
    \item \textbf{Disadvantage:} Harder to interpret for policy (binary easier: "Is this area high-risk?")
    \item \textbf{Decision:} Use binary for main analysis, continuous for sensitivity
\end{itemize}

\textbf{2. Different Time Windows}
\begin{itemize}
    \item \textbf{3-12 months:} Very short-term (acute persistence)
    \item \textbf{12-36 months:} Extended medium-term
    \item \textbf{Decision:} Test multiple windows in sensitivity analysis
\end{itemize}

\textbf{3. Proportion of Years with Outbreaks}
\begin{itemize}
    \item \textbf{Definition:} Of 6 study years, how many had $\geq$1 outbreak?
    \item \textbf{Advantage:} Captures chronic endemicity
    \item \textbf{Disadvantage:} Doesn't distinguish timing (e.g., years 1,2,3 vs years 1,3,6)
    \item \textbf{Decision:} Not used (loses temporal information)
\end{itemize}

\textbf{4. Clinical Definition (Individual-Level Persistence)}
\begin{itemize}
    \item \textbf{Definition:} Same animal has persistent infection (chronic carrier)
    \item \textbf{Not applicable:} ASF is acute (kills quickly, no chronic carriers)
    \item \textbf{Relevant for other diseases:} Tuberculosis, brucellosis (chronic infections)
\end{itemize}
\end{detail}

\subsection{Reemergence: Complete Definition}

\begin{keypoint}{What is Reemergence?}
\textbf{Operational Definition:}

A location (admin-2 unit) experiences \textit{reemergence} if disease returns after $\geq$2 years disease-free.

\textbf{Time-to-Event Outcome:}
\begin{itemize}
    \item Reemergence time = months from start of disease-free period until next outbreak
    \item Censored if no reemergence by end of study (2024)
\end{itemize}
\end{keypoint}

\begin{detail}{Why This Definition?}
\textbf{Component 1: $\geq$2 Years Disease-Free}

\textit{Why 2 years minimum?}
\begin{itemize}
    \item \textbf{Distinguishes from persistence:} <2 years = incomplete elimination (persistence). $\geq$2 years = likely cleared, then reintroduced.
    \item \textbf{Control policy:} EU ASF control zones maintained 1-2 years post-outbreak. Disease-free >2 years suggests successful control.
    \item \textbf{Biological:} ASF environmental survival ~1 year (carcasses, contaminated materials). >2 years suggests external reintroduction, not local persistence.
    \item \textbf{Literature:} "Disease-free period" typically defined as 1-3 years in TAD epidemiology.
\end{itemize}

\textit{Alternative thresholds:}
\begin{itemize}
    \item \textbf{1 year:} Less stringent, more reemergence events (higher power)
    \item \textbf{3 years:} More stringent, fewer events (lower power)
    \item \textbf{Decision:} Use 2 years for main analysis, test 1-year and 3-year in sensitivity
\end{itemize}

\textbf{Component 2: Disease Returns}

\textit{What counts as "return"?}
\begin{itemize}
    \item \textbf{Any outbreak:} After $\geq$2 years disease-free, next outbreak = reemergence
    \item \textbf{Regardless of size:} 1 animal or 100 animals, still counts (reintroduction occurred)
    \item \textbf{Same admin-2 unit:} Must be in same location (not neighboring area)
\end{itemize}

\textbf{Component 3: Mechanism}

\textit{What biological process does reemergence represent?}
\begin{itemize}
    \item \textbf{Reintroduction:} Virus brought from outside (contaminated vehicle, infected pig movement, wild boar migration)
    \item \textbf{Not:} Local persistence (would be <2 years)
    \item \textbf{Not:} Spread from neighbor (neighboring outbreak is transmission, not reemergence in original location)
    \item \textbf{Implication:} Reemergence risk factors may differ from persistence (focus on introduction pathways, not local elimination)
\end{itemize}
\end{detail}

\begin{detail}{Policy Relevance of Reemergence}
\textbf{Why Does Reemergence Matter?}

\textbf{1. Control Success Measurement:}
\begin{itemize}
    \item Areas that stay disease-free >2 years considered "controlled"
    \item Reemergence indicates control wasn't durable (external risk persists)
    \item Informs whether to maintain surveillance in "cleared" areas
\end{itemize}

\textbf{2. Resource Allocation:}
\begin{itemize}
    \item Should we reduce surveillance in disease-free areas? (Risky if reemergence likely)
    \item Which cleared areas need continued monitoring? (Those with high reemergence risk)
    \item When can we declare an area "safe"? (Low reemergence risk after 2+ years)
\end{itemize}

\textbf{3. Trade Implications:}
\begin{itemize}
    \item EU trade restrictions lifted after 2-3 years disease-free
    \item Reemergence forces re-imposition of restrictions (economic damage)
    \item Predicting reemergence risk informs trade policy (conditional clearance)
\end{itemize}

\textbf{4. Prevention Focus:}
\begin{itemize}
    \item Reemergence suggests external introduction pathways
    \item Targets biosecurity improvements: movement controls, vehicle disinfection, fencing
    \item Different interventions than persistence (which targets local elimination)
\end{itemize}
\end{detail}

\begin{methodology}{How Reemergence is Calculated: Code Example}
\textbf{Step-by-Step Calculation:}

\begin{lstlisting}
# Step 1: Identify disease-free periods (>=2 years without outbreak)
admin2_timeline <- outbreaks %>%
  arrange(admin2_code, outbreak_date) %>%
  group_by(admin2_code) %>%
  mutate(
    months_since_last = as.numeric(outbreak_date - lag(outbreak_date)) / 30.44,
    disease_free_period = months_since_last >= 24  # 2 years = 24 months
  )

# Step 2: Define reemergence events (outbreak after >=2 years disease-free)
reemergence_events <- admin2_timeline %>%
  filter(disease_free_period == TRUE) %>%
  mutate(
    reemergence_date = outbreak_date,
    disease_free_start = lag(outbreak_date),
    time_to_reemergence = months_since_last
  )

# Step 3: Create survival dataset
#   - Entry time: Start of disease-free period
#   - Event time: Reemergence outbreak (if occurred)
#   - Censoring: End of study (2024) if no reemergence
survival_data <- admin2_timeline %>%
  group_by(admin2_code) %>%
  summarise(
    last_outbreak = max(outbreak_date),
    study_end = as.Date("2024-12-31"),
    months_since_last = as.numeric(study_end - last_outbreak) / 30.44,
    reemergence = if_else(months_since_last >= 24 & n() >= 2, 1, 0),
    time = if_else(reemergence == 1,
                   months_since_last,  # Time to reemergence
                   months_since_last)  # Time to censoring
  )

# Step 4: Cox proportional hazards model
library(survival)
cox_model <- coxph(Surv(time, reemergence) ~
                     livestock_density +
                     tree_cover +
                     road_density,
                   data = survival_data)
\end{lstlisting}

\textbf{Example Output:}
\begin{lstlisting}
# admin2_code   last_outbreak   months_since   reemergence   time
# RO-AB-001     2020-06-15           42              1        42    # Reemergence after 42 months
# RO-AB-002     2019-03-10           68              0        68    # Censored (no reemergence)
# RO-AB-003     2022-11-20           14              0        14    # Too recent to assess
\end{lstlisting}
\end{methodology}

\subsection{Z-Scoring: Complete Definition and Justification}

\begin{keypoint}{What is Z-Scoring?}
\textbf{Operational Definition:}

Z-scoring (standardization) transforms predictors to have mean = 0 and standard deviation = 1.

\textbf{Formula:}
\[
z_i = \frac{x_i - \bar{x}}{s_x}
\]

Where:
\begin{itemize}
    \item $z_i$ = standardized value for observation $i$
    \item $x_i$ = original value for observation $i$
    \item $\bar{x}$ = mean of all observations
    \item $s_x$ = standard deviation of all observations
\end{itemize}
\end{keypoint}

\begin{detail}{Why Z-Score? Complete Justification}
\textbf{Problem Without Z-Scoring:}

Predictors have wildly different scales:
\begin{itemize}
    \item \textbf{Livestock density:} 0 - 50,000 pigs/km\textsuperscript{2} (scale: thousands)
    \item \textbf{Tree cover:} 0 - 100\% (scale: 0-100)
    \item \textbf{Road density:} 0 - 5 km/km\textsuperscript{2} (scale: 0-5)
    \item \textbf{GDP:} \$5,000 - \$30,000 per capita (scale: thousands)
\end{itemize}

\textbf{Consequence:}
\begin{itemize}
    \item Logistic regression coefficients reflect scale of predictor
    \item A coefficient of 0.0001 for livestock density (large scale) could have same effect size as 0.1 for tree cover (small scale)
    \item \textbf{Cannot compare} coefficients directly: "Which predictor is most important?"
    \item Optimization algorithms struggle with mixed scales (numerical instability)
\end{itemize}

\textbf{Solution: Z-Scoring}

After z-scoring:
\begin{itemize}
    \item All predictors have mean = 0, SD = 1 (same scale)
    \item Coefficients now comparable: "1 SD increase in X associated with $\beta$ change in log-odds"
    \item Can rank predictors by effect size (standardized coefficients)
    \item Improves model convergence (optimization easier)
\end{itemize}
\end{detail}

\begin{detail}{How Z-Scoring Changes Interpretation}
\textbf{Before Z-Scoring:}

\textbf{Model:} $\log(\text{odds}) = \beta_0 + \beta_1 \times \text{livestock\_density}$

\textbf{Coefficient:} $\beta_1 = 0.00005$

\textbf{Interpretation:} ``For each additional 1 pig/km\textsuperscript{2}, odds of persistence increase by 0.005\%.'' (Tiny effect, hard to communicate)

\textbf{After Z-Scoring:}

\textbf{Model:} $\log(\text{odds}) = \beta_0 + \beta_1 \times z_{\text{livestock\_density}}$

\textbf{Coefficient:} $\beta_1 = 0.65$

\textbf{Interpretation:} ``For each 1 SD increase in livestock density, odds of persistence increase by 92\% (OR = e\textsuperscript{0.65} = 1.92).'' (Meaningful, comparable)

\textbf{Key Point:}
\begin{itemize}
    \item Z-scoring changes scale, \textit{not} relationships
    \item Statistical significance unchanged
    \item Effect sizes now comparable across predictors
    \item Much easier to communicate to non-statisticians
\end{itemize}
\end{detail}

\begin{methodology}{Z-Scoring Code Example}
\begin{lstlisting}
# Example with actual numbers

# Original data (wide range of scales)
data <- data.frame(
  admin2_id = 1:5,
  livestock_density = c(100, 5000, 15000, 800, 25000),   # Scale: 0-50,000
  tree_cover = c(5, 30, 75, 20, 90),                     # Scale: 0-100
  road_density = c(0.1, 0.5, 2.3, 0.8, 4.1),             # Scale: 0-5
  persistence = c(0, 0, 1, 0, 1)
)

# Z-score transformation
data_zscore <- data %>%
  mutate(
    z_livestock = (livestock_density - mean(livestock_density)) / sd(livestock_density),
    z_tree = (tree_cover - mean(tree_cover)) / sd(tree_cover),
    z_road = (road_density - mean(road_density)) / sd(road_density)
  )

# Check: All z-scored variables have mean ≈ 0, SD ≈ 1
summary(data_zscore[, c("z_livestock", "z_tree", "z_road")])
#   z_livestock      z_tree          z_road
# Min.  :-1.23   Min.  :-1.45    Min.  :-1.34
# Mean  : 0.00   Mean  : 0.00    Mean  : 0.00   # All means = 0
# Max.  : 1.56   Max.  : 1.78    Max.  : 1.67
# SD    : 1.00   SD    : 1.00    SD    : 1.00   # All SDs = 1

# Logistic regression with original variables (hard to interpret)
model_original <- glm(persistence ~ livestock_density + tree_cover + road_density,
                      data = data, family = binomial)
summary(model_original)
# Coefficients:
#                      Estimate
# livestock_density    0.00008   # Tiny, can't compare to others
# tree_cover           0.05      # Moderate, but different scale
# road_density         1.2       # Large, but different scale

# Logistic regression with z-scored variables (easy to compare)
model_zscore <- glm(persistence ~ z_livestock + z_tree + z_road,
                    data = data_zscore, family = binomial)
summary(model_zscore)
# Coefficients:
#              Estimate
# z_livestock    0.67    # 1 SD increase → OR = e^0.67 = 1.95
# z_tree         0.45    # 1 SD increase → OR = e^0.45 = 1.57
# z_road         0.82    # 1 SD increase → OR = e^0.82 = 2.27

# NOW COMPARABLE: Road density has largest effect (0.82 > 0.67 > 0.45)
\end{lstlisting}
\end{methodology}

\begin{warning}{What Z-Scoring Does NOT Do}
\textbf{Misconceptions:}

\textbf{1. Does NOT Change Statistical Significance}
\begin{itemize}
    \item p-values identical before and after z-scoring
    \item Z-scoring is linear transformation (preserves relationships)
    \item If livestock density was significant (p<0.05) before, still significant after
\end{itemize}

\textbf{2. Does NOT Improve Model Performance}
\begin{itemize}
    \item AUC, accuracy, calibration unchanged
    \item Z-scoring doesn't add information (just rescales)
    \item Only benefit: Easier optimization, comparable coefficients
\end{itemize}

\textbf{3. Does NOT Make Non-Linear Relationships Linear}
\begin{itemize}
    \item If relationship is non-linear (e.g., quadratic), z-scoring doesn't fix it
    \item Still need polynomial terms, splines, etc. for non-linearity
\end{itemize}

\textbf{4. Does NOT Remove Outliers}
\begin{itemize}
    \item Outliers still outliers after z-scoring (now z-scores of $\pm$3 or more)
    \item May want to winsorize (cap extreme values) separately
\end{itemize}
\end{warning}

\subsection{Commune-Level Analysis: Spatial Scale Justification}

\begin{keypoint}{Why Admin-2 (Commune) Level?}
\textbf{Decision:} Use admin-2 (commune/county) as unit of analysis.

\textbf{Alternatives Considered:}
\begin{itemize}
    \item Farm-level (too fine, data unavailable)
    \item Grid cells (arbitrary, doesn't match policy)
    \item Admin-1 (province - too coarse)
    \item Admin-2 (commune - OPTIMAL)
\end{itemize}
\end{keypoint}

\begin{detail}{Why NOT Farm-Level?}
\textbf{Ideal but Impractical:}

\textbf{Advantages of Farm-Level:}
\begin{itemize}
    \item Most granular: Individual farms have unique characteristics
    \item Direct policy relevance: "This farm is high-risk"
    \item Avoids ecological fallacy (admin-2 associations may not hold at farm level)
    \item Large sample size (28,226 farms in Romania)
\end{itemize}

\textbf{Why We Can't Use Farm-Level:}
\begin{itemize}
    \item \textbf{Data unavailable:} WAHIS reports outbreaks at admin-2, not farm ID
    \item \textbf{Privacy:} Exact farm locations protected (GDPR in EU)
    \item \textbf{Backyard farms:} 1.2 million small holdings not in registry
    \item \textbf{Wild boar:} Many outbreaks in wildlife (no "farm")
    \item \textbf{Linkage:} Can't link WAHIS outbreaks to farm registry
\end{itemize}

\textbf{Mitigation:}
\begin{itemize}
    \item Some countries provide farm-level data (future work)
    \item For now, admin-2 best available compromise
\end{itemize}
\end{detail}

\begin{detail}{Why NOT Grid Cells?}
\textbf{Spatially Explicit but Arbitrary:}

\textbf{Advantages of Grid Cells:}
\begin{itemize}
    \item Uniform size (5km × 5km grids)
    \item Matches remote sensing data (MODIS, GLW)
    \item Avoids modifiable areal unit problem (MAUP) to some extent
    \item Spatially continuous (smooth risk maps)
\end{itemize}

\textbf{Why We Don't Use Grid Cells:}
\begin{itemize}
    \item \textbf{Outbreak location:} WAHIS reports at admin-2, not coordinates
    \item \textbf{Can't assign:} Don't know which grid cell outbreak occurred in
    \item \textbf{Policy mismatch:} Control measures implemented at admin-2 (movement restrictions, surveillance zones)
    \item \textbf{Arbitrary:} Grid boundaries don't reflect epidemiological units
\end{itemize}

\textbf{When Grid Cells Make Sense:}
\begin{itemize}
    \item If you have exact outbreak coordinates (GPS)
    \item For purely spatial prediction (not policy-linked)
    \item For environmental niche modeling (MaxEnt, etc.)
\end{itemize}
\end{detail}

\begin{detail}{Why NOT Admin-1 (Province)?}
\textbf{Too Coarse:}

\textbf{Romania Admin Levels:}
\begin{itemize}
    \item \textbf{Admin-0:} Country (1 unit)
    \item \textbf{Admin-1:} County (42 units)
    \item \textbf{Admin-2:} Commune (3,181 units)
\end{itemize}

\textbf{Why Admin-1 Insufficient:}
\begin{itemize}
    \item \textbf{Too few units:} Only 42 counties (low power)
    \item \textbf{High heterogeneity:} Counties vary widely internally (urban vs rural, mountains vs plains)
    \item \textbf{Loses spatial variation:} Most counties have outbreaks (limited contrast)
    \item \textbf{Policy too coarse:} Movement restrictions at county level affect entire region (inefficient)
\end{itemize}

\textbf{When Admin-1 Makes Sense:}
\begin{itemize}
    \item National-level analysis (comparing provinces across country)
    \item Data only available at admin-1 (e.g., GDP, veterinary capacity)
    \item Very large countries where admin-2 would be thousands of units
\end{itemize}
\end{detail}

\begin{detail}{Why Admin-2 (Commune) is Optimal}
\textbf{Best Balance:}

\textbf{1. Data Availability:}
\begin{itemize}
    \item WAHIS reports outbreaks at admin-2 (commune name provided)
    \item Can link to spatial boundaries (GADM database)
    \item Predictors available at admin-2 (GLW, MODIS aggregated to commune)
\end{itemize}

\textbf{2. Spatial Resolution:}
\begin{itemize}
    \item 3,181 communes in Romania (large sample)
    \item Median commune size: ~50 km\textsuperscript{2} (meaningful spatial variation)
    \item Fine enough to capture risk heterogeneity
    \item Coarse enough to aggregate environmental data without excessive noise
\end{itemize}

\textbf{3. Policy Relevance:}
\begin{itemize}
    \item \textbf{Surveillance:} Veterinary inspections organized by commune
    \item \textbf{Control zones:} Movement restrictions often commune-based
    \item \textbf{Risk communication:} Farmers understand commune boundaries
    \item \textbf{Implementation:} Local veterinary offices operate at commune level
\end{itemize}

\textbf{4. Epidemiological Meaning:}
\begin{itemize}
    \item Communes represent coherent agricultural areas
    \item Farm-to-farm transmission likely within commune (shared resources, roads)
    \item Between-commune transmission less frequent (physical distance, administrative barriers)
    \item Approximates "local epidemic unit"
\end{itemize}
\end{detail}

\begin{warning}{Ecological Fallacy}
\textbf{Risk:} Associations at admin-2 level may not hold at farm level.

\textbf{Example:}
\begin{itemize}
    \item Finding: "Communes with high livestock density have higher persistence risk"
    \item \textbf{Does NOT imply:} "Every farm in high-density commune has higher risk"
    \item \textbf{Farm-level variation:} Within-commune heterogeneity (biosecurity, management)
\end{itemize}

\textbf{Mitigation:}
\begin{itemize}
    \item Interpret findings as commune-level risk (population-level)
    \item Acknowledge limitation in discussion
    \item Frame recommendations at commune level ("Enhanced surveillance in commune X")
    \item Future work: If farm-level data becomes available, validate findings
\end{itemize}
\end{warning}

