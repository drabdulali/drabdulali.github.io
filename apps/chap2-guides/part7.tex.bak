\subsection{Top 5 Risk Factors - Detailed Interpretation}

\begin{keypoint}{Top 5 Predictors (OR $>$ 1)}
\textbf{1. mean\_susceptible\_per\_outbreak (OR = 1.95)}
\begin{itemize}
\item \textbf{Meaning:} Average susceptible population per outbreak in commune
\item \textbf{Interpretation:} 1 SD increase → 95\% higher odds of persistence
\item \textbf{Why?} Larger outbreaks have more infected animals, harder to control
\item \textbf{Biological mechanism:} More susceptibles → longer epidemic duration → higher chance of spillback/reintroduction
\item \textbf{Policy:} Prioritize rapid response in communes with large farm sizes
\end{itemize}

\textbf{2. crop\_diversity\_shannon (OR = 1.53)}
\begin{itemize}
\item \textbf{Meaning:} Shannon diversity index of crop types
\item \textbf{Interpretation:} 1 SD increase → 53\% higher odds of persistence
\item \textbf{Why?} Diverse landscapes attract wild boar (more food sources)
\item \textbf{Biological mechanism:} Agricultural heterogeneity → wild boar habitat suitability → spillover risk
\item \textbf{Policy:} Enhanced surveillance in diverse agricultural areas
\end{itemize}

\textbf{3. feed\_crops\_pct (OR = 1.44)}
\begin{itemize}
\item \textbf{Meaning:} Percentage of area for feed crops (maize, soybean, barley)
\item \textbf{Interpretation:} 1 SD increase → 44\% higher odds of persistence
\item \textbf{Why?} Feed crops attract wild boar, increase pig-wildlife interface
\item \textbf{Biological mechanism:} Wild boar foraging → contaminated environment → spillover to pigs
\item \textbf{Policy:} Biosecurity around feed crop areas, early harvest strategies
\end{itemize}

\textbf{4. wildlife\_outbreak\_pct (OR = 1.30)}
\begin{itemize}
\item \textbf{Meaning:} Percentage of outbreaks from wildlife origin
\item \textbf{Interpretation:} 1 SD increase → 30\% higher odds of persistence
\item \textbf{Why?} Wildlife reservoir → continuous reintroduction risk
\item \textbf{Biological mechanism:} Wild boar populations sustain virus → spillover to domestic pigs
\item \textbf{Policy:} Wild boar management critical in high wildlife-origin areas
\end{itemize}

\textbf{5. road\_density\_km\_per\_km2 (OR = 1.24)}
\begin{itemize}
\item \textbf{Meaning:} Total road length per km² (infrastructure proxy)
\item \textbf{Interpretation:} 1 SD increase → 24\% higher odds of persistence
\item \textbf{Why?} Roads facilitate human/animal movement, virus spread
\item \textbf{Biological mechanism:} Transport → contaminated vehicles → between-farm transmission
\item \textbf{Policy:} Enhanced biosecurity at farms near major roads, vehicle disinfection
\end{itemize}
\end{keypoint}

\subsection{The One Protective Factor}

\begin{result}{Protective Factor: pig\_density\_sd (OR = 0.73)}
\textbf{Variable:} Standard deviation of pig density (spatial heterogeneity)

\textbf{Interpretation:} 1 SD increase in pig density heterogeneity → 27\% lower odds of persistence

\textbf{Why is this protective?}
\begin{enumerate}
\item \textbf{Hypothesis 1 - Dilution effect:}
  \begin{itemize}
  \item Heterogeneous landscapes have both high-density (risky) and low-density (safe) areas
  \item Averaging dilutes the transmission potential
  \item Virus may "burn out" in low-density patches
  \end{itemize}

\item \textbf{Hypothesis 2 - Network disconnection:}
  \begin{itemize}
  \item Uneven density → fewer contact opportunities between farms
  \item Spatial gaps reduce transmission networks
  \item Harder for disease to spread continuously
  \end{itemize}

\item \textbf{Hypothesis 3 - Resource allocation:}
  \begin{itemize}
  \item Heterogeneous areas easier to prioritize for control
  \item Control efforts concentrate on high-density clusters
  \item More efficient resource use
  \end{itemize}
\end{enumerate}

\textbf{Contrast with hypothesis:}
\begin{itemize}
\item We hypothesized heterogeneity would \textit{increase} risk (hotspots)
\item Results show \textit{opposite} effect
\item This is a novel finding requiring further investigation
\end{itemize}

\textbf{Policy implication:}
\begin{itemize}
\item Uniform high-density areas are riskier than heterogeneous ones
\item Consider spatial pig distribution in risk assessments
\item Landscape structure matters beyond absolute density
\end{itemize}
\end{result}

