% ============================================================================
\section{Understanding Odds Ratios (OR)}
% ============================================================================

\subsection{What Is an Odds Ratio?}

\begin{keypoint}{Odds Ratio Definition}
An \textbf{Odds Ratio (OR)} quantifies the multiplicative change in odds of the outcome for a one-unit increase in the predictor.

\textbf{Formula:}
\begin{equation}
\text{OR} = e^{\beta}
\end{equation}

Where $\beta$ is the logistic regression coefficient.

\textbf{For z-scored predictors (mean = 0, SD = 1):}
\begin{itemize}
\item OR = odds change for \textbf{1 standard deviation} increase
\item This makes ORs comparable across variables
\end{itemize}
\end{keypoint}

\subsection{Interpreting Odds Ratios}

\begin{methodology}{How to Interpret OR Values}
\textbf{OR = 1.0:} No effect (predictor doesn't influence outcome)

\textbf{OR $>$ 1.0:} Increased odds (risk factor)
\begin{itemize}
\item OR = 1.5 → 50\% increase in odds
\item OR = 2.0 → 100\% increase (doubling of odds)
\item OR = 3.0 → 200\% increase (tripling of odds)
\end{itemize}

\textbf{OR $<$ 1.0:} Decreased odds (protective factor)
\begin{itemize}
\item OR = 0.5 → 50\% decrease in odds (half the odds)
\item OR = 0.25 → 75\% decrease in odds (quarter of the odds)
\end{itemize}

\textbf{Calculating percent change:}
\begin{equation}
\text{Percent change} = (\text{OR} - 1) \times 100\%
\end{equation}

\textbf{Examples:}
\begin{itemize}
\item OR = 1.95 → $(1.95 - 1) \times 100\% = 95\%$ increase
\item OR = 0.73 → $(0.73 - 1) \times 100\% = -27\%$ decrease
\end{itemize}
\end{methodology}

\begin{detail}{Odds vs Probability vs Risk}
\textbf{Don't confuse these three concepts:}

\textbf{Probability (Risk):}
\begin{itemize}
\item $P = \frac{\text{Events}}{\text{Total}}$
\item Example: 50 out of 100 communes → P = 0.50 (50\%)
\item Range: 0 to 1
\end{itemize}

\textbf{Odds:}
\begin{itemize}
\item $\text{Odds} = \frac{P}{1-P} = \frac{\text{Events}}{\text{Non-events}}$
\item Example: 50 events, 50 non-events → Odds = 1.0
\item Range: 0 to $\infty$
\end{itemize}

\textbf{Odds Ratio:}
\begin{itemize}
\item Ratio of two odds
\item Compares odds at different predictor levels
\end{itemize}

\textbf{When are OR $\approx$ RR (Risk Ratio)?}
\begin{itemize}
\item When outcome is rare ($<$ 10\%)
\item Our outcome is 50\% → ORs overestimate RRs
\item Be careful interpreting ORs as risks when outcome is common!
\end{itemize}
\end{detail}

\begin{warning}{Common Misinterpretations of Odds Ratios}
\textbf{WRONG:} "OR = 1.95 means 95\% increase in \textit{risk}"
\begin{itemize}
\item Correct: 95\% increase in \textit{odds}, not risk
\item Risk ratio $\neq$ odds ratio when outcome is common
\end{itemize}

\textbf{WRONG:} "OR = 2.0 means twice as likely"
\begin{itemize}
\item Correct: Twice the \textit{odds}, not twice the probability
\item If baseline probability = 0.5, doubled odds → probability = 0.67 (not 1.0!)
\end{itemize}

\textbf{WRONG:} "OR = 1.5 with p = 0.03 proves causation"
\begin{itemize}
\item Correlation $\neq$ causation
\item OR shows association, not mechanism
\end{itemize}

\textbf{RIGHT:} "A 1 SD increase in feed crops is associated with 44\% higher odds of ASF persistence (OR = 1.44, 95\% CI [1.28-1.63])."
\end{warning}

