% ============================================================================
\section{Key Messages for Communication}
% ============================================================================

\begin{keypoint}{Elevator Pitch - Results in 3 Sentences}
\textbf{For general audience:}

"We identified 19 risk factors for African swine fever persistence in Romanian communes. The strongest predictors were historical outbreak patterns (past predicts future) and agricultural landscape features like crop diversity and feed crops. Surprisingly, areas with more variable pig density had lower risk, suggesting landscape structure matters beyond total numbers."

\textbf{For scientific audience:}

"The elastic net model (AUC=0.783, EPV=404) identified mean susceptible population per outbreak (OR=1.95) as the strongest predictor of ASF persistence, followed by crop diversity (OR=1.53) and feed crop percentage (OR=1.44). Outbreak history variables alone achieved AUC=0.744, highlighting the predictive power of WAHIS data. Pig density heterogeneity emerged as protective (OR=0.73), contrary to our hypothesis."

\textbf{For policymakers:}

"To prevent long-term ASF circulation, focus surveillance on areas with: (1) history of large outbreaks, (2) diverse agricultural landscapes that attract wild boar, and (3) high road density facilitating movement. Enhanced biosecurity around feed crop areas and early detection in wildlife are critical."
\end{keypoint}

