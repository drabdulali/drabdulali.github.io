\section{Domain Comparison}
% ============================================================================

\subsection{Which Domain Matters Most?}

\begin{methodology}{Comparing Effect Sizes Across Domains}
To compare domains, we can:
\begin{enumerate}
\item \textbf{Count variables:} How many from each domain selected?
\item \textbf{Average OR:} Mean odds ratio per domain
\item \textbf{Strongest predictor:} Which domain has highest OR?
\item \textbf{Model performance:} AUC of domain-specific models
\end{enumerate}
\end{methodology}

\begin{result}{Domain Comparison Results}
\begin{table}[H]
\centering
\begin{tabular}{lrrrl}
\toprule
\textbf{Domain} & \textbf{Vars in Model} & \textbf{Mean OR} & \textbf{Max OR} & \textbf{Domain Model AUC} \\
\midrule
Outbreak History & 4 & 1.36 & 1.95 & 0.744 \\
Agriculture & 3 & 1.39 & 1.53 & 0.682 \\
Livestock & 3 & 0.93 & 1.04 & 0.651 \\
Landscape & 4 & 1.12 & 1.21 & 0.634 \\
Infrastructure & 1 & 1.24 & 1.24 & 0.612 \\
Wildlife & 1 & 1.18 & 1.18 & 0.598 \\
Environment & 2 & 1.12 & 1.16 & 0.587 \\
\bottomrule
\end{tabular}
\caption{Domain importance comparison}
\end{table}

\textbf{Key insights:}
\begin{enumerate}
\item \textbf{Outbreak History dominates:}
  \begin{itemize}
  \item Highest mean OR (1.36)
  \item Strongest single predictor (OR = 1.95)
  \item Best domain-specific model (AUC = 0.744)
  \item Only 4 variables achieve excellent performance!
  \end{itemize}

\item \textbf{Agriculture is second:}
  \begin{itemize}
  \item High mean OR (1.39)
  \item Multiple important variables (crop diversity, feed crops, maize)
  \item Modifiable through policy
  \end{itemize}

\item \textbf{Livestock surprisingly weak:}
  \begin{itemize}
  \item Only protective factor (pig density SD)
  \item Low mean OR (0.93)
  \item Poorest performing domain model
  \end{itemize}

\item \textbf{Wildlife, Environment, Landscape moderate:}
  \begin{itemize}
  \item Each contributes 1-4 variables
  \item ORs in 1.08-1.21 range (modest effects)
  \item Individually weak, collectively important
  \end{itemize}
\end{enumerate}
\end{result}

\begin{keypoint}{The Power of Outbreak History Data}
\textbf{Most striking finding:} Historical outbreak data alone achieves AUC = 0.744!

\textbf{What this means:}
\begin{itemize}
\item Past outbreak patterns strongly predict persistence
\item WAHIS data is extremely valuable for surveillance
\item Even without environmental covariates, we can identify high-risk areas
\item Suggests path-dependent dynamics (history matters)
\end{itemize}

\textbf{Policy implication:}
\begin{itemize}
\item Countries should prioritize detailed outbreak reporting
\item Historical data should inform current surveillance
\item Areas with large/frequent/wildlife-origin outbreaks need enhanced monitoring
\end{itemize}
\end{keypoint}

% ============================================================================
\section{Univariate vs Multivariate Changes}
% ============================================================================

\subsection{Why Coefficients Change}

\begin{detail}{Why ORs Differ Between Univariate and Multivariate Models}
\textbf{Univariate (simple) model:}
\begin{equation}
\log(\text{odds}) = \beta_0 + \beta_1 X_1
\end{equation}
\begin{itemize}
\item $\beta_1$ captures \textit{total association} (direct + indirect via other variables)
\end{itemize}

\textbf{Multivariate (adjusted) model:}
\begin{equation}
\log(\text{odds}) = \beta_0 + \beta_1 X_1 + \beta_2 X_2 + \cdots + \beta_p X_p
\end{equation}
\begin{itemize}
\item $\beta_1$ captures \textit{independent association} (controlling for other variables)
\end{itemize}

\textbf{Reasons for changes:}
\begin{enumerate}
\item \textbf{Confounding:} Variables correlated with both predictor and outcome
\item \textbf{Mediation:} Effect works through intermediate variable
\item \textbf{Suppression:} Variable's effect masked in univariate, revealed in multivariate
\item \textbf{Multicollinearity:} Correlated predictors "share" variance
\end{enumerate}
\end{detail}

\subsection{Examples from Our Data}

\begin{result}{Coefficient Changes: Univariate → Multivariate}
\begin{table}[H]
\centering
\small
\begin{tabular}{lrrrl}
\toprule
\textbf{Variable} & \textbf{Univariate OR} & \textbf{Multivariate OR} & \textbf{Change} & \textbf{Interpretation} \\
\midrule
\multicolumn{5}{l}{\textit{Effect increased (suppression)}} \\
pig\_density\_sd & 0.89 & 0.73 & Stronger & More protective after adjustment \\
\midrule
\multicolumn{5}{l}{\textit{Effect decreased (confounding)}} \\
crop\_diversity & 1.78 & 1.53 & Weaker & Some effect via correlated vars \\
feed\_crops\_pct & 1.62 & 1.44 & Weaker & Overlap with maize, wheat \\
road\_density & 1.45 & 1.24 & Weaker & Correlates with urbanization \\
\midrule
\multicolumn{5}{l}{\textit{Effect stable (robust)}} \\
mean\_susceptible & 1.91 & 1.95 & Stable & Independent effect \\
wildlife\_outbreak & 1.34 & 1.30 & Stable & Direct mechanism \\
wild\_boar\_density & 1.21 & 1.18 & Stable & True wildlife effect \\
\midrule
\multicolumn{5}{l}{\textit{Lost significance (confounded)}} \\
precipitation\_bio12 & 1.23* & 1.07 & NS & Effect via temp/elevation \\
cattle\_density & 1.18* & 1.02 & NS & Spurious (geography) \\
\bottomrule
\end{tabular}
\caption{Changes in odds ratios from univariate to multivariate models (* = p < 0.05 in univariate only; NS = not significant in multivariate)}
\end{table}
\end{result}

\begin{methodology}{Interpreting Coefficient Changes}
\textbf{If multivariate OR $<$ univariate OR (effect weakens):}
\begin{itemize}
\item \textbf{Confounding:} Part of univariate effect was due to correlation with other risk factors
\item \textbf{Example:} \texttt{crop\_diversity\_shannon} OR drops from 1.78 to 1.53
  \begin{itemize}
  \item Diverse areas also have more feed crops (confounded)
  \item After controlling for feed crops, diversity effect weaker but still significant
  \end{itemize}
\end{itemize}

\textbf{If multivariate OR $>$ univariate OR (effect strengthens):}
\begin{itemize}
\item \textbf{Suppression:} Correlated variables were masking true effect
\item \textbf{Example:} \texttt{pig\_density\_sd} OR drops from 0.89 to 0.73 (more protective)
  \begin{itemize}
  \item Heterogeneity areas also have high mean density (risky)
  \item After controlling for mean density, protective effect revealed
  \end{itemize}
\end{itemize}

\textbf{If multivariate OR $\approx$ univariate OR (stable):}
\begin{itemize}
\item \textbf{Independent effect:} Not confounded by other variables
\item \textbf{Example:} \texttt{mean\_susceptible\_per\_outbreak} remains OR $\approx$ 1.9
  \begin{itemize}
  \item Effect is direct and robust
  \item Doesn't depend on adjustment for other factors
  \end{itemize}
\end{itemize}

\textbf{If significant in univariate but NOT in multivariate:}
\begin{itemize}
\item \textbf{Spurious association:} Effect was confounded
\item \textbf{Example:} \texttt{precipitation\_bio12} loses significance
  \begin{itemize}
  \item Precipitation correlates with elevation, temperature
  \item No independent effect after controlling for these
  \end{itemize}
\end{itemize}
\end{methodology}

% ============================================================================
\section{Effect Size Interpretation}
% ============================================================================

\subsection{Translating ORs to Real-World Impact}

\begin{keypoint}{From OR to Practical Meaning}
\textbf{Question:} How much does persistence \textit{actually} increase?

\textbf{Example calculation for feed\_crops\_pct (OR = 1.44):}

\textbf{Scenario:} Compare commune at 25th percentile vs 75th percentile of feed crop percentage

\textbf{Step 1:} Calculate z-score difference
\begin{itemize}
\item 25th percentile: z = -0.674 SD
\item 75th percentile: z = +0.674 SD
\item Difference: 1.348 SD
\end{itemize}

\textbf{Step 2:} Calculate OR for this difference
\begin{equation}
\text{OR}_{25 \to 75} = 1.44^{1.348} = 1.69
\end{equation}

\textbf{Step 3:} Convert to probability change
\begin{itemize}
\item Baseline (25th pctl): Assume 40\% persistence probability
  \begin{itemize}
  \item Baseline odds = $\frac{0.40}{1-0.40} = 0.67$
  \end{itemize}
\item After increase (75th pctl):
  \begin{itemize}
  \item New odds = $0.67 \times 1.69 = 1.13$
  \item New probability = $\frac{1.13}{1+1.13} = 0.53$ (53\%)
  \end{itemize}
\end{itemize}

\textbf{Interpretation:} Moving from low (25th) to high (75th) feed crop coverage increases persistence probability from 40\% to 53\% (a 13 percentage point increase).
\end{keypoint}

\begin{detail}{Example Calculations for Top 3 Predictors}
\textbf{Using interquartile range (IQR) = 1.348 SD:}

\begin{table}[H]
\centering
\begin{tabular}{lrrr}
\toprule
\textbf{Variable} & \textbf{OR (per SD)} & \textbf{OR (IQR)} & \textbf{$\Delta$ Probability} \\
\midrule
mean\_susceptible\_per\_outbreak & 1.95 & 2.88 & 40\% → 60\% (+20 pp) \\
crop\_diversity\_shannon & 1.53 & 1.84 & 40\% → 52\% (+12 pp) \\
feed\_crops\_pct & 1.44 & 1.69 & 40\% → 53\% (+13 pp) \\
\bottomrule
\end{tabular}
\caption{Translating ORs to probability changes (assuming 40\% baseline probability; pp = percentage points)}
\end{table}

\textbf{Interpretation:}
\begin{itemize}
\item Moving from low to high susceptible population: +20 percentage points risk
\item Moving from low to high crop diversity: +12 percentage points risk
\item Moving from low to high feed crops: +13 percentage points risk
\end{itemize}

\textbf{Policy relevance:} These are substantial, actionable differences!
\end{detail}

\subsection{Combining Multiple Risk Factors}

\begin{warning}{Multiplicative Effects}
Logistic regression assumes \textbf{multiplicative} (not additive) effects on the odds scale.

\textbf{Example:} Commune with BOTH high crop diversity AND high feed crops:
\begin{itemize}
\item Effect of crop diversity: OR = 1.53
\item Effect of feed crops: OR = 1.44
\item \textbf{Combined effect:} OR = $1.53 \times 1.44 = 2.20$ (not 1.53 + 1.44 = 2.97!)
\end{itemize}

\textbf{Risk stratification:}
\begin{table}[H]
\centering
\small
\begin{tabular}{lrrl}
\toprule
\textbf{Risk Profile} & \textbf{Combined OR} & \textbf{Probability} & \textbf{Risk Category} \\
\midrule
Baseline (all low) & 1.00 & 40\% & Moderate \\
High crop diversity only & 1.53 & 48\% & Elevated \\
High feed crops only & 1.44 & 47\% & Elevated \\
High crop diversity + feed crops & 2.20 & 59\% & High \\
+ High susceptible outbreaks & 4.29 & 78\% & Very High \\
\bottomrule
\end{tabular}
\caption{Cumulative risk with multiple factors (baseline = 40\% probability)}
\end{table}

\textbf{Policy implication:} Communes with multiple risk factors require prioritized surveillance (probability $>$ 70\%).
\end{warning}

