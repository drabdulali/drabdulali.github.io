\section{10-Fold Cross-Validation}
% ============================================================================

\subsection{What is K-Fold Cross-Validation?}

\begin{methodology}{K-Fold Cross-Validation Explained}
\textbf{Core Concept:} Split data into $k$ equal-sized subsets (folds). Train model on $k-1$ folds, test on the remaining fold. Repeat $k$ times, using each fold once as test set. Average performance across all $k$ folds.

\textbf{Why ``Cross''?} Each data point is used for both training and testing (in different iterations), maximizing data efficiency.

\textbf{Formal Procedure:}
\begin{enumerate}
    \item Randomly partition data into $k$ equal-sized folds: $F_1, F_2, \ldots, F_k$
    \item For fold $i = 1, \ldots, k$:
    \begin{itemize}
        \item Train model on all folds except $F_i$ (training set: $\bigcup_{j \neq i} F_j$)
        \item Test model on $F_i$ (test set)
        \item Calculate performance metric (e.g., AUC) on $F_i$: $\text{Performance}_i$
    \end{itemize}
    \item Calculate mean performance: $\overline{\text{Performance}} = \frac{1}{k} \sum_{i=1}^{k} \text{Performance}_i$
    \item Calculate standard deviation: $\sigma_{\text{Performance}} = \sqrt{\frac{1}{k-1} \sum_{i=1}^{k} (\text{Performance}_i - \overline{\text{Performance}})^2}$
\end{enumerate}

\textbf{Result:} Mean $\pm$ SD performance, representing both expected performance and variability.
\end{methodology}

\subsection{Why 10 Folds? (Not 5 or 20?)}

\begin{detail}{Choosing K: Bias-Variance Trade-Off}
The choice of $k$ involves a trade-off between bias and variance of the performance estimate:

\textbf{Small K (e.g., k=5):}
\begin{itemize}
    \item \textbf{Training set:} 80\% of data (larger)
    \item \textbf{Test set:} 20\% of data (smaller)
    \item \textbf{Bias:} High bias (training set smaller than full data)
    \item \textbf{Variance:} High variance (fewer folds, less averaging)
    \item \textbf{Computational:} Faster (fewer iterations)
\end{itemize}

\textbf{Large K (e.g., k=20 or LOOCV):}
\begin{itemize}
    \item \textbf{Training set:} 95\%+ of data (nearly full data)
    \item \textbf{Test set:} 5\% or 1 observation (tiny)
    \item \textbf{Bias:} Low bias (training set nearly identical to full data)
    \item \textbf{Variance:} High variance (training sets highly overlapping)
    \item \textbf{Computational:} Slower (many iterations)
\end{itemize}

\textbf{K=10 (Standard Choice):}
\begin{itemize}
    \item \textbf{Training set:} 90\% of data
    \item \textbf{Test set:} 10\% of data
    \item \textbf{Bias:} Moderate (training set reasonably represents full data)
    \item \textbf{Variance:} Moderate (10 folds provide good averaging)
    \item \textbf{Computational:} Reasonable (10 iterations)
    \item \textbf{Empirical:} Extensive simulations show k=10 optimal for most datasets
\end{itemize}

\textbf{Our Choice:} k=10 provides the best balance for our dataset (1,976 outbreaks). Each fold has $\sim$198 observations, sufficient for stable AUC estimation.
\end{detail}

\subsection{Stratified Cross-Validation}

\begin{methodology}{Why Stratification?}
\textbf{Problem:} Random fold assignment might create unbalanced folds. If ASF occurrence is 40\% overall, random assignment could produce folds with 30\% or 50\% occurrence, leading to biased performance estimates.

\textbf{Solution:} \textit{Stratified} K-fold ensures each fold has approximately the same outcome distribution as the full dataset.

\textbf{Procedure:}
\begin{enumerate}
    \item Calculate overall outcome proportions (e.g., 40\% ASF, 60\% no ASF)
    \item Within each outcome class, randomly assign observations to folds
    \item Each fold maintains $\sim$40\% ASF, $\sim$60\% no ASF
\end{enumerate}

\textbf{Benefit:} Reduces variance in performance estimates by ensuring consistent difficulty across folds.
\end{methodology}

\subsection{Detailed Implementation}

\subsubsection{Step-by-Step Procedure}

\begin{enumerate}
    \item \textbf{Create stratified folds:} Use \texttt{createFolds()} from \texttt{caret} package
    \item \textbf{For each fold:}
    \begin{itemize}
        \item Extract training data (9 folds) and test data (1 fold)
        \item Fit model on training data
        \item Predict on test data
        \item Calculate AUC for test fold
    \end{itemize}
    \item \textbf{Aggregate results:} Calculate mean AUC and standard deviation across 10 folds
    \item \textbf{Interpret:} Mean AUC = expected performance; SD = performance stability
\end{enumerate}

\subsubsection{Complete R Implementation}

\begin{lstlisting}[language=R, caption=10-Fold Cross-Validation Implementation]
# =============================================================================
# 10-Fold Stratified Cross-Validation for All Models
# =============================================================================

library(caret)
library(pROC)
library(dplyr)

# Load analysis data
analysis_data <- readRDS("data/processed/romania_asf_analysis_data.rds")

# Set seed for reproducibility
set.seed(42)

# Create 10 stratified folds
# Stratification ensures each fold has similar outcome distribution
folds <- createFolds(
  y = analysis_data$asf_occurrence,
  k = 10,
  list = TRUE,
  returnTrain = FALSE  # Returns test indices
)

# Check fold balance
cat("Fold sizes and outcome proportions:\n")
for (i in 1:10) {
  fold_data <- analysis_data[folds[[i]], ]
  n <- nrow(fold_data)
  prop_asf <- mean(fold_data$asf_occurrence)
  cat(sprintf("  Fold %2d: n=%4d, ASF=%.3f\n", i, n, prop_asf))
}

# Function to perform CV for a given model formula
cv_model <- function(formula, data, folds) {

  fold_aucs <- numeric(length(folds))

  for (i in 1:length(folds)) {
    # Split data
    test_indices <- folds[[i]]
    train_data <- data[-test_indices, ]
    test_data <- data[test_indices, ]

    # Fit model on training data
    model <- glm(formula, data = train_data, family = binomial)

    # Predict on test data
    pred_probs <- predict(model, newdata = test_data, type = "response")

    # Calculate AUC for this fold
    roc_obj <- roc(test_data$asf_occurrence, pred_probs, quiet = TRUE)
    fold_aucs[i] <- as.numeric(auc(roc_obj))

    cat(sprintf("Fold %2d: AUC = %.3f\n", i, fold_aucs[i]))
  }

  # Return mean and SD
  list(
    fold_aucs = fold_aucs,
    mean_auc = mean(fold_aucs),
    sd_auc = sd(fold_aucs),
    cv_auc = sprintf("%.3f ± %.3f", mean(fold_aucs), sd(fold_aucs))
  )
}

