\section{70/30 Split-Sample Validation}
% ============================================================================

\subsection{Why 70/30 Split? (vs 80/20 or 60/40)}

\begin{methodology}{Choosing Training/Test Split Ratios}
\textbf{Common splits:} 60/40, 70/30, 80/20

\textbf{Trade-off:}
\begin{itemize}
    \item \textbf{More training data (e.g., 80/20):} Model has more data to learn patterns, potentially better fit
    \item \textbf{More test data (e.g., 60/40):} Test set more representative, lower variance in performance estimate
\end{itemize}

\textbf{70/30 Rationale:}
\begin{itemize}
    \item \textbf{Training (70\%):} 1,383 observations---sufficient for stable estimation with 11-19 predictors
    \item \textbf{Test (30\%):} 593 observations---large enough for reliable AUC estimation (AUC SE $\approx$ 0.02)
    \item \textbf{Standard:} Most widely used split in epidemiology literature
    \item \textbf{Balance:} Good compromise between maximizing training data and ensuring robust test evaluation
\end{itemize}

\textbf{When to use different splits:}
\begin{itemize}
    \item \textbf{80/20:} When data is very limited (< 500 observations) and need maximum training data
    \item \textbf{60/40:} When test set representativeness is critical (e.g., highly heterogeneous data)
    \item \textbf{50/50:} When sample size is very large and both sets can be adequately powered
\end{itemize}
\end{methodology}

\subsection{Stratified Splitting Procedure}

\begin{methodology}{Why Stratification Matters for Train-Test Split}
\textbf{Problem:} Random 70/30 split might produce imbalanced outcome distributions.

\textbf{Example without stratification:}
\begin{itemize}
    \item Full data: 40\% ASF positive
    \item Random split could produce:
    \begin{itemize}
        \item Training: 35\% ASF positive (fewer events for model to learn)
        \item Test: 50\% ASF positive (different prevalence, biased evaluation)
    \end{itemize}
\end{itemize}

\textbf{Solution: Stratified splitting}
\begin{itemize}
    \item Within ASF-positive cases: Randomly assign 70\% to training, 30\% to test
    \item Within ASF-negative cases: Randomly assign 70\% to training, 30\% to test
    \item Result: Both sets have $\sim$40\% ASF positive
\end{itemize}

\textbf{Benefit:} Training set representative of full data; test set has same prevalence (unbiased evaluation)
\end{methodology}

\subsection{Implementation: Complete Code}

\begin{lstlisting}[language=R, caption=70/30 Stratified Train-Test Split Validation]
# =============================================================================
# 70/30 Split-Sample Validation for All Models
# =============================================================================

library(caret)
library(pROC)
library(dplyr)

# Load data
analysis_data <- readRDS("data/processed/romania_asf_analysis_data.rds")

# Set seed
set.seed(123)

# Create stratified 70/30 split
train_indices <- createDataPartition(
  y = analysis_data$asf_occurrence,
  p = 0.70,              # 70% for training
  list = FALSE,
  times = 1
)

train_data <- analysis_data[train_indices, ]
test_data <- analysis_data[-train_indices, ]

# Check split characteristics
cat("\n=== Training/Test Split Summary ===\n")
cat(sprintf("Full data:     n=%d, ASF positive=%d (%.1f%%)\n",
           nrow(analysis_data),
           sum(analysis_data$asf_occurrence),
           100 * mean(analysis_data$asf_occurrence)))

cat(sprintf("Training set:  n=%d, ASF positive=%d (%.1f%%)\n",
           nrow(train_data),
           sum(train_data$asf_occurrence),
           100 * mean(train_data$asf_occurrence)))

cat(sprintf("Test set:      n=%d, ASF positive=%d (%.1f%%)\n",
           nrow(test_data),
           sum(test_data$asf_occurrence),
           100 * mean(test_data$asf_occurrence)))

# Function to fit on training, test on held-out test set
train_test_model <- function(formula, train_data, test_data, model_name) {

  # Fit on training data
  model_train <- glm(formula, data = train_data, family = binomial)

  # Predict on training data (training performance)
  pred_train <- predict(model_train, newdata = train_data, type = "response")
  roc_train <- roc(train_data$asf_occurrence, pred_train, quiet = TRUE)
  auc_train <- as.numeric(auc(roc_train))

  # Predict on test data (test performance)
  pred_test <- predict(model_train, newdata = test_data, type = "response")
  roc_test <- roc(test_data$asf_occurrence, pred_test, quiet = TRUE)
  auc_test <- as.numeric(auc(roc_test))

  # Difference (overfitting indicator)
  auc_diff <- auc_train - auc_test

  cat(sprintf("%s: Train AUC=%.3f, Test AUC=%.3f, Diff=%.3f\n",
             model_name, auc_train, auc_test, auc_diff))

  list(
    model = model_train,
    auc_train = auc_train,
    auc_test = auc_test,
    auc_diff = auc_diff,
    pred_test = pred_test
  )
}

