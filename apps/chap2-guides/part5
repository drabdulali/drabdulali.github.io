\begin{warning}{When to Worry About Train-Test Differences}
\textbf{Red flags for overfitting:}

\textbf{Large difference (> 0.05):}
\begin{itemize}
    \item \textbf{Example:} Train AUC = 0.85, Test AUC = 0.75 (difference = 0.10)
    \item \textbf{Interpretation:} Model memorized training data, poor generalization
    \item \textbf{Cause:} Too many predictors relative to sample size, no regularization
    \item \textbf{Solution:} Reduce predictors, add regularization, or increase sample size
\end{itemize}

\textbf{Perfect training performance (AUC = 1.00):}
\begin{itemize}
    \item \textbf{Example:} Train AUC = 1.00, Test AUC = 0.70
    \item \textbf{Interpretation:} Severe overfitting, model is "memorizing" rather than learning
    \item \textbf{Cause:} Extremely complex model or data leakage
    \item \textbf{Check:} Ensure no test data information leaked into training
\end{itemize}

\textbf{Negative difference (Test > Train):}
\begin{itemize}
    \item \textbf{Example:} Train AUC = 0.75, Test AUC = 0.80 (difference = -0.05)
    \item \textbf{Interpretation:} Unusual, suggests either (1) random chance, (2) test set easier, or (3) sample size issues
    \item \textbf{Action:} Repeat split with different seed; if consistent, investigate test set characteristics
\end{itemize}

\textbf{Our models:} All differences < 0.01, well below any concern threshold. Strong evidence for generalization.
\end{warning}

