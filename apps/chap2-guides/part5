\subsection{Interpretation: What Does AUC=0.806±0.008 Mean?}

\begin{result}{Understanding Cross-Validation Results}
\textbf{For Elastic Net Model: CV AUC = 0.806 ± 0.008}

\textbf{Mean AUC = 0.806:}
\begin{itemize}
    \item \textbf{Discrimination ability:} The model can correctly rank a randomly selected ASF-positive comuna higher than a randomly selected ASF-negative comuna 80.6\% of the time
    \item \textbf{Performance level:} AUC > 0.80 is considered \textit{excellent} discrimination
    \item \textbf{Expected value:} This is our best estimate of how the model will perform on new, unseen data
\end{itemize}

\textbf{Standard Deviation = 0.008:}
\begin{itemize}
    \item \textbf{Stability:} Very low variability across folds (0.8\% of mean)
    \item \textbf{Consistency:} Model performs similarly regardless of which data subset is used
    \item \textbf{Confidence:} 95\% confidence interval: $0.806 \pm 1.96 \times 0.008 = [0.790, 0.822]$
    \item \textbf{Reliability:} Low SD indicates model is not overfitting to specific data subsets
\end{itemize}

\textbf{Comparison Across Models:}
\begin{itemize}
    \item Elastic Net (0.806 ± 0.008) vs Theory-Driven (0.792 ± 0.007): Only 1.4 percentage point improvement with 8 extra variables
    \item Outbreak History (0.738 ± 0.011): Achieves 91.5\% of Elastic Net performance with only 4 variables (exceptional efficiency)
    \item Wildlife (0.607 ± 0.016): Highest SD, indicating more variable performance across folds
\end{itemize}
\end{result}

\begin{detail}{Why CV Standard Deviation is Small}
\textbf{Our CV SD values (0.007-0.016) are remarkably small. Three reasons:}

\textbf{1. Large Sample Size:}
\begin{itemize}
    \item N = 1,976 observations total
    \item Each training fold: $\sim$1,778 observations
    \item Each test fold: $\sim$198 observations
    \item Large samples produce stable AUC estimates
\end{itemize}

\textbf{2. Balanced Outcome:}
\begin{itemize}
    \item ASF occurrence: $\sim$40\% positive, $\sim$60\% negative
    \item Not extreme imbalance (e.g., 1\%/99\%)
    \item Each fold has sufficient positive and negative cases for robust AUC
\end{itemize}

\textbf{3. Stratification:}
\begin{itemize}
    \item Ensured each fold has similar outcome proportions
    \item Reduced variance from fold assignment randomness
    \item Each fold represents similar "difficulty"
\end{itemize}

\textbf{Implication:} Low CV SD provides strong evidence that model performance is stable and reproducible. We can confidently report mean AUC as expected performance.
\end{detail}

