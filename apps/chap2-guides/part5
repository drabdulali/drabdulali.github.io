\section{Calibration Assessment}
% ============================================================================

\subsection{What is Calibration?}

\begin{methodology}{Discrimination vs Calibration: Two Aspects of Model Quality}
\textbf{A good model needs both discrimination AND calibration:}

\textbf{Discrimination (measured by AUC):}
\begin{itemize}
    \item \textbf{Question:} Can the model distinguish positive from negative cases?
    \item \textbf{Example:} Does model rank high-risk comunas above low-risk comunas?
    \item \textbf{AUC = 0.80:} Model correctly ranks 80\% of random positive-negative pairs
    \item \textbf{Limitation:} Says nothing about \textit{accuracy} of predicted probabilities
\end{itemize}

\textbf{Calibration (measured by calibration plots, Hosmer-Lemeshow test):}
\begin{itemize}
    \item \textbf{Question:} Do predicted probabilities match observed frequencies?
    \item \textbf{Example:} Among comunas with predicted risk = 70\%, do 70\% actually experience ASF?
    \item \textbf{Perfect calibration:} Predicted = Observed (45° line on calibration plot)
    \item \textbf{Importance:} Essential for risk-based decision making and resource allocation
\end{itemize}

\textbf{Why Both Matter:}
\begin{itemize}
    \item \textbf{High discrimination, poor calibration:} Model ranks correctly but overestimates or underestimates absolute risk (e.g., all predictions between 0.8-0.9 even though true rates are 0.3-0.7)
    \item \textbf{Poor discrimination, good calibration:} Model probabilities are accurate on average but can't separate high from low risk (e.g., predicts 40\% risk for everyone when true prevalence is 40\%)
    \item \textbf{Ideal:} High discrimination (AUC > 0.75) AND good calibration (predicted $\approx$ observed)
\end{itemize}
\end{methodology}

\subsection{Complete Calibration Procedure}

\begin{methodology}{Calibration Assessment Steps}
\textbf{1. Generate Predicted Probabilities:}
\begin{itemize}
    \item Fit model on training data (or full data if using cross-validation)
    \item Predict on test data: $\hat{p}_i = P(\text{ASF} = 1 | X_i)$ for each comuna $i$
\end{itemize}

\textbf{2. Bin Predictions into Groups:}
\begin{itemize}
    \item Common approach: Deciles (10 bins) or ventiles (20 bins)
    \item Bin 1: Lowest 10\% of predicted probabilities
    \item Bin 10: Highest 10\% of predicted probabilities
    \item Alternative: Fixed intervals (0-0.1, 0.1-0.2, ..., 0.9-1.0)
\end{itemize}

\textbf{3. Calculate Observed Frequency per Bin:}
\begin{itemize}
    \item For each bin: Calculate proportion of cases that actually had ASF
    \item \textbf{Example:} Bin 7 has 60 comunas with predicted risk 0.60-0.70
    \item Of these 60, suppose 42 actually had ASF
    \item Observed frequency: 42/60 = 0.70 (70\%)
\end{itemize}

\textbf{4. Compare Predicted vs Observed:}
\begin{itemize}
    \item Plot observed frequency vs mean predicted probability for each bin
    \item Perfect calibration: Points fall on 45° diagonal
    \item Overconfident: Points below diagonal (model predicts higher risk than observed)
    \item Underconfident: Points above diagonal (model predicts lower risk than observed)
\end{itemize}

\textbf{5. Formal Calibration Tests:}
\begin{itemize}
    \item \textbf{Hosmer-Lemeshow test:} Chi-squared test of observed vs expected frequencies across bins
    \item \textbf{Calibration slope:} Regression of observed on predicted (slope = 1 ideal)
    \item \textbf{Calibration intercept:} Intercept of same regression (intercept = 0 ideal)
\end{itemize}
\end{methodology}

\subsection{Full R Implementation}

\begin{lstlisting}[language=R, caption=Comprehensive Calibration Assessment]
# =============================================================================
# Calibration Analysis for Elastic Net Model (Best Performer)
# =============================================================================

library(pROC)
library(ResourceSelection)  # For Hosmer-Lemeshow test
library(ggplot2)
library(dplyr)

# Load train-test split results
split_data <- readRDS("results/train_test_split_detailed.rds")
test_data <- split_data$test_data
enet_model <- split_data$enet$model
pred_probs <- split_data$enet$pred_test
actual_outcomes <- test_data$asf_occurrence

# -----------------------------------------------------------------------------
# 1. Bin predicted probabilities into deciles
# -----------------------------------------------------------------------------

# Calculate decile cutoffs
decile_cuts <- quantile(pred_probs, probs = seq(0, 1, 0.1))

# Assign each observation to a decile
test_data$pred_prob <- pred_probs
test_data$decile <- cut(
  pred_probs,
  breaks = decile_cuts,
  include.lowest = TRUE,
  labels = 1:10
)

# -----------------------------------------------------------------------------
# 2. Calculate observed frequency and mean prediction per decile
# -----------------------------------------------------------------------------

calibration_data <- test_data %>%
  group_by(decile) %>%
  summarise(
    n = n(),
    mean_predicted = mean(pred_prob),
    observed_frequency = mean(asf_occurrence),
    n_observed = sum(asf_occurrence),
    .groups = "drop"
  ) %>%
  mutate(
    decile_num = as.numeric(decile),
    # Lower and upper bounds of predicted probability in this decile
    pred_lower = decile_cuts[decile_num],
    pred_upper = decile_cuts[decile_num + 1]
  )

# Print calibration table
cat("\n=== Calibration Table (Deciles) ===\n")
print(calibration_data %>%
      select(decile, n, mean_predicted, observed_frequency,
             n_observed, pred_lower, pred_upper),
      n = 10)

# Save calibration table
write.csv(calibration_data,
          "results/calibration_table_elastic_net.csv",
          row.names = FALSE)

# -----------------------------------------------------------------------------
# 3. Hosmer-Lemeshow Goodness-of-Fit Test
# -----------------------------------------------------------------------------

# Hosmer-Lemeshow test with 10 groups
hl_test <- hoslem.test(actual_outcomes, pred_probs, g = 10)

cat("\n=== Hosmer-Lemeshow Test ===\n")
cat(sprintf("Chi-squared statistic: %.3f\n", hl_test$statistic))
cat(sprintf("Degrees of freedom: %d\n", hl_test$parameter))
cat(sprintf("P-value: %.4f\n", hl_test$p.value))

if (hl_test$p.value > 0.05) {
  cat("Interpretation: p > 0.05 → No evidence of miscalibration (GOOD)\n")
} else {
  cat("Interpretation: p < 0.05 → Evidence of miscalibration (POOR)\n")
}

# -----------------------------------------------------------------------------
# 4. Calibration Slope and Intercept
# -----------------------------------------------------------------------------

# Fit logistic regression: observed ~ logit(predicted)
# Calibration slope: coefficient should be 1.0
# Calibration intercept: intercept should be 0.0

logit_pred <- log(pred_probs / (1 - pred_probs))

calib_model <- glm(
  actual_outcomes ~ logit_pred,
  family = binomial
)

calib_coefs <- coef(calib_model)
calib_slope <- calib_coefs[2]
calib_intercept <- calib_coefs[1]

cat("\n=== Calibration Slope and Intercept ===\n")
cat(sprintf("Calibration intercept: %.3f (ideal = 0.0)\n", calib_intercept))
cat(sprintf("Calibration slope:     %.3f (ideal = 1.0)\n", calib_slope))

if (abs(calib_intercept) < 0.1 & abs(calib_slope - 1.0) < 0.1) {
  cat("Interpretation: Slope ≈ 1 and Intercept ≈ 0 → Excellent calibration\n")
} else if (calib_slope < 1.0) {
  cat("Interpretation: Slope < 1 → Predictions too extreme (overconfident)\n")
} else if (calib_slope > 1.0) {
  cat("Interpretation: Slope > 1 → Predictions too conservative (underconfident)\n")
}

# -----------------------------------------------------------------------------
# 5. Create calibration plot
# -----------------------------------------------------------------------------

# Calibration plot: Observed vs Predicted
calib_plot <- ggplot(calibration_data,
                     aes(x = mean_predicted, y = observed_frequency)) +
  # Perfect calibration line (45 degree)
  geom_abline(intercept = 0, slope = 1,
              linetype = "dashed", color = "gray50", size = 1) +

  # Observed vs predicted points
  geom_point(aes(size = n), color = "steelblue", alpha = 0.7) +

  # Connect points with line
  geom_line(color = "steelblue", alpha = 0.5) +

  # Add error bars (binomial confidence intervals)
  geom_errorbar(
    aes(ymin = observed_frequency - 1.96 * sqrt(observed_frequency *
                                                 (1 - observed_frequency) / n),
        ymax = observed_frequency + 1.96 * sqrt(observed_frequency *
                                                 (1 - observed_frequency) / n)),
    width = 0.02, color = "steelblue", alpha = 0.5
  ) +

  # Labels and theme
  labs(
    title = "Calibration Plot: Elastic Net Model",
    subtitle = sprintf("Hosmer-Lemeshow χ² = %.2f, p = %.3f; Slope = %.2f",
                      hl_test$statistic, hl_test$p.value, calib_slope),
    x = "Mean Predicted Probability",
    y = "Observed Frequency (Proportion with ASF)",
    size = "Sample Size"
  ) +
  scale_x_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.1)) +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.1)) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold", size = 14),
    axis.title = element_text(size = 12),
    legend.position = "right"
  )

# Save plot
ggsave("results/calibration_plot_elastic_net.png",
       calib_plot, width = 8, height = 6, dpi = 300)

print(calib_plot)

cat("\nCalibration analysis completed and plot saved!\n")

# -----------------------------------------------------------------------------
