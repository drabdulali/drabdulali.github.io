\subsection{Decision: When to Use Different Thresholds}

\begin{warning}{Threshold Selection Depends on Objectives}
\textbf{No universally "best" threshold.} Choice depends on relative costs of errors and operational goals.

\textbf{Scenario 1: Prioritize Early Detection (High Sensitivity)}
\begin{itemize}
    \item \textbf{Goal:} Catch as many ASF outbreaks as possible, even with false alarms
    \item \textbf{Rationale:} Missing an outbreak is very costly (spread, economic damage)
    \item \textbf{Threshold:} Low (e.g., 0.25-0.35) to maximize sensitivity
    \item \textbf{Example:} Threshold = 0.215 achieves 90\% sensitivity
    \item \textbf{Trade-off:} Only 47% specificity (many false alarms)
    \item \textbf{Use case:} Initial screening, high-stakes situations, emergency response
\end{itemize}

\textbf{Scenario 2: Prioritize Resource Efficiency (High Specificity)}
\begin{itemize}
    \item \textbf{Goal:} Minimize false alarms, focus resources on truly high-risk areas
    \item \textbf{Rationale:} Resources are limited, false alarms costly (staff time, unnecessary restrictions)
    \item \textbf{Threshold:} High (e.g., 0.65-0.75) to maximize specificity
    \item \textbf{Example:} Threshold = 0.723 achieves 90\% specificity
    \item \textbf{Trade-off:} Only 44% sensitivity (miss many outbreaks)
    \item \textbf{Use case:} Targeted interventions, limited budgets, low-tolerance for false alarms
\end{itemize}

\textbf{Scenario 3: Balanced Approach (Youden's J)}
\begin{itemize}
    \item \textbf{Goal:} Balance sensitivity and specificity equally
    \item \textbf{Rationale:} No strong preference for one error type over another
    \item \textbf{Threshold:} Optimal by Youden's J (e.g., 0.423)
    \item \textbf{Performance:} 75% sensitivity, 74% specificity (balanced)
    \item \textbf{Use case:} General surveillance, no extreme cost asymmetries
\end{itemize}

\textbf{Scenario 4: Match Operational Capacity}
\begin{itemize}
    \item \textbf{Goal:} Flag a manageable number of comunas for follow-up
    \item \textbf{Example:} Can only visit 150 of 593 comunas
    \item \textbf{Approach:} Rank by predicted probability, select top 150 (25\%)
    \item \textbf{Effective threshold:} 75th percentile of predicted probabilities
    \item \textbf{Use case:} Resource-constrained settings with fixed capacity
\end{itemize}

\textbf{Recommendation for Romania ASF Surveillance:}
\begin{itemize}
    \item \textbf{Primary threshold:} Use Youden's optimal (0.423) for balanced approach
    \item \textbf{Sensitivity analysis:} Report performance at multiple thresholds
    \item \textbf{Operational flexibility:} Allow veterinary authorities to adjust based on current resources and outbreak intensity
    \item \textbf{Continuous reassessment:} Update threshold as prevalence or costs change
\end{itemize}
\end{warning}

