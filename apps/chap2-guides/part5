    vars = c("pig_density", "farm_density", "small_farm_proportion",
             "cattle_density", "sheep_density", "goat_density",
             "forest_cover", "cropland_cover", "urban_cover",
             "dist_to_water", "elevation", "road_density",
             "previous_outbreak", "days_since_last_outbreak",
             "cumulative_outbreaks",
             "wild_boar_density", "wild_boar_harvest_rate",
             "wild_boar_carcass_density")
  ),
  enet = list(
    name = "Elastic Net",
    vars = c("pig_density", "farm_density", "small_farm_proportion",
             "commercial_farm_proportion", "cattle_density", "sheep_density",
             "goat_density", "forest_cover", "cropland_cover", "urban_cover",
             "dist_to_water", "elevation", "road_density",
             "previous_outbreak", "days_since_last_outbreak",
             "cumulative_outbreaks", "outbreak_density_neighbors",
             "wild_boar_density", "wild_boar_harvest_rate",
             "wild_boar_carcass_density")
  ),
  livestock = list(
    name = "Livestock",
    vars = c("pig_density", "farm_density", "small_farm_proportion",
             "commercial_farm_proportion", "cattle_density",
             "sheep_density", "goat_density")
  ),
  landscape = list(
    name = "Landscape",
    vars = c("forest_cover", "cropland_cover", "urban_cover",
             "dist_to_water", "elevation", "road_density")
  ),
  outbreak = list(
    name = "Outbreak History",
    vars = c("previous_outbreak", "days_since_last_outbreak",
             "cumulative_outbreaks", "outbreak_density_neighbors")
  ),
  wildlife = list(
    name = "Wildlife",
    vars = c("wild_boar_density", "wild_boar_harvest_rate",
             "wild_boar_carcass_density")
  )
)

# Initialize results storage
validation_results <- list()

# -----------------------------------------------------------------------------
# 1. CROSS-VALIDATION (10-fold, stratified)
# -----------------------------------------------------------------------------

cat("\n========================================\n")
cat("STEP 1: 10-FOLD CROSS-VALIDATION\n")
cat("========================================\n")

set.seed(42)
folds <- createFolds(analysis_data$asf_occurrence, k = 10,
                    list = TRUE, returnTrain = FALSE)

for (model_id in names(model_specs)) {
  spec <- model_specs[[model_id]]
  cat(sprintf("\nValidating %s (%d variables)...\n",
             spec$name, length(spec$vars)))

  formula <- as.formula(paste("asf_occurrence ~",
                             paste(spec$vars, collapse = " + ")))

  fold_aucs <- numeric(10)
  for (i in 1:10) {
    train_data <- analysis_data[-folds[[i]], ]
    test_data <- analysis_data[folds[[i]], ]

    model <- glm(formula, data = train_data, family = binomial)
    pred_probs <- predict(model, newdata = test_data, type = "response")

    roc_obj <- roc(test_data$asf_occurrence, pred_probs, quiet = TRUE)
    fold_aucs[i] <- as.numeric(auc(roc_obj))
  }

  validation_results[[model_id]]$cv_mean <- mean(fold_aucs)
  validation_results[[model_id]]$cv_sd <- sd(fold_aucs)

  cat(sprintf("  CV AUC: %.3f ± %.3f\n", mean(fold_aucs), sd(fold_aucs)))
}

# -----------------------------------------------------------------------------
# 2. TRAIN-TEST SPLIT (70/30, stratified)
# -----------------------------------------------------------------------------

cat("\n========================================\n")
cat("STEP 2: 70/30 TRAIN-TEST SPLIT\n")
cat("========================================\n")

set.seed(123)
train_indices <- createDataPartition(analysis_data$asf_occurrence,
                                    p = 0.70, list = FALSE)
train_data <- analysis_data[train_indices, ]
test_data <- analysis_data[-train_indices, ]

for (model_id in names(model_specs)) {
  spec <- model_specs[[model_id]]
  cat(sprintf("\nValidating %s...\n", spec$name))

  formula <- as.formula(paste("asf_occurrence ~",
                             paste(spec$vars, collapse = " + ")))

  # Fit on training data
  model_train <- glm(formula, data = train_data, family = binomial)

  # Predict on training data
  pred_train <- predict(model_train, newdata = train_data, type = "response")
  auc_train <- auc(roc(train_data$asf_occurrence, pred_train, quiet = TRUE))

  # Predict on test data
  pred_test <- predict(model_train, newdata = test_data, type = "response")
  auc_test <- auc(roc(test_data$asf_occurrence, pred_test, quiet = TRUE))

  validation_results[[model_id]]$train_auc <- as.numeric(auc_train)
  validation_results[[model_id]]$test_auc <- as.numeric(auc_test)
  validation_results[[model_id]]$diff_auc <- as.numeric(auc_train - auc_test)
  validation_results[[model_id]]$test_predictions <- pred_test

  cat(sprintf("  Train AUC: %.3f, Test AUC: %.3f, Diff: %.3f\n",
             auc_train, auc_test, auc_train - auc_test))
}

# -----------------------------------------------------------------------------
# 3. CALIBRATION (Hosmer-Lemeshow, slopes)
# -----------------------------------------------------------------------------

cat("\n========================================\n")
cat("STEP 3: CALIBRATION ASSESSMENT\n")
cat("========================================\n")

for (model_id in names(model_specs)) {
  spec <- model_specs[[model_id]]
  cat(sprintf("\nCalibration for %s...\n", spec$name))

  pred_probs <- validation_results[[model_id]]$test_predictions
  actual <- test_data$asf_occurrence

  # Hosmer-Lemeshow test
  hl_test <- hoslem.test(actual, pred_probs, g = 10)

  # Calibration slope/intercept
  logit_pred <- log(pred_probs / (1 - pred_probs))
  calib_model <- glm(actual ~ logit_pred, family = binomial)
  calib_slope <- coef(calib_model)[2]
  calib_intercept <- coef(calib_model)[1]

  validation_results[[model_id]]$hl_chisq <- as.numeric(hl_test$statistic)
  validation_results[[model_id]]$hl_pvalue <- hl_test$p.value
  validation_results[[model_id]]$calib_slope <- calib_slope
  validation_results[[model_id]]$calib_intercept <- calib_intercept

  cat(sprintf("  HL χ²=%.2f, p=%.3f\n", hl_test$statistic, hl_test$p.value))
  cat(sprintf("  Calibration: Slope=%.3f, Intercept=%.3f\n",
             calib_slope, calib_intercept))
}

# -----------------------------------------------------------------------------
# 4. ROC AND OPTIMAL THRESHOLD (Youden's J)
# -----------------------------------------------------------------------------

cat("\n========================================\n")
cat("STEP 4: ROC ANALYSIS & THRESHOLD\n")
cat("========================================\n")

for (model_id in names(model_specs)) {
  spec <- model_specs[[model_id]]
  cat(sprintf("\nROC for %s...\n", spec$name))

  pred_probs <- validation_results[[model_id]]$test_predictions
  actual <- test_data$asf_occurrence

  roc_obj <- roc(actual, pred_probs, levels = c(0, 1), direction = "<")

  # Optimal threshold (Youden's J)
  coords_all <- coords(roc_obj, x = "all",
                      ret = c("threshold", "sensitivity", "specificity"))
  coords_all$youden_j <- coords_all$sensitivity + coords_all$specificity - 1

  optimal_idx <- which.max(coords_all$youden_j)
  optimal_threshold <- coords_all$threshold[optimal_idx]
  optimal_sens <- coords_all$sensitivity[optimal_idx]
  optimal_spec <- coords_all$specificity[optimal_idx]

  validation_results[[model_id]]$optimal_threshold <- optimal_threshold
  validation_results[[model_id]]$optimal_sensitivity <- optimal_sens
  validation_results[[model_id]]$optimal_specificity <- optimal_spec

  cat(sprintf("  Optimal Threshold: %.3f\n", optimal_threshold))
  cat(sprintf("  Sensitivity: %.3f, Specificity: %.3f\n",
             optimal_sens, optimal_spec))
}

# -----------------------------------------------------------------------------
# 5. COMPILE RESULTS
# -----------------------------------------------------------------------------

cat("\n========================================\n")
cat("FINAL VALIDATION SUMMARY\n")
cat("========================================\n")

summary_df <- map_df(names(model_specs), function(model_id) {
  spec <- model_specs[[model_id]]
  res <- validation_results[[model_id]]

  data.frame(
    Model = spec$name,
    Variables = length(spec$vars),
    CV_AUC_Mean = res$cv_mean,
    CV_AUC_SD = res$cv_sd,
    Train_AUC = res$train_auc,
    Test_AUC = res$test_auc,
    AUC_Diff = res$diff_auc,
    HL_pvalue = res$hl_pvalue,
    Calib_Slope = res$calib_slope,
    Optimal_Threshold = res$optimal_threshold,
    Optimal_Sensitivity = res$optimal_sensitivity,
    Optimal_Specificity = res$optimal_specificity,
    stringsAsFactors = FALSE
  )
}) %>% arrange(desc(Test_AUC))

print(summary_df, row.names = FALSE)

# Save results
write.csv(summary_df, "results/validation_summary_all_models.csv",
         row.names = FALSE)
saveRDS(validation_results, "results/validation_results_detailed.rds")

cat("\n========================================\n")
cat("VALIDATION COMPLETE!\n")
cat("Results saved to results/ directory\n")
cat("========================================\n")
\end{lstlisting}

