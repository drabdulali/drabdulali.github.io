cv_aucs <- numeric(10)
for (i in 1:10) {
  train <- analysis_data[-folds[[i]], ]
  test <- analysis_data[folds[[i]], ]

  model <- glm(new_model_formula, data = train, family = binomial)
  pred <- predict(model, newdata = test, type = "response")

  cv_aucs[i] <- auc(roc(test$asf_occurrence, pred, quiet = TRUE))
}

cat(sprintf("CV AUC: %.3f ± %.3f\n", mean(cv_aucs), sd(cv_aucs)))

# -----------------------------------------------------------------------------
# 2. Train-test split
# -----------------------------------------------------------------------------
set.seed(123)
train_idx <- createDataPartition(analysis_data$asf_occurrence, p = 0.70)
train_data <- analysis_data[train_idx, ]
test_data <- analysis_data[-train_idx, ]

model_train <- glm(new_model_formula, data = train_data, family = binomial)
pred_train <- predict(model_train, newdata = train_data, type = "response")
pred_test <- predict(model_train, newdata = test_data, type = "response")

auc_train <- auc(roc(train_data$asf_occurrence, pred_train))
auc_test <- auc(roc(test_data$asf_occurrence, pred_test))

cat(sprintf("Train AUC: %.3f, Test AUC: %.3f, Diff: %.3f\n",
           auc_train, auc_test, auc_train - auc_test))

# -----------------------------------------------------------------------------
# 3. Calibration
# -----------------------------------------------------------------------------
hl_test <- hoslem.test(test_data$asf_occurrence, pred_test, g = 10)
cat(sprintf("Hosmer-Lemeshow: χ²=%.2f, p=%.3f\n",
           hl_test$statistic, hl_test$p.value))

# -----------------------------------------------------------------------------
# 4. Optimal threshold
# -----------------------------------------------------------------------------
roc_obj <- roc(test_data$asf_occurrence, pred_test)
coords_all <- coords(roc_obj, x = "all",
                    ret = c("threshold", "sensitivity", "specificity"))
coords_all$youden_j <- coords_all$sensitivity + coords_all$specificity - 1
optimal_threshold <- coords_all$threshold[which.max(coords_all$youden_j)]

cat(sprintf("Optimal Threshold: %.3f\n", optimal_threshold))
\end{lstlisting}

