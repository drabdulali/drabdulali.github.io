% ============================================================================

\subsection{What is the ROC Curve?}

\begin{methodology}{Receiver Operating Characteristic (ROC) Curve Explained}
\textbf{Purpose:} Visualize trade-off between sensitivity and specificity across all possible classification thresholds.

\textbf{Key Concepts:}

\textbf{Classification Threshold ($t$):}
\begin{itemize}
    \item Model outputs predicted probability: $\hat{p}_i \in [0, 1]$
    \item To classify, need threshold: If $\hat{p}_i \geq t$, classify as ``positive'' (ASF)
    \item Common default: $t = 0.5$
    \item \textbf{Question:} Is 0.5 optimal? Depends on costs of errors.
\end{itemize}

\textbf{Confusion Matrix at Threshold $t$:}
\begin{table}[H]
\centering
\begin{tabular}{lcc}
\toprule
 & \textbf{True ASF} & \textbf{True No ASF} \\
\midrule
\textbf{Pred ASF} ($\hat{p} \geq t$) & True Positive (TP) & False Positive (FP) \\
\textbf{Pred No ASF} ($\hat{p} < t$) & False Negative (FN) & True Negative (TN) \\
\bottomrule
\end{tabular}
\end{table}

\textbf{Performance Metrics:}
\begin{itemize}
    \item \textbf{Sensitivity (Recall, True Positive Rate):} $\frac{\text{TP}}{\text{TP} + \text{FN}}$
    \begin{itemize}
        \item Proportion of actual ASF cases correctly identified
        \item \textbf{Example:} Sensitivity = 0.80 means 80\% of ASF comunas are flagged
    \end{itemize}

    \item \textbf{Specificity (True Negative Rate):} $\frac{\text{TN}}{\text{TN} + \text{FP}}$
    \begin{itemize}
        \item Proportion of actual non-ASF cases correctly identified
        \item \textbf{Example:} Specificity = 0.70 means 70\% of non-ASF comunas are correctly ruled out
    \end{itemize}

    \item \textbf{1 - Specificity (False Positive Rate):} $\frac{\text{FP}}{\text{TN} + \text{FP}}$
    \begin{itemize}
        \item Proportion of non-ASF cases incorrectly flagged as ASF
    \end{itemize}
\end{itemize}

\textbf{ROC Curve Construction:}
\begin{enumerate}
    \item For each possible threshold $t \in [0, 1]$:
    \begin{itemize}
        \item Classify cases using threshold $t$
        \item Calculate Sensitivity and 1-Specificity
        \item Plot point: (1-Specificity, Sensitivity)
    \end{itemize}
    \item Connect all points to form ROC curve
    \item Calculate AUC (area under the curve)
\end{enumerate}

\textbf{Interpreting ROC Curve:}
\begin{itemize}
    \item \textbf{Diagonal line (AUC=0.5):} Random guessing (no discrimination)
    \item \textbf{Upper left corner (AUC=1.0):} Perfect discrimination (100\% sensitivity, 100\% specificity)
    \item \textbf{Closer to upper left:} Better discrimination
    \item \textbf{AUC:} Overall measure of discrimination ability (average sensitivity across all specificities)
\end{itemize}
\end{methodology}

\subsection{AUC Interpretation in Detail}

\begin{detail}{What Does AUC=0.808 Mean?}
\textbf{Three equivalent interpretations:}

\textbf{1. Probabilistic Interpretation (Most intuitive):}
\begin{quote}
``If you randomly select one ASF-positive comuna and one ASF-negative comuna, there is an 80.8\% probability that the model assigns a higher risk score to the positive comuna.''
\end{quote}

\textbf{Example:}
\begin{itemize}
    \item Comuna A: ASF occurred, predicted risk = 0.72
    \item Comuna B: No ASF, predicted risk = 0.41
    \item Model correctly ranks A > B
    \item With AUC=0.808, this correct ranking happens 80.8\% of the time across all possible pairs
\end{itemize}

\textbf{2. Ranking Interpretation:}
\begin{quote}
``The model correctly orders positive and negative cases 80.8\% of the time.''
\end{quote}

\textbf{3. Discrimination Interpretation:}
\begin{quote}
``The model's discrimination ability is 80.8\% of perfect (AUC=1.0 would be perfect).''
\end{quote}

\textbf{Rule of Thumb:}
\begin{itemize}
    \item AUC = 0.50: No discrimination (random)
    \item AUC = 0.60-0.70: Poor discrimination
    \item AUC = 0.70-0.80: Acceptable discrimination
    \item AUC = 0.80-0.90: Excellent discrimination
    \item AUC > 0.90: Outstanding discrimination (rare in practice)
\end{itemize}

\textbf{Our Model (AUC = 0.808):} Excellent discrimination, in the top category for epidemiological risk models.
\end{detail}

\subsection{Youden's J Index for Optimal Threshold}

\begin{methodology}{Finding the Optimal Classification Threshold}
\textbf{Problem:} Different thresholds optimize different objectives. How to choose?

\textbf{Trade-Off:}
\begin{itemize}
    \item \textbf{Low threshold (e.g., 0.3):} High sensitivity (catch most ASF cases), low specificity (many false alarms)
    \item \textbf{High threshold (e.g., 0.7):} Low sensitivity (miss some ASF cases), high specificity (few false alarms)
\end{itemize}

\textbf{Youden's J Index:}
\begin{equation}
J = \text{Sensitivity} + \text{Specificity} - 1
\end{equation}

\textbf{Interpretation:}
\begin{itemize}
    \item J ranges from 0 (no discrimination) to 1 (perfect)
    \item J = 0: Sensitivity + Specificity = 1 (random guessing)
    \item J = 1: Sensitivity + Specificity = 2 (perfect classification)
    \item \textbf{Optimal threshold:} Value of $t$ that maximizes $J$
\end{itemize}

\textbf{Why Youden's J?}
\begin{itemize}
    \item Treats sensitivity and specificity as equally important
    \item Maximizes correct classification rate
    \item Standard method when no specific cost function available
\end{itemize}

\textbf{Alternative Thresholds:}
\begin{itemize}
    \item \textbf{Maximize sensitivity:} If missing a case is very costly (e.g., deadly disease)
    \item \textbf{Maximize specificity:} If false alarms are very costly (e.g., expensive interventions)
    \item \textbf{Prevalence threshold:} Use observed prevalence as cutoff
    \item \textbf{Cost-based:} Minimize expected cost given specific costs of TP, FP, TN, FN
\end{itemize}
\end{methodology}

\subsection{Complete Implementation}

\begin{lstlisting}[language=R, caption=ROC Analysis and Optimal Threshold]
# =============================================================================
# ROC Analysis and Threshold Optimization for Elastic Net Model
# =============================================================================

library(pROC)
library(caret)
library(ggplot2)
library(dplyr)

# Load test data and predictions
split_data <- readRDS("results/train_test_split_detailed.rds")
test_data <- split_data$test_data
pred_probs <- split_data$enet$pred_test
actual_outcomes <- test_data$asf_occurrence

# -----------------------------------------------------------------------------
# 1. Generate ROC curve
# -----------------------------------------------------------------------------

roc_obj <- roc(
  response = actual_outcomes,
  predictor = pred_probs,
  levels = c(0, 1),
  direction = "<"
)

# AUC with confidence interval
auc_value <- auc(roc_obj)
auc_ci <- ci.auc(roc_obj, conf.level = 0.95)

cat("\n=== ROC Analysis Results ===\n")
cat(sprintf("AUC: %.3f\n", auc_value))
cat(sprintf("95%% CI: [%.3f, %.3f]\n", auc_ci[1], auc_ci[3]))

# -----------------------------------------------------------------------------
# 2. Find optimal threshold using Youden's J index
# -----------------------------------------------------------------------------

# Calculate Youden's J for all thresholds
coords_all <- coords(
  roc_obj,
  x = "all",
  ret = c("threshold", "sensitivity", "specificity")
)

# Youden's J = Sensitivity + Specificity - 1
coords_all$youden_j <- coords_all$sensitivity + coords_all$specificity - 1

# Find threshold with maximum J
optimal_idx <- which.max(coords_all$youden_j)
optimal_threshold <- coords_all$threshold[optimal_idx]
optimal_sensitivity <- coords_all$sensitivity[optimal_idx]
optimal_specificity <- coords_all$specificity[optimal_idx]
optimal_j <- coords_all$youden_j[optimal_idx]

cat("\n=== Optimal Threshold (Youden's J) ===\n")
cat(sprintf("Threshold: %.3f\n", optimal_threshold))
cat(sprintf("Sensitivity: %.3f (%.1f%%)\n",
           optimal_sensitivity, 100 * optimal_sensitivity))
cat(sprintf("Specificity: %.3f (%.1f%%)\n",
           optimal_specificity, 100 * optimal_specificity))
cat(sprintf("Youden's J: %.3f\n", optimal_j))

# -----------------------------------------------------------------------------
# 3. Confusion matrix at optimal threshold
# -----------------------------------------------------------------------------

# Classify using optimal threshold
pred_class <- ifelse(pred_probs >= optimal_threshold, 1, 0)

# Confusion matrix
conf_matrix <- confusionMatrix(
  data = factor(pred_class, levels = c(0, 1)),
  reference = factor(actual_outcomes, levels = c(0, 1)),
  positive = "1"
)

cat("\n=== Confusion Matrix at Optimal Threshold ===\n")
print(conf_matrix$table)

cat("\n=== Performance Metrics ===\n")
cat(sprintf("Sensitivity (Recall):  %.3f\n", conf_matrix$byClass["Sensitivity"]))
cat(sprintf("Specificity:           %.3f\n", conf_matrix$byClass["Specificity"]))
cat(sprintf("Positive Pred Value (PPV/Precision): %.3f\n",
           conf_matrix$byClass["Pos Pred Value"]))
cat(sprintf("Negative Pred Value (NPV):           %.3f\n",
           conf_matrix$byClass["Neg Pred Value"]))
cat(sprintf("Accuracy:              %.3f\n", conf_matrix$overall["Accuracy"]))
cat(sprintf("F1 Score:              %.3f\n", conf_matrix$byClass["F1"]))

# Extract counts from confusion matrix
tn <- conf_matrix$table[1, 1]
fp <- conf_matrix$table[1, 2]
fn <- conf_matrix$table[2, 1]
tp <- conf_matrix$table[2, 2]

cat("\n=== Confusion Matrix Counts ===\n")
cat(sprintf("True Negatives (TN):   %d\n", tn))
cat(sprintf("False Positives (FP):  %d\n", fp))
cat(sprintf("False Negatives (FN):  %d\n", fn))
cat(sprintf("True Positives (TP):   %d\n", tp))
cat(sprintf("Total:                 %d\n", tn + fp + fn + tp))

# -----------------------------------------------------------------------------
# 4. ROC curve plot
# -----------------------------------------------------------------------------

# Extract coordinates for plotting
roc_coords <- coords(roc_obj, x = "all", ret = c("threshold", "specificity",
                                                 "sensitivity"))

roc_plot <- ggplot(roc_coords, aes(x = 1 - specificity, y = sensitivity)) +
  # ROC curve
  geom_line(color = "steelblue", size = 1.2) +

  # Diagonal reference line (random classifier)
  geom_abline(intercept = 0, slope = 1, linetype = "dashed",
              color = "gray50", size = 0.8) +

  # Optimal threshold point
  geom_point(aes(x = 1 - optimal_specificity, y = optimal_sensitivity),
             color = "red", size = 4, shape = 16) +

  # Optimal threshold annotation
  annotate("text",
           x = 1 - optimal_specificity + 0.15,
           y = optimal_sensitivity - 0.05,
           label = sprintf("Optimal Threshold = %.3f\nSensitivity = %.2f\nSpecificity = %.2f",
                          optimal_threshold, optimal_sensitivity,
                          optimal_specificity),
           hjust = 0, size = 3.5, color = "red") +

  # Labels and theme
  labs(
    title = "ROC Curve: Elastic Net Model",
    subtitle = sprintf("AUC = %.3f (95%% CI: %.3f - %.3f)",
                      auc_value, auc_ci[1], auc_ci[3]),
    x = "1 - Specificity (False Positive Rate)",
    y = "Sensitivity (True Positive Rate)"
  ) +
  scale_x_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.1)) +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.1)) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold", size = 14),
    axis.title = element_text(size = 12)
  )

# Save plot
ggsave("results/roc_curve_elastic_net.png",
       roc_plot, width = 8, height = 7, dpi = 300)

print(roc_plot)

# -----------------------------------------------------------------------------
# 5. Alternative thresholds for comparison
# -----------------------------------------------------------------------------

# Compare different threshold strategies
thresholds_compare <- data.frame(
  Strategy = c(
    "Youden's J (Optimal)",
    "Default 0.5",
    "Observed Prevalence",
    "Maximize Sensitivity (90%)",
