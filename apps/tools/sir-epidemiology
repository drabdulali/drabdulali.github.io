        <text x="756" y="294" font-size="11" fill="#3d3c35">time</text>

        <!-- S(t) — dashed blue, starts high, decreases monotonically -->
        <path d="M82,95 C130,98 180,108 230,124 C280,142 320,164 360,192 C395,216 420,240 455,265 C490,284 530,291 590,291 C640,291 690,291 735,291"
