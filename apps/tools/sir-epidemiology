function loadScenario(key, callerBtn){
  // Update tab buttons safely — callerBtn may be undefined on programmatic calls
  document.querySelectorAll('#sc-tab-row .tbtn').forEach(b=>b.classList.remove('active'));
  if(callerBtn){
    callerBtn.classList.add('active');
  } else {
    const match=document.querySelector(`#sc-tab-row [data-key="${key}"]`);
    if(match) match.classList.add('active');
  }
  const sc=SCENARIOS[key];
  document.getElementById('scenario-desc').textContent=sc.desc.replace(/&#8320;/g,'₀').replace(/&#8722;/g,'−').replace(/&#215;/g,'×').replace(/&#8242;/g,"'").replace(/&#8734;/g,'∞').replace(/&#956;/g,'μ').replace(/&#946;/g,'β').replace(/&#947;/g,'γ');
  document.getElementById('scenario-math').innerHTML=`<div class="math-block"><div class="math-label">Key equation for this scenario</div>${sc.math}</div>`;
  MathJax.typesetPromise([document.getElementById('scenario-math')]);
  const p=sc.params;
  let s0=p.vaccPre!==undefined ? 1-p.vaccPre-p.I0 : 1-p.I0;
  const res=sir(p.beta,p.gamma,p.mu||0,p.days,p.I0,s0);
  // special: eradication — apply vaccination mid-simulation
  let finalRes=res;
  if(p.vaccMid!==undefined){
    const midIdx=Math.round(p.vaccMid/1)*4; // approx
    // Apply: reduce S by vaccLevel at midpoint
    if(midIdx<res.s.length){
      const sAtMid=res.s[midIdx];
      const newS=Math.max(0,sAtMid*(1-p.vaccLevel));
      const iAtMid=res.i[midIdx];
      const post=sir(p.beta,p.gamma,p.mu||0,p.days-p.vaccMid,iAtMid,newS);
      const preS=res.s.slice(0,midIdx); const preI=res.i.slice(0,midIdx); const preR=res.r.slice(0,midIdx); const preT=res.t.slice(0,midIdx);
      finalRes={
        t:[...preT,...post.t.map(x=>x+p.vaccMid)],
        s:[...preS,...post.s],i:[...preI,...post.i],r:[...preR,...post.r]
      };
    }
  }
  const r0=p.beta/p.gamma;
  const peak=Math.max(...finalRes.i);
  const far=finalRes.r[finalRes.r.length-1];
  document.getElementById('sc-r0').textContent=r0.toFixed(2);
  document.getElementById('sc-peak').textContent=(peak*100).toFixed(1)+'%';
  document.getElementById('sc-far').textContent=(far*100).toFixed(1)+'%';
  document.getElementById('sc-outcome').textContent=sc.outcome;
  const thr=finalRes.t.map(()=>Math.min(1/r0,0.999));
  if(scChart){
    scChart.data.labels=finalRes.t.map(Math.round);
    scChart.data.datasets[0].data=finalRes.s;
    scChart.data.datasets[1].data=finalRes.i;
    scChart.data.datasets[2].data=finalRes.r;
    scChart.data.datasets[3].data=thr;
    scChart.update('none');
  }
}

// ── HIT bars ─────────────────────────────────────────────────────
function buildHIT(){
  const diseases=[
    ['Seasonal flu',1.3],['Ebola',2.0],['COVID-19 (original)',3.5],
    ['COVID-19 (Omicron)',10],['Polio',5.0],['Smallpox',6.0],
    ['Mumps',7.0],['Chickenpox',10.0],['Measles',15.0]
  ];
  const wrap=document.getElementById('hit-bars');
  if(!wrap)return;
  wrap.innerHTML=diseases.map(([name,r0])=>{
    const hit=(1-1/r0)*100;
    return `<div class="hit-bar">
      <span class="hit-bar-label">${name} (R&#8320;=${r0})</span>
      <div class="hit-bar-track"><div class="hit-bar-fill" style="width:${hit}%"></div></div>
      <span class="hit-bar-val">${hit.toFixed(0)}%</span>
    </div>`;
  }).join('');
}

// ── Collapsible details ───────────────────────────────────────────
function det(id){
  const body=document.getElementById(id);
  const btn=body.previousElementSibling;
  const open=body.classList.toggle('open');
  btn.classList.toggle('open',open);
}

