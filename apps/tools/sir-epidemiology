<script>
// ── SIR Solver ─────────────────────────────────────────────────────
function sir(beta, gamma, mu, days, I0frac, S0override) {
  const dt = 0.25, steps = Math.round(days/dt);
  let s = S0override !== undefined ? S0override : 1 - I0frac;
  let i = I0frac, r = 1 - s - i;
  const ts=[], ss=[], ii=[], rr=[];
  for(let k=0; k<steps; k++){
    if(k%4===0){ts.push(k*dt); ss.push(s); ii.push(i); rr.push(r);}
    const inf = beta*s*i;
    const rec = gamma*i;
    s += (mu*(s+i+r) - inf - mu*s)*dt;
    i += (inf - rec - mu*i)*dt;
    r += (rec - mu*r)*dt;
    s=Math.max(0,s); i=Math.max(0,i); r=Math.max(0,Math.min(1,r));
  }
  return {t:ts,s:ss,i:ii,r:rr};
}

// ── Chart factory ──────────────────────────────────────────────────
function makeChart(id, datasets, opts={}) {
  const el = document.getElementById(id);
