<style>
/* ── Base ─────────────────────────────────────────────────────────── */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#fafaf7;
  --bg2:#f3f2ed;
  --bg3:#ece9e0;
  --ink:#1a1a16;
  --ink2:#3d3c35;
  --ink3:#6b6a60;
  --blue:#0a5c96;
  --blue-light:#e8f2fb;
  --blue-mid:#3b82c4;
  --orange:#c9620a;
  --orange-light:#fdf0e6;
  --teal:#0a7a6a;
  --teal-light:#e6f5f2;
  --red:#b03030;
  --red-light:#fbeaea;
  --amber:#a06a00;
  --amber-light:#fef7e6;
  --purple:#6038a0;
  --purple-light:#f0ebf8;
  --green:#2a7a2a;
  --green-light:#eaf6ea;
  --rule:#d8d5c8;
  --radius:10px;
  --shadow:0 2px 16px rgba(0,0,0,.08);
  --shadow-lg:0 6px 32px rgba(0,0,0,.12);
}
html{scroll-behavior:smooth}
body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:15px}

/* ── Nav (matches main site) ─────────────────────────────────────── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;padding:.9rem 2rem;background:rgba(250,250,247,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center}
.nav-logo{font-family:'Playfair Display',serif;font-size:1.35rem;font-weight:700;background:linear-gradient(135deg,#0a5c96,#0a7a6a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-decoration:none}
.nav-links{display:flex;gap:1.75rem;list-style:none}
.nav-links a{color:var(--ink3);text-decoration:none;font-size:.88rem;font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--ink)}

/* ── Page hero ───────────────────────────────────────────────────── */
.page-hero{padding:100px 2rem 3rem;text-align:center;border-bottom:1px solid var(--rule)}
.hero-label{display:inline-block;padding:.3rem .9rem;background:var(--blue-light);border:1px solid rgba(10,92,150,.2);border-radius:20px;font-size:.75rem;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.8px;margin-bottom:1rem}
.page-hero h1{font-family:'Playfair Display',serif;font-size:clamp(1.9rem,4vw,3rem);font-weight:800;line-height:1.15;color:var(--ink);margin-bottom:.75rem}
.page-hero p{color:var(--ink3);font-size:1rem;max-width:620px;margin:0 auto 1.75rem;line-height:1.7}

/* Table of contents pills */
.toc{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem}
.toc a{padding:.38rem .9rem;background:white;border:1px solid var(--rule);border-radius:20px;font-size:.78rem;color:var(--ink3);text-decoration:none;transition:all .2s}
.toc a:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-light)}

/* ── Layout ─────────────────────────────────────────────────────── */
.wrapper{max-width:1080px;margin:0 auto;padding:0 2rem 6rem}

/* ── Section headers ─────────────────────────────────────────────── */
.sec-head{padding:3.5rem 0 1.5rem;border-top:2px solid var(--rule);margin-top:3rem}
.sec-head:first-child{border-top:none;margin-top:0;padding-top:3rem}
.sec-num{display:inline-block;width:28px;height:28px;border-radius:50%;background:var(--ink);color:white;font-size:.72rem;font-weight:700;text-align:center;line-height:28px;margin-bottom:.75rem}
.sec-head h2{font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:700;color:var(--ink);margin-bottom:.5rem}
.sec-head p{color:var(--ink3);font-size:.95rem;max-width:700px;line-height:1.7}

/* ── Figure cards ────────────────────────────────────────────────── */
.fig-card{background:white;border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden;margin-bottom:2rem;box-shadow:var(--shadow)}
.fig-title-bar{padding:1.1rem 1.5rem;border-bottom:1px solid var(--rule);display:flex;align-items:baseline;gap:.75rem}
.fig-title-bar h3{font-size:.95rem;font-weight:700;color:var(--ink)}
.fig-title-bar span{font-size:.78rem;color:var(--ink3);font-style:italic}
.fig-body{padding:1.75rem 1.5rem}
.fig-caption{padding:.9rem 1.5rem;background:var(--bg2);border-top:1px solid var(--rule);font-size:.8rem;color:var(--ink3);line-height:1.6}

/* ── SVG figures ─────────────────────────────────────────────────── */
.fig-svg-wrap{width:100%;overflow-x:auto}
.fig-svg-wrap svg{display:block;margin:0 auto;max-width:100%}

/* ── Two-col grid ────────────────────────────────────────────────── */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1.25rem}
@media(max-width:760px){.grid-2,.grid-3{grid-template-columns:1fr}}

/* ── Explanation panels ─────────────────────────────────────────── */
.expl-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}
@media(max-width:680px){.expl-grid{grid-template-columns:1fr}}
.expl-box{border-radius:var(--radius);padding:1.1rem 1.25rem}
.expl-box.blue{background:var(--blue-light);border:1px solid rgba(10,92,150,.18)}
.expl-box.orange{background:var(--orange-light);border:1px solid rgba(201,98,10,.18)}
.expl-box.teal{background:var(--teal-light);border:1px solid rgba(10,122,106,.18)}
.expl-box.red{background:var(--red-light);border:1px solid rgba(176,48,48,.18)}
.expl-box.amber{background:var(--amber-light);border:1px solid rgba(160,106,0,.18)}
.expl-box.purple{background:var(--purple-light);border:1px solid rgba(96,56,160,.18)}
.expl-box.green{background:var(--green-light);border:1px solid rgba(42,122,42,.18)}
.expl-box h4{font-size:.82rem;font-weight:700;margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.4px}
.expl-box.blue h4{color:var(--blue)}
.expl-box.orange h4{color:var(--orange)}
.expl-box.teal h4{color:var(--teal)}
.expl-box.red h4{color:var(--red)}
.expl-box.amber h4{color:var(--amber)}
.expl-box.purple h4{color:var(--purple)}
.expl-box.green h4{color:var(--green)}
.expl-box p,.expl-box ul{font-size:.85rem;color:var(--ink2);line-height:1.65}
.expl-box ul{padding-left:1rem}
.expl-box li{margin-bottom:.25rem}

/* ── Math display ────────────────────────────────────────────────── */
.math-block{background:var(--bg2);border:1px solid var(--rule);border-left:3.5px solid var(--blue);border-radius:0 var(--radius) var(--radius) 0;padding:1rem 1.4rem;margin:.9rem 0;overflow-x:auto}
.math-block .math-label{font-size:.72rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.6px;margin-bottom:.35rem}
.math-block .math-bio{font-size:.82rem;color:var(--ink3);margin-top:.5rem;padding-top:.5rem;border-top:1px solid var(--rule);font-style:italic;line-height:1.6}

/* ── Notation table ──────────────────────────────────────────────── */
.ntable{width:100%;border-collapse:collapse;font-size:.85rem}
.ntable thead th{background:var(--ink);color:white;padding:.7rem 1rem;text-align:left;font-size:.78rem;font-weight:600;letter-spacing:.3px}
.ntable thead th:first-child{border-radius:6px 0 0 0}
.ntable thead th:last-child{border-radius:0 6px 0 0}
.ntable tbody tr{border-bottom:1px solid var(--rule)}
.ntable tbody tr:hover{background:var(--bg2)}
.ntable td{padding:.7rem 1rem;vertical-align:top;line-height:1.6}
.ntable td:first-child{font-weight:700;color:var(--blue);font-size:.92rem;white-space:nowrap}
.ntable td:nth-child(2){font-weight:600;color:var(--ink);font-size:.83rem}
.ntable td:last-child{color:var(--ink3);font-size:.82rem}
.ntable-wrap{border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}

/* ── Scenario tabs ───────────────────────────────────────────────── */
.tab-row{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.25rem;border-bottom:2px solid var(--rule);padding-bottom:.1rem}
.tbtn{padding:.5rem 1rem;font-size:.8rem;font-weight:600;background:none;border:none;cursor:pointer;color:var(--ink3);border-radius:6px 6px 0 0;position:relative;transition:color .2s}
.tbtn.active{color:var(--blue)}
.tbtn.active::after{content:'';position:absolute;bottom:-2px;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--teal))}
.tbtn:hover:not(.active){color:var(--ink);background:var(--bg2)}
.tpanel{display:none}
.tpanel.active{display:block}

/* ── Chart containers ────────────────────────────────────────────── */
.chart-area{position:relative;width:100%;padding:0}
.chart-controls{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;padding:1rem 1.5rem;background:var(--bg2);border-bottom:1px solid var(--rule)}
.ctrl-row{display:flex;align-items:center;gap:.75rem}
.ctrl-label{font-size:.78rem;font-weight:600;color:var(--ink3);min-width:140px}
.ctrl-label code{background:rgba(10,92,150,.1);color:var(--blue);padding:.1rem .3rem;border-radius:4px;font-size:.78rem;font-weight:700}
input[type=range]{accent-color:var(--blue);width:160px;cursor:pointer}
.ctrl-val{font-size:.82rem;font-weight:700;color:var(--ink);min-width:42px;font-family:'Courier New',monospace}
.stat-strip{display:flex;gap:1px;background:var(--rule);border-bottom:1px solid var(--rule)}
.stat-cell{flex:1;background:white;padding:.7rem 1rem;text-align:center}
.stat-cell .sc-label{font-size:.7rem;color:var(--ink3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:.2rem}
.stat-cell .sc-val{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700}
.stat-cell.sc-blue .sc-val{color:var(--blue)}
.stat-cell.sc-orange .sc-val{color:var(--orange)}
.stat-cell.sc-teal .sc-val{color:var(--teal)}
.stat-cell.sc-red .sc-val{color:var(--red)}
.chart-inner{padding:1.25rem 1.5rem}
.legend-row{display:flex;flex-wrap:wrap;gap:1rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--rule)}
.leg-item{display:flex;align-items:center;gap:.4rem;font-size:.76rem;color:var(--ink3)}
.leg-swatch{width:28px;height:3px;border-radius:2px;flex-shrink:0}
.leg-swatch.dash{background:repeating-linear-gradient(90deg,var(--color,#888) 0,var(--color,#888) 5px,transparent 5px,transparent 9px)}

/* ── Scenario callout strip ─────────────────────────────────────── */
.scenario-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:var(--radius);overflow:hidden;margin-top:1rem}
.sc-item{background:white;padding:1rem 1.1rem;text-align:center}
.sc-item .sc-head{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:.35rem}
.sc-item.sc-grow .sc-head{color:var(--teal)}
.sc-item.sc-peak .sc-head{color:var(--blue)}
.sc-item.sc-fall .sc-head{color:var(--red)}
.sc-item .sc-cond{font-size:.85rem;font-weight:700;margin-bottom:.3rem;font-family:'Courier New',monospace}
.sc-item.sc-grow .sc-cond{color:var(--teal)}
.sc-item.sc-peak .sc-cond{color:var(--blue)}
.sc-item.sc-fall .sc-cond{color:var(--red)}
.sc-item p{font-size:.78rem;color:var(--ink3);line-height:1.55}

/* ── Collapsible detail ─────────────────────────────────────────── */
.det-btn{width:100%;text-align:left;background:var(--bg2);border:1px solid var(--rule);border-radius:var(--radius);padding:.8rem 1.1rem;font-size:.85rem;font-weight:600;color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;transition:background .2s}
.det-btn:hover{background:var(--bg3)}
.det-btn .di{transition:transform .25s;color:var(--blue);font-size:1rem}
.det-btn.open .di{transform:rotate(90deg)}
.det-body{display:none;padding:1rem 1.25rem;background:white;border:1px solid var(--rule);border-radius:var(--radius);margin-bottom:1rem;font-size:.85rem;color:var(--ink3);line-height:1.7;animation:fi .2s ease}
.det-body.open{display:block}
@keyframes fi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* ── Scenario labels ─────────────────────────────────────────────── */
.scenario-label{display:inline-block;padding:.22rem .65rem;border-radius:12px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:.6rem}
.sl-blue{background:var(--blue-light);color:var(--blue)}
.sl-orange{background:var(--orange-light);color:var(--orange)}
.sl-red{background:var(--red-light);color:var(--red)}
.sl-teal{background:var(--teal-light);color:var(--teal)}
.sl-purple{background:var(--purple-light);color:var(--purple)}

/* ── HIT table ───────────────────────────────────────────────────── */
.hit-bar{display:flex;align-items:center;gap:.75rem;margin:.35rem 0}
.hit-bar-label{min-width:130px;font-size:.78rem;color:var(--ink2);font-weight:500}
.hit-bar-track{flex:1;height:8px;background:var(--bg3);border-radius:4px;overflow:hidden}
.hit-bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--teal));transition:width .5s}
.hit-bar-val{min-width:50px;text-align:right;font-size:.78rem;font-weight:700;color:var(--ink);font-family:'Courier New',monospace}

/* ── Footer ─────────────────────────────────────────────────────── */
footer{padding:2.5rem 2rem;border-top:1px solid var(--rule);background:var(--bg2);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
footer p{font-size:.82rem;color:var(--ink3)}
footer a{color:var(--ink3);text-decoration:none;font-size:.82rem;transition:color .2s}
footer a:hover{color:var(--blue)}
</style>
</head>
