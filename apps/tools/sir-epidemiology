let c5b;
function initF5b(){
  c5b=makeChart('f5b-canvas',[
    {label:'No intervention',data:[],borderColor:'rgba(130,130,130,.6)',borderWidth:1.8,borderDash:[5,3],pointRadius:0,tension:.3,fill:false},
    {label:'With intervention',data:[],borderColor:'#0a5c96',backgroundColor:'rgba(10,92,150,.1)',borderWidth:2.5,pointRadius:0,tension:.3,fill:true},
    {label:'Intervention day',data:[],borderColor:'#b03030',borderWidth:1.2,borderDash:[3,3],pointRadius:0,fill:false}
  ],{yLabel:'I(t) — infectious fraction'});
  drawF5b();
}
function drawF5b(){
  const maskR=parseInt(document.getElementById('f5b-mask').value)/100;
  const treatR=parseInt(document.getElementById('f5b-treat').value)/100;
  const vaccC=parseInt(document.getElementById('f5b-vacc').value)/100;
  document.getElementById('f5b-mv').textContent=(maskR*100).toFixed(0)+'%';
  document.getElementById('f5b-tv').textContent=(treatR*100).toFixed(0)+'%';
  document.getElementById('f5b-vv').textContent=(vaccC*100).toFixed(0)+'%';
  const b0=0.5,g0=0.1,days=280;
  const base=sir(b0,g0,0,days,0.001);
  const pre=sir(b0,g0,0,40,0.001);
  const s40=pre.s[pre.s.length-1]; const i40=pre.i[pre.i.length-1];
  const sAfter=Math.max(0,s40*(1-vaccC));
  const bNew=b0*(1-maskR); const gNew=g0*(1+treatR);
  const post=sir(bNew,gNew,0,days-40,i40,sAfter);
  const tFull=[...pre.t,...post.t.map(x=>x+40)];
  const iFull=[...pre.i,...post.i];
  const baseI=base.i.slice(0,tFull.length);
  const peakBase=Math.max(...base.i)*100;
  const peakInt=Math.max(...iFull)*100;
  const rePost=(bNew/gNew)*sAfter;
  document.getElementById('f5b-re').textContent=rePost.toFixed(2);
  const pred=((peakBase-peakInt)/peakBase*100);
  document.getElementById('f5b-pred').textContent=pred>0?'-'+pred.toFixed(0)+'%':'0%';
  const st=document.getElementById('f5b-status');
  if(rePost<1){st.textContent='Controlled';st.style.color='#0a7a6a';}
  else if(rePost<2){st.textContent='Slowing';st.style.color='#a06a00';}
  else{st.textContent='Spreading';st.style.color='#b03030';}
  const mkr=tFull.map((t,j)=>(Math.round(t)===40||(j>0&&tFull[j-1]<40&&t>=40))?Math.max(...baseI)*1.15:null);
  if(c5b){
    c5b.data.labels=tFull.map(Math.round);
    c5b.data.datasets[0].data=baseI;
    c5b.data.datasets[1].data=iFull;
    c5b.data.datasets[2].data=mkr;
    c5b.update('none');
  }
}

